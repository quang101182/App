+def manga_crop_ref(filename):
+    """Recadre une image de reference sur le VISAGE, dans ComfyUI/input.
+
+    Mesure du 28/07 : IPAdapter transfere la COMPOSITION de la reference autant
+    que l'identite. Une reference qui est une planche de personnage (plusieurs
+    vues, fond vide) fait donc heriter la case de sa mise en page. Le recadrage
+    sur le visage supprime la cause -- un portrait serre n'a pas de mise en page
+    a transmettre.
+
+    Delegue a `scripts/crop_ref.py` (venv kohya : ultralytics + YOLO face) ; le
+    proxy appelle, il ne reimplemente rien. Aucun visage trouve => on le DIT et
+    l'appelant garde l'image entiere : recadrer au hasard couperait le sujet.
+    """
+    if not os.path.isfile(MANGA_PY):
+        return {"error": "venv kohya introuvable: %s" % MANGA_PY}
+    if not os.path.isfile(MANGA_CROP):
+        return {"error": "script de recadrage introuvable: %s" % MANGA_CROP}
+    nom = os.path.basename(filename or "")
+    src = os.path.join(COMFY_INPUT_DIR, nom)
+    if not nom or not os.path.isfile(src):
+        return {"error": "image introuvable dans input: %s" % nom}
+    base, ext = os.path.splitext(nom)
+    dest_nom = base + "_crop.png"
+    dest = os.path.join(COMFY_INPUT_DIR, dest_nom)
+    cmd = [MANGA_PY, MANGA_CROP, src, "--out", dest, "--json"]
+    try:
+        p = subprocess.run(cmd, capture_output=True, timeout=180,
+                           cwd=os.path.dirname(MANGA_CROP))
+    except subprocess.TimeoutExpired:
+        return {"error": "recadrage : delai depasse (180 s)"}
+    out = (p.stdout or b"").decode("utf-8", "replace").strip()
+    err = (p.stderr or b"").decode("utf-8", "replace").strip()
+    try:
+        data = json.loads(out.splitlines()[-1]) if out else {}
+    except Exception:
+        return {"error": "sortie de recadrage illisible", "detail": (out or err)[:600]}
+    if not data.get("ok"):
+        return {"ok": False, "raison": data.get("raison") or err[-300:] or "echec"}
+    data["name"] = dest_nom
     return data
 
 
