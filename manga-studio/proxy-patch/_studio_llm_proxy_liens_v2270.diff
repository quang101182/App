+# Manga Studio v2.26.0 (Quang 24/09 21h31) : « reprendre un manga » liste, par serie, chaque SITE d'ou viennent ses
+# chapitres (manifest.source_url). Quang retire lui-meme un site devenu obsolete (✕) : sa liste est gardee ici, par
+# application (<racine>/_liens_retires.json = {serie: [hote, ...]}), commune au PC et au telephone. Rien n'est efface.
+_RE_HOTE = re.compile(r"^[a-z0-9][a-z0-9.-]{1,120}$")
+
+
+def manga_liens(data=None):
+    f = os.path.join(MANGA_SOURCES, "_liens_retires.json")
+    try:
+        with open(f, encoding="utf-8") as h:
+            d = json.load(h)
+    except (OSError, ValueError):
+        d = {}
+    if data is None:
+        return {"retires": d}
+    serie, hote, act = data.get("serie") or "", (data.get("hote") or "").lower(), data.get("action") or ""
+    if not _RE_SERIE.match(serie) or not _RE_HOTE.match(hote) or act not in ("retirer", "retablir"):
+        return {"error": "demande invalide"}
+    l = [x for x in d.get(serie) or [] if x != hote] + ([hote] if act == "retirer" else [])
+    if l: d[serie] = l
+    else: d.pop(serie, None)
+    tmp = f + ".tmp"
+    with open(tmp, "w", encoding="utf-8") as h:
+        json.dump(d, h, ensure_ascii=False, indent=1)
+    os.replace(tmp, f)
+    return {"ok": True, "retires": d}
+
+
