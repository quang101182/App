+def _manga_safe(rel):
+    """Resout un chemin RELATIF sous MANGA_OUT, ou renvoie None.
+
+    Anti path-traversal : on normalise puis on verifie que le resultat est bien
+    SOUS la racine. Un '..' bien place sortirait sinon du dossier du projet, et
+    cette route sert des fichiers a un navigateur.
+    """
+    rel = (rel or "").replace("\\", "/").lstrip("/")
+    full = os.path.normpath(os.path.join(MANGA_OUT, rel))
+    root = os.path.normpath(MANGA_OUT)
+    if not (full == root or full.startswith(root + os.sep)):
+        return None
+    return full
+
+
+def manga_harvest(filename, subfolder, slug, dest=""):
+    """DEPLACE une image fraichement generee de ComfyUI vers le dossier du projet manga.
+
+    C'est le 2e verrou anti-melange : meme si ComfyUI ecrit deja dans un sous-dossier,
+    l'image ne reste pas chez lui. Elle rejoint output/<slug>/ dans le depot du projet,
+    ou l'app va la relire via /manga/file.
+    """
+    comfy_out = os.path.dirname(VIDEO_DIR)  # ...\output
+    src = os.path.normpath(os.path.join(comfy_out, subfolder or "", os.path.basename(filename or "")))
+    if not (src.startswith(os.path.normpath(comfy_out) + os.sep) and os.path.isfile(src)):
+        return {"error": "source introuvable: %s" % src}
+    slug = re.sub(r"[^a-zA-Z0-9_-]", "", slug or "divers") or "divers"
+    name = os.path.basename(dest or os.path.basename(src))
+    name = re.sub(r"[^a-zA-Z0-9_.-]", "_", name)
+    d = os.path.join(MANGA_OUT, slug)
+    os.makedirs(d, exist_ok=True)
+    dst = os.path.join(d, name)
+    if os.path.exists(dst):          # jamais ecraser en silence une image deja rangee
+        base, ext = os.path.splitext(name)
+        name = "%s_%d%s" % (base, int(time.time() * 1000) % 100000, ext)
+        dst = os.path.join(d, name)
+    try:
+        shutil.move(src, dst)
+    except Exception as ex:
+        return {"error": "deplacement: %s" % ex}
+    return {"ok": True, "path": "%s/%s" % (slug, name), "bytes": os.path.getsize(dst)}
+
+
+def manga_files(slug=""):
+    """Galerie PROPRE au projet : ne liste que output/<slug>/, jamais le dossier de GS."""
+    base = _manga_safe(slug) if slug else os.path.normpath(MANGA_OUT)
+    if not base or not os.path.isdir(base):
+        return {"files": []}
+    out = []
+    for f in sorted(os.listdir(base)):
+        p = os.path.join(base, f)
+        if os.path.isfile(p) and f.lower().endswith((".png", ".jpg", ".jpeg", ".webp")):
+            out.append({"name": f, "path": ("%s/%s" % (slug, f)) if slug else f,
+                        "bytes": os.path.getsize(p), "mtime": int(os.path.getmtime(p) * 1000)})
+    out.sort(key=lambda x: x["mtime"], reverse=True)
+    return {"files": out}
