+_MUS_HASH = {}                                   # v2.9.0 : (chemin, taille, mtime) -> sha1 du contenu
+
+
+def _mus_hash(full):
+    st = os.stat(full)
+    cle = (full, st.st_size, int(st.st_mtime))
+    if cle not in _MUS_HASH:
+        h = hashlib.sha1()
+        with open(full, "rb") as f:
+            for b in iter(lambda: f.read(1 << 20), b""):
+                h.update(b)
+        _MUS_HASH[cle] = h.hexdigest()
+    return _MUS_HASH[cle]
+
+
+def _mus_toutes():
+    """v2.9.0 : toutes les musiques de l'app -> [{serie, nom, fichier, full, hash}] (series visibles ou masquees)."""
+    root = os.path.normpath(MANGA_SOURCES)
+    out = []
+    for slug in sorted(os.listdir(root)) if os.path.isdir(root) else []:
+        md = os.path.join(root, slug, "musique")
+        if slug.startswith((".", "_")) or not os.path.isdir(md):
+            continue
+        for f in sorted(os.listdir(md), key=str.lower):
+            full = os.path.join(md, f)
+            if f.lower().endswith(_MUS_EXT) and os.path.isfile(full):
+                out.append({"serie": slug, "nom": os.path.splitext(f)[0], "fichier": slug + "/musique/" + f,
+                            "full": full, "hash": _mus_hash(full)})
+    return out
+
