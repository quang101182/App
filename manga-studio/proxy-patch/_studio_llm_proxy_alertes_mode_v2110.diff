+def couts_ia_etat():
+    """GET /couts_ia : jour / mois / total, par ecran et par fournisseur, + les tarifs appliques."""
+    auj = time.strftime("%Y-%m-%d")
+    mois = auj[:7]
+    tot = {"jour": 0.0, "mois": 0.0, "total": 0.0, "n_jour": 0, "n_mois": 0, "n_total": 0}
+    par_vue, par_fourn = {}, {}
+    try:
+        with open(COUTS_LOG, encoding="utf-8") as f:
+            for l in f:
