+OUT_SCAN_SKIP = {".previews", "manga"}   # manga = autre projet, jamais dans la galerie GS
+OUT_SCAN_DEPTH = 3                       # racine=0 ; gs/=1 ; gs/video/=2 ; une marge = 3
