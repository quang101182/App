+        os.makedirs(os.path.dirname(REF_LOG), exist_ok=True)
+        with open(REF_LOG, "a", encoding="utf-8") as f:
+            f.write("%s %s\n" % (time.strftime("%Y-%m-%d %H:%M:%S"), msg))
+    except Exception:
