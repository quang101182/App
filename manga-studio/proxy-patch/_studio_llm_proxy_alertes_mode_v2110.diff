+def _pid_vivant(pid):
+    """v7.28 - le processus `pid` tourne-t-il encore ? (Windows : OpenProcess + attente nulle)."""
+    try:
+        import ctypes
+        k = ctypes.windll.kernel32
+        h = k.OpenProcess(0x1000 | 0x00100000, False, int(pid))      # QUERY_LIMITED_INFORMATION | SYNCHRONIZE
+        if not h:
+            return False
+        try:
+            return k.WaitForSingleObject(h, 0) == 0x102                # WAIT_TIMEOUT = toujours vivant
+        finally:
+            k.CloseHandle(h)
+    except Exception:
+        return False
