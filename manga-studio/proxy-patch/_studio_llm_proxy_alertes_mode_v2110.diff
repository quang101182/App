+def ref_dz_titres(q, limite=15):
+    d = _ref_get("https://api.deezer.com/search?q=%s&limit=%d" % (urllib.parse.quote(q), limite))
+    return [{"id": t.get("id"), "titre": t.get("title"), "artiste": (t.get("artist") or {}).get("name"),
+             "artiste_id": (t.get("artist") or {}).get("id"), "duree": t.get("duration"),
+             "rang": int(t.get("rank") or 0), "preview": t.get("preview"),
+             "album": (t.get("album") or {}).get("title"), "image": (t.get("album") or {}).get("cover_medium")}
+            for t in (d.get("data") or [])]
