+def _spend_summary(days=30):
+    """Agrege le journal pour /spend_log : total, par jour, par moteur, + les evenements bruts recents."""
+    out = {"sinceDays": days, "totalUsd": 0.0, "byDay": {}, "byKind": {}, "openPods": [], "events": []}
+    try:
+        out["openPods"] = list(_SPEND_STARTS.keys())
+        if not os.path.isfile(SPEND_LOG_FILE):
+            return out
+        cutoff = (time.time() - days * 86400) * 1000
+        lines = open(SPEND_LOG_FILE, encoding="utf-8").read().splitlines()
+        for ln in lines[-3000:]:
+            try: rec = json.loads(ln)
+            except Exception: continue
+            if rec.get("ts", 0) < cutoff: continue
+            out["events"].append(rec)
+            c = rec.get("costUsd")
+            if rec.get("evt") == "stop" and c:
+                out["totalUsd"] += c
+                day = (rec.get("iso") or "")[:10]
+                out["byDay"][day]  = round(out["byDay"].get(day, 0) + c, 4)
+                k = rec.get("kind") or "?"
+                out["byKind"][k]   = round(out["byKind"].get(k, 0) + c, 4)
+        out["totalUsd"] = round(out["totalUsd"], 4)
+        out["events"] = out["events"][-200:]
+    except Exception as e:
+        out["err"] = str(e)[:120]
+    return out
