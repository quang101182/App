+# Desormais : chaque appel payant enregistre ses JETONS REELS (champ `usage` du fournisseur) x le
+# TARIF OFFICIEL, dans un seul journal (logs/couts_ia.jsonl) -> meme total sur PC et telephone.
+# Tarifs VERIFIES le 18/09/2026 sur les pages officielles (a revoir si un fournisseur change) :
+#  - DeepSeek (api-docs.deepseek.com/quick_start/pricing) : deepseek-v4-flash est servi ET facture
+#    comme V4.1 Flash. $/M jetons : entree cache 0,003 · entree 0,15 · sortie 0,60 en heures CREUSES ;
+#    le double en heures PLEINES = 01-04 h et 06-10 h UTC, du lundi au vendredi.
+#  - Gemini 3.6 Flash (ai.google.dev/gemini-api/docs/pricing) : entree 0,75 · sortie 3,75 jusqu'au
+#    31/12/2026, puis 1,50 / 7,50. La page ne publie PAS de tarif audio distinct pour 3.6 Flash
+#    (« text / image / video ») : l'audio est compte au tarif d'entree -- a surveiller.
+#  - Mistral (Pixtral) : cle sur l'offre GRATUITE (le 14/09, `large` rendait « not available in your
+#    subscription tier ») -> 0 $, mais l'appel est compte.
+COUTS_LOG = os.path.join(os.path.dirname(os.path.abspath(__file__)), "logs", "couts_ia.jsonl")
+COUTS_VERIFIES = "18/09/2026"
+_COUTS_VERROU = threading.Lock()
+_CTX = threading.local()          # l'ecran d'ou vient l'appel (en-tete X-GS-Vue), par requete
