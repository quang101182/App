+def ace_ameliore(nom_source):
+    """✨ AMELIORER UN MORCEAU DEJA DANS LA PLAYLIST, a la demande (Quang, 20/09 au soir).
+
+    L'enrichissement automatique ne touche que les morceaux RECENTS (`enrich_a_faire()` ignore tout
+    ce qui depasse `ACE_ENRICH_MAX`). Cette route permet de le demander sur N'IMPORTE QUEL morceau,
+    meme celui de la veille.
+
+    ⚠ ELLE NE COPIE RIEN ELLE-MEME. Depuis la v6.99, c'est `_ace_installe` qui DUPLIQUE : il laisse
+    l'original intact et ecrit le morceau enrichi a cote. Une copie faite ici en plus donnait TROIS
+    dossiers pour un seul morceau (constate au banc le 20/09), et la copie intermediaire — qui avait
+    deja son `request.json` mais pas de marqueur — devenait candidate a un enrichissement de la
+    boucle. On se contente donc de lancer le calcul sur le morceau d'origine.
+
+    Rend (ok, nom_du_morceau_source | raison).
+    """
+    base = os.path.join(OUT_ROOT, "gs", "audio")
+    src = os.path.join(base, str(nom_source or ""))
+    if not os.path.isfile(os.path.join(src, "audio.flac")):
+        return False, "morceau introuvable"
+    if _ACE.get("etape"):
+        return False, "le moteur 2 travaille deja (%s)" % _ACE.get("etape")
+    ace_log("%s : AMELIORATION demandee a la main" % nom_source)
+    ok = enrich_calcule(src)
+    if not ok:
+        return False, (_ACE.get("erreur") or "l'amelioration a echoue")
+    return True, str(nom_source)
+
