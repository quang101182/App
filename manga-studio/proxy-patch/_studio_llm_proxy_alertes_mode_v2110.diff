+def apercu_slug(v):
+    """Meme slug que le front (slugVoix) et que banque_apercus.py : les trois doivent
+    tomber sur le MEME nom de fichier, sinon l'extrait genere ne sera jamais retrouve."""
+    v = unicodedata.normalize("NFD", (v or "").lower())
+    v = "".join(c for c in v if unicodedata.category(c) != "Mn")
+    return re.sub(r"[^a-z0-9]+", "-", v).strip("-")
+
+
+def apercu_voix(voix, voix_en, lang, lang_nom, timeout=300):
+    """Genere UN extrait de voix dans UNE langue, et le range dans la banque.
+
+    Synchrone : l'appel dure ~35 s. C'est assumé - le front previent l'utilisateur et
+    n'en lance qu'un a la fois (le moteur ne fait de toute façon qu'un job a la fois).
+    """
+    slug = apercu_slug(voix)
+    if not slug or not voix_en:
+        return {"error": "voix manquante"}
+    lang = re.sub(r"[^a-z]", "", (lang or "fr").lower())[:5] or "fr"
+    os.makedirs(PREVIEWS, exist_ok=True)
+    nom = ("%s-%s.flac" % (lang, slug)) if lang != "fr" else ("%s.flac" % slug)
+    cible = os.path.join(PREVIEWS, nom)
+    if os.path.isfile(cible):
+        return {"ok": True, "deja": True, "fichier": nom}
+
+    if not yue2_get("/ping", timeout=2):
+        return {"error": "moteur musique eteint", "needStart": True}
+
+    # 1. des paroles COURTES dans la langue demandee. On les fait ecrire plutot que de
+    #    coder en dur 18 langues qu'on ne saurait pas relire.
+    paroles = "[Verse]\nUn soir de septembre en ville\n[Chorus]\nEt la lumiere danse encore"
+    if lang != "fr":
+        try:
+            _e = enhance("Ecris DEUX lignes de paroles de chanson en %s (la langue), tres simples, "
+                         "sur une soiree en ville. Reponds EXACTEMENT ainsi, sans rien d'autre :\n"
+                         "[Verse]\n<une ligne>\n[Chorus]\n<une ligne>" % (lang_nom or lang),
+                         "raw")
+            t = (_e.get("prompt") or "").strip()
+            if "[Verse]" in t and len(t) > 12:
+                paroles = t
+        except Exception as ex:
+            print("[apercu] paroles par defaut (%s) : %s" % (lang, str(ex)[:120]), flush=True)
+
+    # 2. meme decor pour toutes les voix : seule la voix doit changer d'un extrait a l'autre
+    style = "%s vocals, mid-tempo pop, %s, 100 BPM, piano and soft drums, clear mix" % (
+        (lang_nom or "French"), voix_en)
+    r = yue2_post("/generate", {"style": style, "lyrics": paroles, "cot": "full",
+                                "instrumental": False, "title": "apercu-" + lang + "-" + slug,
+                                "max_s": 25}, timeout=30)
+    job = (r or {}).get("job")
+    if not job:
+        return {"error": (r or {}).get("error") or "le moteur a refuse la demande"}
+
+    t0 = time.time()
+    resultat = None
+    while time.time() - t0 < timeout:
+        st = yue2_get("/status?job=" + job, timeout=10) or {}
+        if st.get("phase") == "fini":
+            resultat = st.get("result")
+            break
+        if st.get("phase") == "erreur":
+            return {"error": st.get("error") or "echec de la generation", "detail": st.get("detail")}
+        time.sleep(3)
+    if not resultat:
+        return {"error": "l'extrait met trop longtemps a se generer"}
+
+    # 3. ranger dans la banque, puis effacer le dossier de travail : sans ca il
+    #    apparaitrait comme un morceau dans la galerie.
+    dossier = os.path.join(OUT_ROOT, resultat.get("subfolder", ""))
+    src = None
+    for base, _d, fichiers in os.walk(dossier):
+        for f in fichiers:
+            if f.lower().endswith(".flac"):
+                src = os.path.join(base, f)
+                break
+        if src:
+            break
+    if not src:
+        return {"error": "aucun fichier audio produit"}
+    shutil.copy2(src, cible)
+    shutil.rmtree(dossier, ignore_errors=True)
+    print("[apercu] %s ecrit (%.1f s d'audio)" % (nom, resultat.get("audio_s") or 0), flush=True)
+    return {"ok": True, "fichier": nom, "sub": "gs/audio/_previews",
+            "audio_s": resultat.get("audio_s")}
