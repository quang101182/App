+    _ace_ecrit(dossier, {"action": "source", "moteurs": "1", "enrichi_en": "gs/audio/%s" % nom2,
+                         "secondes": round(secondes, 1)})
+    # ⛔ `request.json` EN TOUT DERNIER, APRÈS les marqueurs. C'est l'acte de naissance : dès qu'il
+    # existe, tout l'aval (mastering, analyse, Telegram — et `enrich_a_faire`) considère le morceau
+    # comme fini. En l'écrivant avant, le nouveau morceau apparaissait SANS son marqueur : il était
+    # donc candidat à un nouvel enrichissement, en boucle. Constaté le 20/09 au banc :
+    # « marqueur non ecrit (banc-deux-365113) : No such file or directory ».
+    try:
+        with io.open(os.path.join(d2, "request.json"), "w", encoding="utf-8") as f:
+            json.dump(_rq2_final, f, ensure_ascii=False)
+    except Exception as ex:
