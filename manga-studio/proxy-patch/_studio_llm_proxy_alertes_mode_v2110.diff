+def abc_melodie(data):
+    """POST /abc_melodie {chemin: "gs/audio/<dossier>"} -> {ok, abc (sans accords), tempo, mesures, preuve}."""
+    rel = str((data or {}).get("chemin") or "").replace("\\", "/").strip("/")
+    if not rel.startswith("gs/audio/") or "/_" in "/" + rel or ".." in rel:
+        return {"ok": False, "erreur": "chemin refuse"}
+    src = os.path.join(OUT_ROOT, *rel.split("/"), "score.abc")
+    if not os.path.isfile(src):
+        return {"ok": False, "erreur": "ce morceau n'a pas de partition (compose en mode Direct)"}
+    try:
+        with io.open(src, encoding="utf-8") as f:
+            abc = f.read()
+        t = _abc_tools()
+        mel = t.strip_chords(abc)
+        preuve = t.compare(t.parse(abc), t.parse(mel), t.VOICES, False)
+        m = re.search(r"^Q:\s*1/4\s*=\s*(\d+)", abc, re.M)
+        return {"ok": True, "abc": mel, "tempo": int(m.group(1)) if m else None,
+                "accords_retires": abc.count('"') // 2 - mel.count('"') // 2,
+                "melodie_identique": bool(preuve.get("match")), "source": rel}
+    except Exception as ex:
+        return {"ok": False, "erreur": "partition illisible : %s" % str(ex)[:160]}
