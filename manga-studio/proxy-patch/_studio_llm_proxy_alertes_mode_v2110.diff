+def langue_paroles_ace(paroles):
+    """v7.35 - code de langue pour ACE-Step, deduit des paroles (meme regle que l'analyse audio). « unknown » si
+    rien de net (instrumental, texte trop court) : c'est une valeur prevue par ACE-Step."""
+    if not str(paroles or "").strip() or "[instrumental]" in str(paroles).lower():
+        return "unknown"
+    try:
+        if "f" not in _LANGUE_MOD:
+            import importlib.util
+            _sp = importlib.util.spec_from_file_location("gs_analyse_langue", os.path.join(ANALYSE_DIR, "analyse_morceau.py"))
+            _m = importlib.util.module_from_spec(_sp); _sp.loader.exec_module(_m)
+            _LANGUE_MOD["f"] = _m.langue_paroles
+        return _LANGUE_MOD["f"](paroles) or "unknown"
+    except Exception:
+        return "unknown"
