+def carte_avis_vue():
+    """v7.32 - AVANT un depart : la carte est-elle deja chargee par d'autres programmes (jeu…) ? Meme seuil que
+    garde_depart(), sans effet de bord. L'app le dit a Quang avant de lancer le moteur 1 (local seulement)."""
+    try:
+        ext, tot, used = vram_externe()
+    except Exception:
