+def yue2_start():
+    """Calque ltx_local_start : log en append, CREATE_NO_WINDOW, pas de relance
+    si le port repond deja."""
+    if yue2_get("/ping", timeout=2):
+        return {"ok": True, "already": True}
+    core = os.path.join(YUE2_DIR, "yue2_server.py")
+    if not os.path.isfile(core):
+        return {"error": "moteur musique introuvable: " + core}
+    py = YUE2_PY if os.path.isfile(YUE2_PY) else sys.executable
+    flags = getattr(subprocess, "CREATE_NO_WINDOW", 0)
+    try:
+        lf = open(YUE2_LOG, "ab", buffering=0)
+        lf.write(("\n===== demarrage moteur musique " + time.strftime("%Y-%m-%d %H:%M:%S")
+                  + " =====\n").encode("utf-8", "replace"))
+    except Exception:
+        lf = None
+    # 17/09/2026 - PYTHONUTF8=1 : SANS LUI, TOUTE generation en coreen / japonais /
+    # chinois / vietnamien ECHOUE, apres avoir consomme le GPU. Le paquet yue2 sauve la
+    # partition avec `pathlib.write_text(...)` SANS encoding (storage.py:28) : Windows
+    # encode alors en cp1252, et le morceau meurt a l'ecriture de plan.json
+    #   UnicodeEncodeError: 'charmap' codec can't encode characters in position 224-226
+    # (vu 2 fois le 17/09, sur des essais K-pop). On corrige par l'ENVIRONNEMENT plutot
+    # qu'en patchant le paquet : un patch serait efface a la prochaine mise a jour.
+    env = dict(os.environ); env["PYTHONUTF8"] = "1"
+    try:
+        subprocess.Popen([py, core], cwd=YUE2_DIR, creationflags=flags, env=env,
+                         stdout=(lf or subprocess.DEVNULL), stderr=subprocess.STDOUT)
+    except Exception as ex:
+        return {"error": "lancement KO: " + str(ex)[:120]}
+    return {"ok": True, "started": True}
