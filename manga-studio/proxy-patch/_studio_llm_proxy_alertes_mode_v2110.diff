+def _tg(methode, champs, fichier=None):
+    """Appel a l'API Telegram, en multipart (UTF-8 natif : aucun souci d'accents ici)."""
+    jeton = notif_jeton()
+    if not jeton:
+        raise RuntimeError("cle du bot introuvable (JARVIS_TELEGRAM_BOT_TOKEN, ni env ni %s)" % NOTIF_ENV)
+    bord = "----gs%s" % os.urandom(8).hex()
+    corps = io.BytesIO()
+    for k, v in champs.items():
+        corps.write(("--%s\r\nContent-Disposition: form-data; name=\"%s\"\r\n\r\n" % (bord, k)).encode("utf-8"))
+        corps.write(str(v).encode("utf-8") + b"\r\n")
+    if fichier:
+        nom_champ, nom, contenu, ctype = fichier
+        corps.write(("--%s\r\nContent-Disposition: form-data; name=\"%s\"; filename=\"%s\"\r\nContent-Type: %s\r\n\r\n"
+                     % (bord, nom_champ, nom, ctype)).encode("utf-8"))
+        corps.write(contenu + b"\r\n")
+    corps.write(("--%s--\r\n" % bord).encode("utf-8"))
+    req = urllib.request.Request("%s/bot%s/%s" % (NOTIF_API, jeton, methode), data=corps.getvalue(),
+                                 headers={"Content-Type": "multipart/form-data; boundary=" + bord}, method="POST")
+    try:
+        with urllib.request.urlopen(req, timeout=120) as r:
+            rep = json.loads(r.read().decode("utf-8") or "{}")
+    except urllib.error.HTTPError as ex:
+        # le message d'erreur de Telegram, JAMAIS l'URL (elle contient la cle)
+        raise RuntimeError("Telegram HTTP %s : %s" % (ex.code, ex.read().decode("utf-8", "replace")[:200]))
+    except urllib.error.URLError as ex:
+        raise RuntimeError("Telegram injoignable : %s" % str(ex.reason)[:120])
+    if not rep.get("ok"):
+        raise RuntimeError("Telegram : %s" % str(rep.get("description"))[:200])
+    return rep.get("result") or {}
