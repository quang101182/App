+    c = corps or {}
+    og = c.get("origine") or {}
+    if isinstance(og, dict) and og.get("reprise") is True:
+        return "une reprise"
+    if str(c.get("abc") or "").strip() and str(c.get("cot") or "") != "off":
+        return "une mélodie gardée"
