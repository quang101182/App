+def deploy_ltx_pod(state, attempts=6):
+    """Déploie un pod on-demand (hôte LIBRE) + retry persistant. Stocke + persiste le podId. Retourne podId ou None."""
+    tok = get_runpod_write_token()
+    if not tok:
+        state.update(phase="error", msg="cle write RunPod absente"); return None
+    _terminate_ltx_pod_silent(tok)   # anti-doublon : nettoie un pod LTX précédent éventuel
+    MUT = 'mutation($input: PodFindAndDeployOnDemandInput!){ podFindAndDeployOnDemand(input:$input){ id machineId } }'
+    for attempt in range(attempts):
+        for gid in LTX_GPUS:
+            inp = {"cloudType": "SECURE", "gpuCount": 1, "gpuTypeId": gid, "dataCenterId": LTX_DC,
+                   "networkVolumeId": LTX_VOLUME_ID, "containerDiskInGb": 30, "volumeMountPath": "/workspace",
+                   "imageName": LTX_IMAGE, "ports": "8888/http,22/tcp", "env": LTX_ENV, "name": "ltx-gs"}
+            try:
+                r = _rp_graphql(MUT, tok, variables={"input": inp})
+            except Exception as e:
+                r = {"_err": str(e)[:140]}
+            pid = ((r.get("data") or {}).get("podFindAndDeployOnDemand") or {}).get("id")
+            if pid:
+                _LTX["podId"] = pid; _save_ltx_pod(pid)
+                _spend_log("start", pid, "ltx", LTX_RATE_USD_HR)   # journal depense persistant
+                state.update(msg="Pod déployé — allocation GPU…")
+                print("[ltx] deploy on-demand OK pod=%s gpu=%s" % (pid, gid), flush=True)
+                return pid
+        state.update(msg="Recherche d'un GPU libre dans %s… (essai %d/%d)" % (LTX_DC, attempt + 1, attempts))
+        print("[ltx] pas de GPU libre, retry %d/%d" % (attempt + 1, attempts), flush=True)
