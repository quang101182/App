+
+
+def garde_depart():
+    """v6.49 : un AVIS, plus un refus. None si la carte est libre ; sinon la phrase qui dit QUI la charge.
+    Le morceau part quand meme (decision de Quang) : il sera seulement plus lent si la carte deborde.
+    v6.51 : avant de mesurer, Jarvis libere sa fenetre Netflix si un episode y dort en pause."""
+    jarvis_libere_netflix()
+    ext, tot, used = vram_externe()
