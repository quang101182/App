+    ouv = [a for a in al if a["etat"] == "ouverte"]
+    ouv.sort(key=lambda a: a.get("maj") or "", reverse=True)
+    hist = sorted([a for a in al if a["etat"] != "ouverte"], key=lambda a: a.get("maj") or "", reverse=True)[:60]
