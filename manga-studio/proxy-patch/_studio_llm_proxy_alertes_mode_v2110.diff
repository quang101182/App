+def _store_meta(name, ver, model_url=None):
+    entry = {"scanned": True, "trigger": (ver or {}).get("trainedWords") or [],
+             "civitaiName": (ver or {}).get("name"), "baseModel": (ver or {}).get("baseModel"),
+             "url": model_url or ("https://civitai.com/models/%s" % (ver or {}).get("modelId", "")),
+             "preview": None, "nsfw": False}
+    img = _pick_preview(ver)
+    if img and img.get("url"):
+        entry["nsfw"] = (img.get("nsfwLevel") or 0) > 1
+        try:
+            os.makedirs(PREVIEWS_DIR, exist_ok=True)
+            fn = _flat(name) + ".jpg"
+            _dl_image(img["url"], os.path.join(PREVIEWS_DIR, fn))
+            entry["preview"] = fn
+        except Exception as e:
+            print("[lora_meta] preview DL echec %s: %s" % (name, e), flush=True)
+    _set_meta(name, entry)
+    return entry
