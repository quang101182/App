+def titre_demande(dossier_abs):
+    """v7.45 - le titre DEMANDE a la creation : request.json « title » (moteur 1, ecrit depuis le 22/09) ou
+    plan.json request.title (moteur 2). None si inconnu."""
+    for f, cle in (("request.json", None), ("plan.json", "request")):
+        p = os.path.join(dossier_abs, f)
+        if not os.path.isfile(p):
+            continue
+        try:
+            with io.open(p, encoding="utf-8") as h:
+                d = json.load(h) or {}
+            t = str(((d.get(cle) or {}) if cle else d).get("title") or "").strip()
+            if t:
+                return t[:120]
+        except Exception:
+            pass
+    return None
