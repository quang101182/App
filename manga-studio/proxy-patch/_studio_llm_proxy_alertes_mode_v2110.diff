+def _iter_loras():
+    out = []
+    for root, _, files in os.walk(LORAS_DIR):
+        if os.path.basename(root) == ".previews": continue
+        for f in files:
+            if not f.lower().endswith((".safetensors", ".pt", ".ckpt", ".bin", ".pth", ".sft")): continue
+            if f.lower().startswith("wan"): continue
+            full = os.path.join(root, f)
+            rel = os.path.relpath(full, LORAS_DIR).replace("/", "\\")
+            out.append((rel, full))
+    return out
