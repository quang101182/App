+def _enrich_entry(name, entry):
+    """Remplit entry['tags'], entry['mname'], entry['loraType'] depuis /models/{id}. entry est mute en place."""
+    mid = _model_id_from(entry)
+    if not mid:
+        entry.setdefault("tags", [])
+        entry["loraType"] = _classify_type([], entry.get("civitaiName"), entry.get("trigger"))
+        entry["enriched"] = True
+        return entry
+    info = _civitai_api("/models/" + mid, tries=2)
+    tags = [str(t).strip().lower() for t in (info.get("tags") or []) if t]
+    entry["tags"] = tags
+    entry["mname"] = info.get("name")
+    entry["loraType"] = _classify_type(tags, info.get("name") or entry.get("civitaiName"), entry.get("trigger"))
+    entry["enriched"] = True
+    return entry
