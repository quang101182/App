+def ref_ecoute(preview_url):
+    """L'extrait de 30 s ECOUTE par l'outil de la v6.30 (langue, voix entendue, style) + tempo mesure."""
+    tmp = tempfile.mkdtemp(prefix="gs_ref_")
+    try:
+        chemin = os.path.join(tmp, "extrait.mp3")
+        req = urllib.request.Request(preview_url, headers={"User-Agent": REF_UA})
+        with urllib.request.urlopen(req, timeout=20) as r, open(chemin, "wb") as f:
+            f.write(r.read())
+        _tp = {}
+        fil = threading.Thread(target=lambda: _tp.update(r=esprit_tempo(chemin)), daemon=True)
+        fil.start()
+        with open(chemin, "rb") as f:
+            octets = f.read()
+        d = esprit_nettoie(ref_patient(lambda: esprit_gemini(octets), "ecoute"))
+        fil.join(130)
+        tp = _tp.get("r") or {}
+        if tp.get("bpm") and (tp.get("regularite") is None or tp["regularite"] <= 0.12):
+            d["tempo_mesure"] = tp["bpm"]
+        return d
+    finally:
+        shutil.rmtree(tmp, ignore_errors=True)
