+# v7.49 (23/09, reprise « Claymore full ending - Danzai no Hana ») : le titre d'une video ne dit pas toujours l'artiste.
+# La reprise cherche ses paroles dans LRCLIB par artiste + titre -> « aucune parole », chaine arretee. On demande donc a
+# LRCLIB LUI-MEME, avec des gardes strictes : meme duree a +-3 s, des paroles, pas d'instrumental, et un mot du titre
+# LRCLIB present dans le titre de la video (sinon un homonyme de meme duree passerait).
+def _mp3_lien_lrclib(titre_video, artiste, titre, duree):
+    if not duree:
+        return None
+    propre = _mp3_titre_video_propre(titre_video)
+    requetes = []
+    # v7.51 : le TITRE seul d'abord (« DARK ARIA <LV2> ») - le titre complet de la video, avec ses 『』 et le nom de
+    # la chaine, ne rendait rien (Quang, 23/09, 19:17)
+    for q in (titre, propre, "%s %s" % (artiste, titre)):
+        q = re.sub(r"[\[\]()|~\-_:「-』【】]+", " ", q or "").strip()
+        q = re.sub(r"\s+", " ", q)
+        if q and q not in requetes:
+            requetes.append(q)
+    vt = " " + _mp3_norm(titre_video) + " "
+    va = " " + _mp3_norm(titre_video + " " + artiste) + " "
+    for q in requetes:
+        lst = None
+        for essai in (1, 2, 3):                        # 503 / 429 = LRCLIB demande de ralentir (vu le 23/09) : on patiente
+            try:
+                rq = urllib.request.Request("https://lrclib.net/api/search?" + urllib.parse.urlencode({"q": q}),
+                                            headers={"User-Agent": "GenerateStudio/7.49 (usage perso ; lrclib)"})
+                lst = json.loads(urllib.request.urlopen(rq, timeout=8).read().decode("utf-8")) or []
+                break
+            except Exception as ex:
+                if essai < 3 and getattr(ex, "code", 0) in (429, 503):
+                    time.sleep(2 * essai)
+                    continue
+                mp3_log("LRCLIB « %s » indisponible : %s" % (q, str(ex)[:80]))
+                break
+        if lst is None:
+            continue
+        bons = []
+        for x in lst:
+            a, t, dd = (x.get("artistName") or "").strip(), (x.get("trackName") or "").strip(), x.get("duration") or 0
+            if not a or not t or x.get("instrumental") or "instrumental" in t.lower() or abs(dd - duree) > 3:
+                continue
+            if not (x.get("plainLyrics") or x.get("syncedLyrics")):
+                continue
+            mots = [m for m in _mp3_norm(t).split() if len(m) >= 3]
+            if not any((" " + m + " ") in vt for m in mots):
+                continue
+            bons.append((a, t, round(dd), q))
+        if bons:
+            # v7.51 : on prefere l'ARTISTE nomme par la video (« SawanoHiroyuki[nZk] ») ; sinon l'ordre de LRCLIB.
+            # (v7.49 preferait une ecriture sans caractere interdit : sur DARK ARIA, elle aurait choisi une REPRISE par un
+            # autre artiste, « Miura Jam BR - Dark Aria Lv2 », parce que le vrai titre contient « < ».)
+            def _de_la_video(b_):
+                ms = [m for m in _mp3_norm(b_[0]).replace("[", " ").replace("]", " ").split() if len(m) >= 3]
+                return any((" " + m + " ") in va or m in va for m in ms)
+            a_, t_, dd_, q_ = next((b_ for b_ in bons if _de_la_video(b_)), bons[0])
+            # le nom devient un FICHIER « Artiste - Titre.mp3 » : les caracteres interdits sont retires ici (un « _ » a
+            # leur place empecherait la reprise de retrouver les paroles)
+            nettoie = lambda x: re.sub(r"\s+", " ", re.sub(r'[\\/:*?"<>|]+', " ", x)).strip()
+            return nettoie(a_), nettoie(t_), dd_, q_
+    return None
+
