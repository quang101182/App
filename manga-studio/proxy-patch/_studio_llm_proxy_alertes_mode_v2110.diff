+    # la parenté : le MÊME déroulé, enrichi (≠ duo ⚖️, qui sont deux compositions)
+    try:
+        origine_retient(nom2[-6:] + "-ace", {"parent": "gs/audio/" + nom, "lien": "enrichi"})
+    except Exception as ex:
+        ace_log("%s : parente non ecrite — %s" % (nom2, str(ex)[:120]))
+
+    marque = {"action": "enrichi", "secondes": round(secondes, 1), "ou": infos.get("ou") or "local",
+              "moteurs": "1+2", "duree_morceau": round(duree, 1),
+              "rapport": round(secondes / duree, 2) if duree else None,
+              "vram_libre_mo": libre or None,
+              "contraint": bool(infos.get("ou") != "cloud" and libre and libre < ACE_VRAM_CONFORT),
+              "source": "gs/audio/%s" % nom}
+    if infos.get("cout_usd") is not None:
+        marque["cout_usd"] = infos["cout_usd"]
