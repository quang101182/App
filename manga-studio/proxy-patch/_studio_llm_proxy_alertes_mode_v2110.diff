+def enrich_calcule(dossier):
+    """Repasse le morceau au moteur 2 (`lego`). L'ORIGINAL EST CONSERVE (`audio_brut.flac`) : Quang doit
+    pouvoir revenir au son du moteur 1. Le remplacement se fait par `os.replace` apres coup, donc le
+    fichier n'est jamais incomplet sous un lecteur."""
+    nom = os.path.basename(dossier)
+    son = os.path.join(dossier, "audio.flac")
+    t0 = time.time()
+    ly, st, duree = _ace_requete(dossier)
+    if duree <= 0:
+        _ace_ecrit(dossier, {"action": "refus", "pourquoi": "duree du morceau inconnue"})
+        return False
+    # `ou=None` au depart : on ne SAIT pas encore ou ca se fera (ca depend de la memoire libre,
+    # mesuree juste apres). L'ecran dira « decision en cours » plutot que d'annoncer un lieu faux.
+    _ACE.update(etape="enrichissement", dossier=nom, debut=t0, erreur=None, ou=None)
+    try:
+        _libre = int(vram_info().get("free") or 0)
+    except Exception:
+        _libre = 0
+    ace_log("%s : enrichissement demande (%.0f s de musique, %d Mo libres sur la carte)" % (nom, duree, _libre))
+    # --- v6.95 : LA BASCULE. Automatique, sans rien demander (decision de Quang du 20/09) ----------
+    # Le seul declencheur est la memoire libre de la carte. Si le renfort en ligne n'est pas
+    # disponible (pas d'endpoint, pas de cle, plafond atteint), on reste en local : plus lent, mais
+    # jamais bloque — et la raison est ecrite, jamais silencieuse.
+    if _libre and _libre < ACE_VRAM_CONFORT:
+        dispo, pourquoi = ace_cloud_dispo()
+        ace_log("%s : moins de %d Mo libres (le moteur 2 en veut 7,4 Go) -> %s"
