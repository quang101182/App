+def manga_gpu():
+    """Manga Studio v2.10.0 (etape 0b) : la carte graphique est-elle libre pour un moteur LOCAL ?
+    Memoire libre (nvidia-smi) + file ComfyUI (Generate Studio). Rien n'est lance ici : c'est un etat."""
+    r = {"memoire_libre_mo": None, "memoire_totale_mo": None, "comfyui": None}
+    try:
+        o = subprocess.run(["nvidia-smi", "--query-gpu=memory.free,memory.total,name", "--format=csv,noheader,nounits"],
+                           capture_output=True, text=True, timeout=10, creationflags=getattr(subprocess, "CREATE_NO_WINDOW", 0)).stdout
+        libre, tot, nom = [x.strip() for x in o.splitlines()[0].split(",")]
+        r.update(memoire_libre_mo=int(libre), memoire_totale_mo=int(tot), nom=nom)
+    except Exception as e:
+        r["erreur"] = "nvidia-smi : %s" % str(e)[:80]
+    try:
+        q = _get_json("http://127.0.0.1:8188/queue", timeout=3)
+        r["comfyui"] = "occupe" if (q.get("queue_running") or q.get("queue_pending")) else "libre"
+    except Exception:
+        r["comfyui"] = "eteint"
+    r["pret"] = bool(r["memoire_libre_mo"] and r["memoire_libre_mo"] >= 5000 and r["comfyui"] != "occupe")
+    return r
