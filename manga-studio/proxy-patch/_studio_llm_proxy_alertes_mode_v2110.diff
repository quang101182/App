+def ref_patient(fn, quoi):
+    """v6.32 - le gateway limite a 20 appels / min (fenetre fixe). Un 429 n'est PAS « rien trouve » :
+    on reessaie apres 6 s puis 20 s (comme les paroles, v6.24), et on le journalise. Vu au banc :
+    46 requetes sur 69 concluaient « aucune reference » parce que le gateway etait sature."""
+    for k, pause in enumerate((0, 6, 20)):
+        if pause:
+            ref_log("saturation (429) sur %s : nouvel essai dans %d s" % (quoi, pause))
+            time.sleep(pause)
+        try:
+            return fn()
+        except urllib.error.HTTPError as e:
+            if e.code != 429 or k == 2:
+                raise
+        except RuntimeError as e:
+            if "429" not in str(e) or k == 2:
+                raise
