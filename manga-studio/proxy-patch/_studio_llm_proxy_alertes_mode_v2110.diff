+    t = (texte or "").strip()
+    # un identifiant nu : 11 caracteres SANS espace, avec au moins un chiffre, _ ou - (sinon « Moonlighting » passerait)
+    if re.fullmatch(r"[A-Za-z0-9_-]{11}", t) and re.search(r"[0-9_-]", t):
+        return t
+    return None
