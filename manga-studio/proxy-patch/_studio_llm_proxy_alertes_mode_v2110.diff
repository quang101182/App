+        tmp = _ace_marqueur(dossier) + ".tmp"
+        with io.open(tmp, "w", encoding="utf-8") as f:
+            json.dump(d, f, ensure_ascii=False)
+        os.replace(tmp, _ace_marqueur(dossier))
+    except Exception as ex:
