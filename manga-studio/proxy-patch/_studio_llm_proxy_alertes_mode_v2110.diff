+def ace_cree(demande):
+    """🎨 LE MOTEUR 2 COMPOSE (mode « 2 »), au lieu d'enrichir un morceau du moteur 1.
+
+    ⚠ C'est un chemin NEUF : jusqu'ici le proxy ne CREAIT jamais de dossier de morceau — c'est le
+    moteur 1 (`yue2_server.py`) qui le fait, et tout l'aval reconnait un morceau a la presence de
+    `request.json` (ecrit APRES le son) et de `plan.json`. On fabrique donc une fiche de naissance
+    credible, sinon le morceau serait invisible pour le mastering, l'analyse et Telegram — et
+    supprime au bout de 2 h par le menage des dossiers sans son.
+
+    `task_type="text2music"` (pas `lego` : aucune source). Mesure locale du 20/09 : **25 s pour
+    30 s de musique** sur carte libre, duree respectee au centieme.
+
+    Rend (ok, dossier|raison).
+    """
+    ly = (demande.get("lyrics") or "").strip()
+    # v7.40 (Quang, 21/09) - un INSTRUMENTAL ne chante pas : ACE-Step ignore tout drapeau et chante les paroles qu'il
+    # recoit. Vides -> "[instrumental]" plus bas, la convention d'ACE-Step.
+    if demande.get("instrumental"):
+        ly = ""
+    st = (demande.get("style") or demande.get("prompt") or "").strip()
+    # v7.35 : duree LIBRE (le defaut de l'app) = ACE-Step la choisit (son LM l'estime d'apres les paroles, comme le
+    # moteur 1). Avant : 120 s imposees -> toutes les creations faisaient 2:00 pile.
+    _dv = demande.get("max_s") or demande.get("audio_duration")
+    duree = float(_dv) if _dv else None
+    if not st:
+        return False, "il faut un style"
+    titre = demande.get("title") or st[:40]
+    # ⚠ `_nom` impose par la file : elle a besoin de connaitre le dossier AVANT que la creation
+    # commence, pour pouvoir la suivre. Sans ca, le suivi chercherait un dossier inexistant et
+    # declarerait le morceau perdu.
+    nom = demande.get("_nom") or "%s-%06d" % (_ace_slug(titre), random.randint(100000, 999999))
+    dossier = os.path.join(OUT_ROOT, "gs", "audio", nom)
+    t0 = time.time()
+    _ACE.update(etape="creation", dossier=nom, debut=t0, erreur=None, ou="local")
+    ace_log("%s : CREATION demandee par le moteur 2 (%s)" % (nom, ("%.0f s visees" % duree) if duree else "duree libre, choisie par le moteur"))
+    try:
+        liberer_autres("musique2")
+        r = ace_start()
+        if r.get("error"):
+            _ACE.update(etape=None, dossier=None, ou=None)
+            return False, r["error"]
+        corps = {"task_type": "text2music", "lyrics": ly or "[instrumental]", "prompt": st, "batch_size": 1,
+                 # v7.35 : la langue DES PAROLES (avant : toujours "english", valeur inconnue d'ACE-Step)
+                 "vocal_language": demande.get("vocal_language") or langue_paroles_ace(ly)}
+        if duree:
+            corps["audio_duration"] = duree
+        for opt in ("bpm", "key_scale", "time_signature"):
+            if demande.get(opt):
+                corps[opt] = demande[opt]
+        corps["thinking"] = bool(demande.get("thinking", True))
+        rep = ace_post("/release_task", corps, timeout=60)
+        tid = ((rep or {}).get("data") or {}).get("task_id")
+        if not tid:
+            _ACE.update(etape=None, dossier=None, ou=None)
+            return False, "refus du moteur 2 : %s" % str(rep)[:200]
+        fichier, statut = None, 0
+        while time.time() - t0 < ACE_ENRICH_MAX:
+            time.sleep(4)
+            q = ace_post("/query_result", {"task_id_list": [tid]}, timeout=60)
+            items = (q or {}).get("data") or []
+            if not items:
+                continue
+            statut = items[0].get("status")
+            if statut == 1:
+                m = re.search(r"path=([^&]+)", ((json.loads(items[0].get("result") or "[]") or [{}])[0] or {}).get("file") or "")
+                fichier = unquote(m.group(1)) if m else None
+                break
+            if statut == 2:
+                _ACE.update(etape=None, dossier=None, ou=None)
+                return False, "le moteur 2 a echoue : %s" % str(items[0].get("result"))[:400]
+        if not fichier or not os.path.isfile(fichier):
+            _ACE.update(etape=None, dossier=None, ou=None)
+            return False, "aucun fichier rendu (statut %s)" % statut
+        # --- la fiche de naissance ------------------------------------------------------------
+        # ⚠ L'ORDRE COMPTE : le son d'abord, `request.json` EN DERNIER. C'est l'invariant de tout
+        # le proxy (« request.json est ecrit APRES le son : son absent = pas fini »). L'inverse
+        # ferait ramasser un dossier a moitie ecrit par les boucles de fond.
+        os.makedirs(dossier, exist_ok=True)
+        son = os.path.join(dossier, "audio.flac")
+        subprocess.run(["ffmpeg", "-y", "-loglevel", "error", "-i", fichier, son], check=True,
+                       creationflags=(0x08000000 if os.name == "nt" else 0))
+        secondes = round(time.time() - t0, 1)
+        if not duree:                                  # v7.35 : duree choisie par le moteur -> celle du fichier
+            duree = _duree_s(son) or None
+        # `plan.json` minimal : il PORTE la demande, et c'est ce que l'aval lit. Pas de partition
+        # (ACE-Step n'en rend pas) : `abc` vide plutot qu'invente — un ABC faux contaminerait les
+        # familles 🧬, qui regroupent justement par signature de partition.
+        # v7.34 (21/09) : `corps` est le format d'ACE-Step (le style y s'appelle `prompt`) -> la ligne de style de la
+        # playlist et le score « d'apres ta demande » lisaient `request.style` : ABSENT (« — », aucune ligne de detail).
+        _req = dict(corps, style=st, title=titre)
+        json.dump({"request": _req, "timing": {"seconds": secondes}, "truncated": False,
+                   "abc": "", "moteur": 2, "cree_par": "acestep"},
+                  io.open(os.path.join(dossier, "plan.json"), "w", encoding="utf-8"),
+                  ensure_ascii=False)
+        # Le marqueur d'enrichissement, POSE DES LA CREATION : sans lui, `enrich_a_faire()` verrait
+        # un dossier avec son + request.json et sans marqueur, et le moteur 2 ré-enrichirait son
+        # propre morceau. Il dit aussi a la playlist de peindre la pastille ② (et non ①+②).
+        _ace_ecrit(dossier, {"action": "cree", "secondes": secondes, "ou": "local",
+                             "moteurs": "2", "duree_morceau": duree,
+                             "rapport": round(secondes / duree, 2) if duree else None})
+        rq = {"style": st, "lyrics": ly or "[instrumental]", "cot": "creation",
+              "seed": str(demande.get("seed") or random.randint(100000, 999999)),
+              "cfg_scale": str(demande.get("cfg_scale") or "None"), "id": "song", "moteur": 2}
+        json.dump(rq, io.open(os.path.join(dossier, "request.json"), "w", encoding="utf-8"),
+                  ensure_ascii=False)                       # EN DERNIER : c'est l'acte de naissance
+        try:
+            os.remove(fichier)
+        except OSError:
+            pass
+        # ⚖️ LA FAMILLE 🧬 : si ce morceau est le jumeau d'un morceau du moteur 1, on ecrit la
+        # parente. `_parent` porte le JOB du premier ; son dossier se retrouve par les 6 chiffres
+        # (c'est toute la raison de la convention de nommage). Sans cette ligne, les deux morceaux
+        # d'une meme demande seraient cote a cote sans rien qui dise qu'ils se repondent.
+        _pj = demande.get("_parent")
+        if _pj:
+            # ⚠ `dossier_du_job` rend un COUPLE (nom_du_dossier, fichier_flac) — pas un chemin.
+            # Le prendre pour un chemin donnait « expected str … not tuple », et la parente n'etait
+            # jamais ecrite (les deux morceaux du duo restaient sans lien). Trouve dans moteur2.log :
+            # c'est tout l'interet de journaliser la RAISON d'un echec, pas seulement l'echec.
+            _pd = (dossier_du_job(_pj) or (None, None))[0]
+            if _pd:
+                try:
+                    # ⚠ La cle DOIT COMMENCER par les 6 chiffres du dossier : `origine_du_dossier`
+                    # fait `job.startswith(<6 chiffres>)`. Un prefixe (« ace-… ») la rend
+                    # introuvable — constate par le banc duo, qui ne voyait aucun lien ecrit.
+                    origine_retient(nom[-6:] + "-ace",
+                                    {"parent": "gs/audio/" + _pd, "lien": "moteur"})
+                    # ⚠ v6.99 : on marque AUSSI le morceau du moteur 1. Sans marqueur, l'app ne
+                    # peut rien en dire — en ⚖️ Quang se retrouvait avec DEUX fichiers au meme
+                    # titre, dont un seul etiquete. Il porte donc sa pastille ① et son [moteur1].
+                    _ace_ecrit(os.path.join(OUT_ROOT, "gs", "audio", _pd),   # v7.25 : `base` n'existait pas ici
+                               {"action": "compose", "moteurs": "1",
+                                "jumeau": "gs/audio/" + nom, "duo": True})
+                    ace_log("%s : rattache a « %s » (meme demande, autre moteur)" % (nom, _pd))
+                except Exception as _ex:
+                    ace_log("%s : parente non ecrite — %s" % (nom, str(_ex)[:120]))
+        ace_log("%s : CREE par le moteur 2 en %.0f s (x%.2f du temps reel)"
+                % (nom, secondes, secondes / duree if duree else 0))
+        _ACE.update(etape=None, dossier=None, dernier=nom, fin_travail=time.time(),
+                    ou=None, dernier_ou="local")
+        return True, nom
+    except Exception as ex:
+        _ACE.update(etape=None, dossier=None, ou=None)
+        ace_log("%s : creation KO — %s" % (nom, str(ex)[:200]))
+        return False, str(ex)[:200]
