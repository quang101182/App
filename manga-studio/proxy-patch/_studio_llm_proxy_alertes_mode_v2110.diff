+def titre_pose(dossier, titre):
+    """v7.36 - pose (ou retire, si vide) le titre affiche d'un morceau. Le dossier n'est JAMAIS renomme."""
+    dossier = os.path.basename(str(dossier or ""))
+    d = os.path.join(OUT_ROOT, "gs", "audio", dossier)
+    if not dossier or dossier.startswith("_") or not os.path.isdir(d):
+        return {"error": "morceau introuvable"}
+    titre = re.sub(r"\s+", " ", str(titre or "")).strip()[:120]
+    f = os.path.join(d, "titre.json")
+    if not titre:
+        try:
+            os.remove(f)
+        except OSError:
+            pass
+        return {"ok": True, "titre": None}
+    with io.open(f + ".tmp", "w", encoding="utf-8") as h:
+        json.dump({"titre": titre, "quand": time.strftime("%Y-%m-%d %H:%M:%S")}, h, ensure_ascii=False)
+    os.replace(f + ".tmp", f)
+    return {"ok": True, "titre": titre}
