+def _ref_get(url, timeout=12, mb=False):
+    if mb:                                # MusicBrainz : 1 requete par seconde, sinon 503
+        with _MB_VERROU:
+            attente = 1.1 - (time.time() - _MB_DERNIER["t"])
+            if attente > 0:
+                time.sleep(attente)
+            _MB_DERNIER["t"] = time.time()
+    req = urllib.request.Request(url, headers={"User-Agent": REF_UA, "Accept": "application/json"})
+    # v6.32c - MusicBrainz a sature plus de 7 s au banc (Adele : 503 apres 2 + 5 s) -> jusqu'a 37 s en tout
+    pauses = (0, 2, 5, 10, 20) if mb else (0, 2, 5)
+    for k, pause in enumerate(pauses):
+        if pause:
+            time.sleep(pause)
+        try:
+            with urllib.request.urlopen(req, timeout=timeout) as r:
+                return json.loads(r.read().decode("utf-8", "replace") or "{}")
+        except urllib.error.HTTPError as e:
+            # 503 / 429 : le service demande de ralentir (MusicBrainz : vu au banc). Le reste est une vraie erreur.
+            if e.code not in (429, 503) or k == len(pauses) - 1:
+                raise
+            ref_log("%s repond %s : nouvel essai" % (url.split("/")[2], e.code))
+        except (urllib.error.URLError, TimeoutError, OSError) as e:
+            if k == len(pauses) - 1:
+                raise
+            ref_log("%s : %s, nouvel essai" % (url.split("/")[2], str(e)[:60]))
