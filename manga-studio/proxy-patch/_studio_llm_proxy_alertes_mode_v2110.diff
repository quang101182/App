+    ace_log("%s : ENRICHI %s en %.0f s (x%.2f du temps reel)%s -> nouveau morceau « %s » "
+            "(l'original reste intact)"
+            % (nom, "EN LIGNE" if marque["ou"] == "cloud" else "en local", secondes,
+               secondes / duree if duree else 0,
+               (" — %.4f $" % marque["cout_usd"]) if marque.get("cout_usd") is not None else "", nom2))
+    try:
+        if fichier.startswith(tempfile.gettempdir()):
