+def mp3_depuis(source):
+    """MP3 192k d'un son, en cache hors de output/ (v6.00). Rend le chemin du MP3.
+    v6.26 : sorti de la route de lecture pour servir aussi la notification Telegram."""
+    _st = os.stat(source)
+    _cle = hashlib.sha1(("%s|%d|%d" % (source, _st.st_size, int(_st.st_mtime))).encode("utf-8")).hexdigest()[:16]
+    os.makedirs(MP3_CACHE, exist_ok=True)
+    _cache = os.path.join(MP3_CACHE, _cle + ".mp3")
+    if not os.path.isfile(_cache):
+        # ecriture atomique : deux telechargements en lot (ou la notification) peuvent
+        # demander le meme morceau en meme temps -> un temporaire PAR FIL.
+        _tmp = _cache + ".part%d" % threading.get_ident()
+        # -f mp3 est OBLIGATOIRE : le temporaire ne finit pas par .mp3, et sans
+        # lui ffmpeg repond "Unable to choose an output format" (paye le 17/09).
+        _r = subprocess.run(["ffmpeg", "-y", "-hide_banner", "-loglevel", "error",
+                             "-i", source, "-codec:a", "libmp3lame", "-b:a", "192k",
+                             "-f", "mp3", _tmp],
+                            capture_output=True, text=True, timeout=180,
+                            creationflags=getattr(subprocess, "CREATE_NO_WINDOW", 0))
+        if _r.returncode != 0 or not os.path.isfile(_tmp):
+            raise RuntimeError((_r.stderr or "ffmpeg KO")[:200])
+        os.replace(_tmp, _cache)
+    return _cache
+
