+def ref_filet_court(texte):
+    """L'IA n'a vu aucune reference dans une phrase de 1 a 3 mots. Deezer tranche, strictement :
+    un ARTISTE tres proche (>= 0,8) et tres ecoute (>= 200 000 fans), sinon un TITRE quasi identique
+    (>= 0,95) et tres ecoute (rang >= 700 000). « lofi chill » : Deezer ne renvoie rien (mesure)."""
+    for a in ref_dz_artistes(texte)[:5]:
+        if a["fans"] >= 200000 and ref_proche(texte, a["nom"]) >= 0.8:
+            return {"artiste": a["nom"], "titre": None}
+    for t in ref_dz_titres(texte, 8):
+        if t["rang"] >= 700000 and ref_proche(re.sub(r"\(.*?\)", "", t["titre"] or ""), texte) >= 0.95:
+            return {"artiste": None, "titre": texte}
+    return None
