+def yue2_stop():
+    # v6.43 : on ne TUE plus un moteur qui calcule (18/09 : ce geste, carte saturee, a reinitialise le pilote et
+    # fait geler le PC). On demande l'arret propre, on attend qu'il soit effectif, et seulement alors on coupe.
+    p = yue2_get("/ping", timeout=3)
+    if p and p.get("busy"):
+        yue2_post("/cancel", {}, timeout=10)
+        garde_log("arret du moteur demande PENDANT un calcul : annulation propre d'abord")
+        for _ in range(120):
+            time.sleep(1)
+            p = yue2_get("/ping", timeout=3)
+            if not p or not p.get("busy"):
+                break
+        else:
+            garde_log("arret REFUSE : le moteur calcule toujours apres 120 s (on ne le tue pas)")
+            return {"error": "le moteur calcule encore : arret refuse pour ne pas faire planter la carte graphique"}
+    yue2_post("/unload", {}, timeout=20)
+    pid = yue2_pid()
+    if not pid:
+        return {"ok": True, "already": True}
+    try:
+        subprocess.run(["taskkill", "/F", "/T", "/PID", str(pid)], capture_output=True,
+                       creationflags=(0x08000000 if os.name == "nt" else 0))
+        return {"ok": True, "killed": pid}
+    except Exception as ex:
+        return {"error": str(ex)}
