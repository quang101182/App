+def ref_norm(t):
+    t = unicodedata.normalize("NFD", str(t or "").lower())
+    t = "".join(c for c in t if unicodedata.category(c) != "Mn")
+    t = re.sub(r"\b(the|les?|la|feat|ft|featuring)\b", " ", t)
+    return re.sub(r"[^a-z0-9]+", " ", t).strip()
+
+
+def ref_proche(a, b):
+    """Similarite 0..1 de deux noms normalises (fautes de frappe)."""
+    import difflib
+    a, b = ref_norm(a), ref_norm(b)
+    if not a or not b:
+        return 0.0
+    return difflib.SequenceMatcher(None, a, b).ratio()
