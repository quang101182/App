+            return {"etat": "inconnu", "erreur": "tache introuvable (le PC a peut-etre redemarre)"}
+        return {"etat": j["etat"], "res": j["res"], "erreur": j["erreur"],
+                "s": round((j.get("fin") or time.time()) - j["t0"], 1)}
