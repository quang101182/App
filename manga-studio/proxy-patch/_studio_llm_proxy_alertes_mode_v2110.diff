+def titres_morceaux():
+    """v7.36 - {dossier: titre} : titre choisi par Quang (titre.json) ; v7.45 - a defaut, le titre DEMANDE a la creation.
+    Sans lui, un titre non latin (« 終焉の光 ») donnait le dossier « morceau-<id> » -> la playlist affichait « morceau »
+    pour des demandes differentes (Quang, 22/09)."""
+    base = os.path.join(OUT_ROOT, "gs", "audio")
+    out = {}
+    try:
+        noms = os.listdir(base)
+    except Exception:
+        return out
+    for n in noms:
+        if n.startswith("_"):
+            continue
+        f = os.path.join(base, n, "titre.json")
+        if os.path.isfile(f):
+            try:
+                with io.open(f, encoding="utf-8") as h:
+                    t = str((json.load(h) or {}).get("titre") or "").strip()
+                if t:
+                    out[n] = t[:120]
+                    continue
+            except Exception:
+                pass
+        td = titre_demande(os.path.join(base, n))
+        if td:
