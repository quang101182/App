+                if x.get("jour") == auj:
+                    tot["jour"] += u; tot["n_jour"] += 1
+    except FileNotFoundError:
+        pass
+    return {"ok": True, **{k: (round(v, 8) if isinstance(v, float) else v) for k, v in tot.items()},
+            "par_vue_mois": {k: round(v, 8) for k, v in sorted(par_vue.items(), key=lambda kv: -kv[1])},
+            "par_fournisseur_mois": {k: round(v, 8) for k, v in sorted(par_fourn.items(), key=lambda kv: -kv[1])},
+            "heure_pleine_deepseek": deepseek_heure_pleine(),
