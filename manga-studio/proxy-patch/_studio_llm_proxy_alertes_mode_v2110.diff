+                shutil.copyfile(os.path.join(dossier, f), os.path.join(d2, f))
+        neuf = os.path.join(d2, "_audio_enrichi.tmp")
+        shutil.copyfile(fichier, neuf)
+        os.replace(neuf, os.path.join(d2, "audio.flac"))   # atomique : jamais de fichier a moitie ecrit
+        rq2 = {}
+        try:
+            with io.open(os.path.join(dossier, "request.json"), encoding="utf-8") as f:
+                rq2 = json.load(f) or {}
