+def deepseek_heure_pleine(t=None):
+    g = time.gmtime(t if t is not None else time.time())
+    return g.tm_wday < 5 and (1 <= g.tm_hour < 4 or 6 <= g.tm_hour < 10)
+
+
+def cout_usd(fournisseur, modele, usage, t=None):
+    """Rend (usd, jetons_entree, jetons_sortie) a partir de l'usage REEL renvoye par le fournisseur."""
+    u = usage or {}
+    t = t if t is not None else time.time()
+    if fournisseur == "deepseek":
+        hit = int(u.get("prompt_cache_hit_tokens") or 0)
+        miss = u.get("prompt_cache_miss_tokens")
+        miss = int(miss) if miss is not None else max(0, int(u.get("prompt_tokens") or 0) - hit)
+        out = int(u.get("completion_tokens") or 0)
+        f = 2.0 if deepseek_heure_pleine(t) else 1.0
+        return (hit * 0.003 + miss * 0.15 + out * 0.60) * f / 1e6, hit + miss, out
+    if fournisseur == "gemini":
+        inp = int(u.get("promptTokenCount") or 0)
+        out = int(u.get("candidatesTokenCount") or 0) + int(u.get("thoughtsTokenCount") or 0)
+        if "pro" in str(modele or ""):
+            # v6.30 : Gemini 3.1 Pro, 2 / 12 $ par M (liste publique OpenRouter, 18/09 ; audio = meme tarif)
+            return (inp * 2.0 + out * 12.0) / 1e6, inp, out
+        f = 2.0 if time.gmtime(t).tm_year >= 2027 else 1.0
+        return (inp * 0.75 + out * 3.75) * f / 1e6, inp, out
+    if fournisseur == "mistral":
+        return 0.0, int(u.get("prompt_tokens") or 0), int(u.get("completion_tokens") or 0)
+    return 0.0, 0, 0
+
+
+def cout_enregistre(fournisseur, modele, usage, quoi):
+    """Jamais bloquant : un compteur ne doit pas faire echouer l'appel qu'il compte."""
+    try:
+        t = time.time()
+        usd, e_, s_ = cout_usd(fournisseur, modele, usage, t)
+        ligne = {"t": round(t, 1), "jour": time.strftime("%Y-%m-%d", time.localtime(t)),
+                 "fournisseur": fournisseur, "modele": modele, "quoi": str(quoi)[:40],
+                 "vue": str(getattr(_CTX, "vue", "") or "pc")[:16], "entree": e_, "sortie": s_,
+                 "usd": round(usd, 7), "reel": bool(usage)}
+        with _COUTS_VERROU:
+            os.makedirs(os.path.dirname(COUTS_LOG), exist_ok=True)
+            with open(COUTS_LOG, "a", encoding="utf-8") as f:
+                f.write(json.dumps(ligne, ensure_ascii=False) + "\n")
+        return ligne
+    except Exception as ex:
+        print("[couts] non enregistre :", ex, flush=True)
+        return None
