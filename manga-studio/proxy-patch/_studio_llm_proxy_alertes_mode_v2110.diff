+def _ref_analyse_phrase(texte):
+    """Qui est cite ? DeepSeek, temperature 0, reponse JSON. Rend {"refs":[{artiste,titre}], "reste":str}."""
+    consigne = (
+        "Tu lis la demande d'un utilisateur a un generateur de musique. Repere les ARTISTES / GROUPES et "
+        "les TITRES DE CHANSONS REELS qu'il cite, meme mal orthographies (corrige l'orthographe si tu en es "
+        "sur, sinon recopie tel quel). N'invente rien : une ambiance (« une ballade triste », « lofi chill »), "
+        "un genre (« du jazz ») ou une epoque n'est PAS une reference. Un titre seul sans artiste est possible : si "
+        "TOUTE la demande tient en quelques mots qui sont le titre d'une chanson connue (« Hello », « Despacito », "
+        "« Bohemian Rhapsody »), c'est un titre. "
+        "Reponds UNIQUEMENT par un objet JSON : "
+        '{"refs":[{"artiste":"..." ou null,"titre":"..." ou null}], "reste":"ce que demande l\'utilisateur EN PLUS '
+        'des references (ex. « mais en francais », « plus triste »), ou chaine vide"}. Sans reference : "refs":[].')
+    body = {"model": "deepseek-v4-flash", "thinking": {"type": "disabled"}, "temperature": 0.0, "max_tokens": 300,
+            "response_format": {"type": "json_object"},
+            "messages": [{"role": "system", "content": consigne}, {"role": "user", "content": str(texte)[:500]}]}
+    req = urllib.request.Request(GATEWAY + "/api/deepseek", data=json.dumps(body).encode(),
+                                 headers={"Content-Type": "application/json", "Authorization": "Bearer " + SECRET,
+                                          "User-Agent": "secret-studio/1.0"})
+    with urllib.request.urlopen(req, timeout=40) as r:
+        d = json.load(r)
+    cout_enregistre("deepseek", body["model"], d.get("usage"), "fiche:analyse")
+    txt = d["choices"][0]["message"]["content"]
+    m = re.search(r"\{.*\}", txt, re.S)
+    o = json.loads(m.group(0)) if m else {}
+    refs = []
+    for x in (o.get("refs") or [])[:3]:
+        if not isinstance(x, dict):
+            continue
+        a = (x.get("artiste") or "").strip() or None
+        t = (x.get("titre") or "").strip() or None
