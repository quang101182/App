+def concat_clips(files, cleanup=False, audio=False):
+    if len(files) < 2:
+        raise ValueError("au moins 2 clips requis")
+    safes = []
+    for fn in files:
+        safe = os.path.basename(fn)  # anti path-traversal
+        if not os.path.isfile(os.path.join(VIDEO_DIR, safe)):
+            raise FileNotFoundError("clip absent: " + safe)
+        safes.append(safe)
+    out = "studio_long_%d.mp4" % int(time.time())
+    if audio:
+        # v5.12 : clips AUDIO-VISUELS (timeline LTX) -> le simple -c copy desynchronise/coupe l'audio entre
+        # segments (timestamps). On RE-ENCODE via le filtre concat -> pistes video+audio propres et continues.
+        cmd = ["ffmpeg", "-y", "-hide_banner", "-loglevel", "error"]
+        for safe in safes: cmd += ["-i", safe]
+        n = len(safes)
+        fc = "".join("[%d:v:0][%d:a:0]" % (i, i) for i in range(n)) + "concat=n=%d:v=1:a=1[outv][outa]" % n
+        cmd += ["-filter_complex", fc, "-map", "[outv]", "-map", "[outa]",
+                "-r", "24", "-c:v", "libx264", "-pix_fmt", "yuv420p", "-c:a", "aac", out]
+        r = subprocess.run(cmd, cwd=VIDEO_DIR, capture_output=True, text=True)
+        if r.returncode != 0:
+            raise RuntimeError("ffmpeg(av): " + (r.stderr or "")[:300])
+    else:
+        listpath = os.path.join(VIDEO_DIR, "_concat_list.txt")
+        with open(listpath, "w", encoding="ascii") as f:
+            for safe in safes:
+                f.write("file '%s'\n" % safe)
+        cmd = ["ffmpeg", "-y", "-hide_banner", "-loglevel", "error",
+               "-f", "concat", "-safe", "0", "-i", "_concat_list.txt", "-c", "copy", out]
+        r = subprocess.run(cmd, cwd=VIDEO_DIR, capture_output=True, text=True)
+        if r.returncode != 0:
+            raise RuntimeError("ffmpeg: " + (r.stderr or "")[:300])
+        try: os.remove(listpath)
+        except Exception: pass
+    # v5.04 : cleanup=True (chaînage AUTO) -> supprimer les clips intermediaires apres concat reussi.
+    if cleanup:
+        for safe in safes:
+            try: os.remove(os.path.join(VIDEO_DIR, safe))
+            except Exception: pass
+    return out
