+    except Exception:
+        return
+    change = False
+    maintenant = time.time()
+    for cle, info in list(e["jobs"].items()):
+        _j = str(info.get("job") or cle)
+        if _j.startswith("ace-"):                  # v7.34 : un morceau du moteur 2 porte son dossier dans son nom
+            nom = _j[4:] if os.path.isdir(os.path.join(base, _j[4:])) else None
+        else:
+            nom = dossier_du_job(info.get("job") or cle, info.get("t", 0))[0]
+        dossier = os.path.join(base, nom) if nom else None
+        vieux = maintenant - info.get("t", 0) > 3 * 3600
+        # un navigateur automatise, ou un job sans morceau au bout de 3 h (erreur, annulation) :
+        # rien a envoyer, on range
+        if info.get("auto") or not nom:
