+        _COUPE["fin"] = time.time()          # quelque chose attend le moteur : la grace repart de zero
+        _COUPE["dans"] = None
+        return
+    reste = MOTEUR_GRACE - (time.time() - max(_COUPE["fin"], _COUPE["mode_t"]))
+    if reste > 0:
