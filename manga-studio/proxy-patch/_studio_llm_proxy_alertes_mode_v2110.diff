+def dossier_du_job(job, depuis=0):
+    """Le dossier d'un morceau : <titre>-<6 premiers chiffres du job>. Ces 6 chiffres ne changent
+    que toutes les 10 s (le job est l'heure en secondes, modulo 10^7) : deux jobs rapproches les
+    partagent. On exige donc aussi un son ecrit APRES le lancement, et on prend le plus recent.
+    Rend (nom, fichier_flac) ou (None, None)."""
+    base = os.path.join(OUT_ROOT, "gs", "audio")
+    meilleur = (None, None, -1)
+    try:
+        for nom in os.listdir(base):
+            if nom.startswith("_") or not nom.endswith("-" + str(job)[:6]):
+                continue
+            d = os.path.join(base, nom)
+            for f in os.listdir(d):
+                if f.lower().endswith(".flac"):
+                    m = os.path.getmtime(os.path.join(d, f))
+                    if m >= depuis - 5 and m > meilleur[2]:
+                        meilleur = (nom, f, m)
+    except Exception:
+        pass
+    return meilleur[0], meilleur[1]
+
