+def ref_verifie(fiche):
+    """Contre-verification : les FAITS ecrits contre ce qui a ete entendu. Rend la liste des alertes."""
+    al = []
+    a, t, e = fiche.get("artiste") or {}, fiche.get("titre") or {}, fiche.get("ecoute") or {}
+    sexe, voix = a.get("sexe"), (e.get("voice") or "")
+    if a.get("type") == "Person" and sexe in ("male", "female") and voix in ("male", "female", "mixed") and voix != sexe:
+        al.append("voix entendue « %s » mais %s est %s (MusicBrainz) : la fiche l'emporte"
+                  % (voix, a.get("nom"), "un homme" if sexe == "male" else "une femme"))
+    b1, b2 = t.get("bpm"), e.get("tempo_mesure")
+    if b1 and b2 and not any(abs(b2 * k - b1) <= 0.08 * b1 for k in (1, 2, 0.5)):
+        al.append("tempo Deezer %s BPM, mesure %s BPM : desaccord" % (b1, b2))
+    return al
