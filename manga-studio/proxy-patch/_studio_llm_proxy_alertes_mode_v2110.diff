+            an = {"refs": data["refs"], "reste": data.get("reste") or ""}
+        elif cle_p in ref_cache_lit()["alias"]:     # phrase deja analysee : ni appel IA, ni attente
+            an = dict(ref_cache_lit()["alias"][cle_p]["an"])
+        else:
+            an = ref_analyse_phrase(texte)
+            with _REF_VERROU:
+                c = ref_cache_lit()
+                c["alias"][cle_p] = {"an": an, "t": time.time()}
+                ref_cache_ecrit(c)
+    except Exception as ex:
+        ref_log("ECHEC analyse « %s » : %s" % (texte[:80], str(ex)[:160]))
+        return {"ok": False, "erreur": "analyse impossible : %s" % str(ex)[:120], "refs": []}
+    if not an["refs"] and len(texte.split()) <= 3 and not data.get("refs"):
