+def ltx_start_worker():
+    try:
+        tok = get_runpod_write_token()
+        if not tok: _LTX.update(phase="error", msg="cle write RunPod absente"); return
+        _LTX.update(phase="resuming", msg="Déploiement d'un pod sur un hôte libre…")
+        pid = deploy_ltx_pod(_LTX)
+        if not pid:
+            _LTX.update(phase="error", msg="Aucun GPU libre trouvé dans %s après plusieurs essais — réessaie." % LTX_DC); return
+        _LTX.update(msg="Allocation du GPU…")
+        coords = None
+        for _ in range(30):   # ~2,5 min : attente du runtime (ports SSH) sur le pod fraîchement déployé
+            coords = pod_ssh_coords(pid)
+            if coords: break
+            time.sleep(5)
+        if not coords:
+            _LTX.update(phase="error", msg="Pod déployé mais GPU non alloué (timeout) — réessaie."); return
+        ip, port = coords; _LTX.update(ip=ip, port=port, phase="booting", msg="Attente du pod (FS)...")
+        # Le pod expose SSH AVANT d'avoir monté le FS réseau (venv MooseFS) -> attendre que le venv soit
+        # accessible, sinon le lancement de ComfyUI-LTX échoue silencieusement (cause des cold-start ratés).
+        for _ in range(15):
+            try:
+                rr = subprocess.run(_ssh_base(ip, port) + ["test -x %s/bin/python && echo READY" % LTX_VENV], capture_output=True, text=True, timeout=25)
+                if "READY" in (rr.stdout or ""): break
+            except Exception: pass
+            time.sleep(5)
+        _LTX.update(msg="Lancement de ComfyUI-LTX (8288)...")
+        # Ne PAS se fier à pgrep (matche des process MORTS -> cold-start qui ne monte jamais).
+        # Tester si 8288 SERT vraiment (HTTP 200) ; sinon tuer tout main.py périmé + relancer FROM SCRATCH.
+        # ⚠️ sous-shell (setsid ... &) PUIS `sleep 5` : tient le canal SSH le temps que setsid détache le
+        # process dans sa propre session (sinon SSH ferme le canal -> SIGHUP -> process tué avant détachement).
+        already = subprocess.run(_ssh_base(ip, port) + [
+            "curl -s -m 5 -o /dev/null -w '%%{http_code}' http://localhost:%d/system_stats 2>/dev/null || echo 000" % LTX_REMOTE_PORT],
+            capture_output=True, text=True, timeout=30)
+        if "200" not in (already.stdout or ""):
+            # libérer le port via fuser (matche le SOCKET, pas le cmdline) -> ne se suicide PAS,
+            # contrairement à `pkill -f 'main.py..--port 8288'` qui matcherait le cmdline de CE shell de lancement.
+            try: subprocess.run(_ssh_base(ip, port) + ["fuser -k %d/tcp 2>/dev/null; sleep 2; true" % LTX_REMOTE_PORT], capture_output=True, text=True, timeout=30)
+            except Exception: pass
+            # lancement SEUL (aucun pkill ici, sinon suicide du shell avant que setsid ne lance le python)
+            # N2 (v5.03) : --highvram --disable-smart-memory gardent le modele LTX 42 Go RESIDENT en VRAM (H100 80 Go).
+            # v5.06 : lancement via TMUX (pas setsid) = process detache ROBUSTE -> survit aux deconnexions SSH + log
+            # capture. Corrige les morts silencieuses du moteur LTX observees 28/06 (process disparaissait sans OOM ni
+            # logind ni erreur applicative ; setsid mal detache ou SIGHUP tunnel suspecte). tmux = daemon hors session.
+            launch = ("tmux kill-session -t ltx 2>/dev/null; "
+                      "tmux new-session -d -s ltx 'cd %s && %s/bin/python main.py --listen --port %d --use-sage-attention --highvram --disable-smart-memory > /workspace/ltx_comfy.log 2>&1'; "
+                      "sleep 3 ; echo LTX_LAUNCHED") % (LTX_DIR, LTX_VENV, LTX_REMOTE_PORT)
+            try: subprocess.run(_ssh_base(ip, port) + [launch], capture_output=True, text=True, timeout=60)
+            except Exception as e: _LTX.update(phase="error", msg="lancement LTX KO: " + str(e)[:100]); return
+        _LTX.update(phase="tunneling", msg="Démarrage du moteur..."); open_ltx_tunnel(ip, port)
+        for _ in range(75):   # ~5 min : couvre le bind du serveur (le chargement 42Go se fait à la 1re génération)
+            if ltx_comfy_ready(): _LTX.update(phase="ready", msg="Cloud LTX-2.3 pret"); return
+            time.sleep(4)
+        _LTX.update(phase="error", msg="ComfyUI-LTX pas pret après lancement (voir /workspace/ltx_comfy.log)")
+    except Exception as e:
+        _LTX.update(phase="error", msg=str(e)[:160])
