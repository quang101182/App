+def enrich_loop():
+    """Calque `mastering_loop`. Deux differences, toutes deux dictees par la memoire de la carte :
+    on ne demarre pas si la carte travaille, et on ETEINT le moteur 2 des qu'il n'a plus rien a faire."""
+    time.sleep(20)
+    while True:
+        try:
+            lot = enrich_a_faire()[:1]
+            if lot:
+                occupe = False
+                try:
+                    p = yue2_get("/ping", timeout=2)
+                    occupe = bool((p or {}).get("busy")) or bool(gpu_state().get("busy"))
+                except Exception:
+                    occupe = False
+                if not occupe:
+                    enrich_calcule(lot[0])
+            else:
+                fin = _ACE.get("fin_travail")
+                # ⛔ LE MOTEUR ORPHELIN — corrige le 20/09 au soir, apres que Quang a constate
+                # 5,3 Go pris « alors que rien ne tourne ». Le serveur ACE-Step tournait depuis
+                # 16 h 35, soit plus de TROIS HEURES, sans avoir rien a faire.
+                #
+                # La cause : `fin_travail` vit en MEMOIRE VIVE. Il n'est pose qu'a la fin d'un
+                # enrichissement ; si le proxy redemarre entre-temps (mise a jour, plantage, ou
+                # simplement une relance pendant une mise au point), il repart a None — et la
+                # condition `if fin and ...` n'est alors PLUS JAMAIS vraie. Le moteur deja allume
+                # devient un orphelin que plus personne n'eteint, et il garde la carte pour lui.
+                # Le symptome est silencieux : rien ne calcule, rien ne s'affiche, mais tout ce qui
+                # a besoin de la carte devient lent ou se voit refuser le depart par le garde-fou.
+                #
+                # Le remede : si le moteur est allume et qu'il n'y a rien a faire, on ARME le
+                # compteur au lieu de l'ignorer. Il s'eteindra donc au plus tard ACE_INACTIF_MAX
+                # apres le demarrage du proxy — au lieu de jamais.
+                if fin is None and ace_pid() and not _ACE.get("etape"):
+                    _ACE["fin_travail"] = time.time()
+                    ace_log("moteur 2 deja allume et sans travail (orphelin d'une session "
+                            "precedente ?) : extinction armee dans %d s" % ACE_INACTIF_MAX)
+                elif fin and ace_pid() and not _ACE.get("etape") \
+                        and time.time() - fin > ACE_INACTIF_MAX:
+                    # ⛔ `not _ACE.get("etape")` EST VITAL, et son absence a ete une REGRESSION de
+                    # cette meme session : depuis que l'enrichissement automatique est reserve au
+                    # mode « 1+2 », `enrich_a_faire()` rend [] en 🎨 et en ⚖️ — donc cette branche
+                    # s'execute PENDANT une creation. Le moteur etait tue en plein travail :
+                    #   22:01:45 CREATION demandee … / 22:02:07 moteur 2 demarre
+                    #   22:02:10 moteur 2 eteint (plus rien a enrichir depuis 180 s)
+                    # « Plus rien a ENRICHIR » ne veut pas dire « plus rien a FAIRE ». Toute
+                    # extinction doit verifier l'etat REEL du moteur, jamais la seule file d'attente.
+                    ace_stop("plus rien a enrichir depuis %d s" % ACE_INACTIF_MAX)
+                    _ACE["fin_travail"] = None
+        except Exception as ex:
+            ace_log("boucle : %s" % str(ex)[:200])
+        time.sleep(6)
