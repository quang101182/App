+    rt = pod_query(pod_id).get("runtime")
+    if not rt: return None
+    for pt in (rt.get("ports") or []):
+        if pt.get("type") == "tcp" and pt.get("privatePort") == 22:
+            return pt.get("ip"), pt.get("publicPort")
+    return None
+
+def _ssh_base(ip, port):
+    return ["ssh", "-i", RUNPOD_SSH_KEY, "-p", str(port), "-o", "StrictHostKeyChecking=no",
+            "-o", "ConnectTimeout=20", "root@" + ip]
+
+def close_tunnel():
+    t = _CLOUD.get("tunnel")
+    if t:
+        try: t.terminate()
+        except Exception: pass
+    _CLOUD["tunnel"] = None
+
+def open_tunnel(ip, port):
+    close_tunnel()
+    cmd = ["ssh", "-i", RUNPOD_SSH_KEY, "-p", str(port), "-o", "StrictHostKeyChecking=no",
+           "-o", "ExitOnForwardFailure=yes", "-o", "ServerAliveInterval=30", "-N",
+           "-L", "%d:localhost:8188" % CLOUD_TUNNEL_PORT, "root@" + ip]
+    _CLOUD["tunnel"] = subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, stdin=subprocess.DEVNULL)
+
+def cloud_comfy_ready():
+    try:
+        urllib.request.urlopen(COMFY_CLOUD + "/system_stats", timeout=5); return True
+    except Exception:
+        return False
+
+def _resume_pod_with_retry(state):
+    """P0 (v5.03) : resume le pod ET attend l'allocation GPU REELLE. Si RunPod n'a pas de H100 libre
+    (runtime null), RETENTE le podResume plusieurs fois (capacite H100 intermittente). Retourne (ip,port)
+    ou None. Message HONNETE distinguant 'pas de capacite GPU' du faux 'SSH indisponible'."""
+    tok = get_runpod_write_token()
+    if not tok:
+        state.update(phase="error", msg="cle write RunPod absente"); return None
+    ALLOC_ATTEMPTS = 5      # tentatives de podResume (capacite H100 fluctuante)
+    POLL_PER_ATTEMPT = 8    # ~40s d'attente d'allocation par tentative
+    for attempt in range(ALLOC_ATTEMPTS):
+        try: _rp_graphql('mutation { podResume(input:{podId:"%s", gpuCount:1}) { id } }' % RUNPOD_POD_ID, tok)
+        except Exception: pass   # deja running OU refus capacite -> on tranche via runtime, pas via l'exception
+        for _ in range(POLL_PER_ATTEMPT):
+            coords = pod_ssh_coords()
+            if coords: return coords
+            time.sleep(5)
+        state.update(msg="Aucun H100 libre chez RunPod — nouvel essai %d/%d..." % (attempt + 1, ALLOC_ATTEMPTS))
+        time.sleep(6)
+    return None
+
+def cloud_start_worker():
+    try:
+        tok = get_runpod_write_token()
+        if not tok: _CLOUD.update(phase="error", msg="cle write RunPod absente"); return
+        _CLOUD.update(phase="resuming", msg="Demarrage du pod...")
+        coords = _resume_pod_with_retry(_CLOUD)
+        if not coords:
+            _CLOUD.update(phase="error", msg="Aucun H100 disponible chez RunPod pour l'instant — reessaie dans quelques minutes"); return
+        ip, port = coords; _CLOUD.update(ip=ip, port=port, phase="booting", msg="Bootstrap ComfyUI (modeles)...")
+        _spend_log("start", RUNPOD_POD_ID, "wan", WAN_RATE_USD_HR)   # journal depense persistant (pod fixe alloue = facture)
+        try: subprocess.run(_ssh_base(ip, port) + ["cd /workspace && bash boot_hv.sh"], capture_output=True, text=True, timeout=600)
+        except Exception as e: _CLOUD.update(phase="error", msg="bootstrap KO: " + str(e)[:100]); return
+        _CLOUD.update(phase="tunneling", msg="Ouverture du tunnel..."); open_tunnel(ip, port)
+        for _ in range(45):
+            if cloud_comfy_ready(): _CLOUD.update(phase="ready", msg="Cloud H100 pret"); return
+            time.sleep(4)
+        _CLOUD.update(phase="error", msg="ComfyUI cloud pas pret apres bootstrap")
+    except Exception as e:
+        _CLOUD.update(phase="error", msg=str(e)[:160])
+
+def cloud_status():
+    p = _CLOUD.get("phase", "stopped")
+    if p == "ready" and not cloud_comfy_ready():
+        if _CLOUD.get("ip"):
+            open_tunnel(_CLOUD["ip"], _CLOUD["port"]); time.sleep(2)
+        if not cloud_comfy_ready():
+            p = "booting"; _CLOUD["phase"] = p; _CLOUD["msg"] = "Reconnexion du tunnel..."
+    return {"phase": p, "msg": _CLOUD.get("msg", ""), "ready": (p == "ready"), "podId": RUNPOD_POD_ID}
+
+def cloud_start():
+    p = _CLOUD.get("phase")
+    if p in ("resuming", "booting", "tunneling"):
+        # P2 (v5.03) : si bloque en demarrage depuis trop longtemps (worker mort / threads epuises), debloquer en relancant.
+        if _CLOUD.get("start_ts") and (time.time() - _CLOUD["start_ts"]) < 900:
+            return cloud_status()
+    _CLOUD["start_ts"] = time.time()
+    try:
+        threading.Thread(target=cloud_start_worker, daemon=True).start()
+    except Exception as e:
+        _CLOUD.update(phase="error", msg="demarrage impossible (ressources serveur): " + str(e)[:80])
+        return cloud_status()
+    return {"phase": "resuming", "msg": "Demarrage demande...", "ready": False}
+
+def cloud_stop():
+    # v5.07 INSTRUMENTATION : tracer QUI coupe le pod (watchdog auto vs endpoint HTTP /pod_stop = l'app autoStopCloud).
+    try:
+        import traceback
+        _caller = "".join(traceback.format_stack()[-4:-1])[-500:]
+        print("[POD_STOP] @%s cloud_stop() appele PAR:\n%s" % (time.strftime("%H:%M:%S"), _caller), flush=True)
+    except Exception: pass
+    close_tunnel()
+    msg = "Pod arrete"
+    try:
+        tok = get_runpod_write_token()
+        _spend_log("stop", RUNPOD_POD_ID, "wan", WAN_RATE_USD_HR)   # journal AVANT podStop (uptime encore lisible)
+        if tok: _rp_graphql('mutation { podStop(input:{podId:"%s"}) { id } }' % RUNPOD_POD_ID, tok)
+    except Exception as e:
+        msg = "stop: " + str(e)[:100]
+    _CLOUD.update(phase="stopped", msg=msg, ip=None, port=None)
+    try: close_ltx_tunnel(); _terminate_ltx_pod_silent(); _LTX.update(phase="stopped", msg="", ip=None, port=None)  # v5.54 : TERMINER aussi le pod LTX éphémère (podTerminate) — sinon il restait facturé ~10min jusqu'au watchdog à chaque coupe manuelle (audit 02/07). _terminate_ltx_pod_silent ne touche JAMAIS le pod fixe.
+    except Exception: pass
+    # Rafraichir l'etat watchdog IMMEDIATEMENT (sinon /pod_guard rend up=true jusqu'a ~30s -> LED ment apres une coupe manuelle).
+    try: _WD.update(up=False, busy=False, up_since=None, idle_since=None, engine=None, last_stop=time.time())
+    except Exception: pass
+    return {"phase": "stopped", "msg": msg}
+
+# ============ Moteur Cloud LTX-2.3 (2e ComfyUI sur le pod:8288, audio natif) ============
+# Calqué sur le moteur Cloud H100 ci-dessus. Même pod (RUNPOD_POD_ID), 2e tunnel SSH -> pod:8288.
+# ⚠️ La construction du workflow LTX se fait côté front via un TEMPLATE JSON-API capturé une fois
+#    (nodes LTXV spéciaux + graphToPrompt), pas en JSON plat comme Wan. Voir ltx_capture_templates.py.
+_LTX = {"phase": "stopped", "tunnel": None, "ip": None, "port": None, "msg": ""}
+
+def close_ltx_tunnel():
+    t = _LTX.get("tunnel")
+    if t:
+        try: t.terminate()
+        except Exception: pass
+    _LTX["tunnel"] = None
+
+def open_ltx_tunnel(ip, port):
+    close_ltx_tunnel()
+    cmd = ["ssh", "-i", RUNPOD_SSH_KEY, "-p", str(port), "-o", "StrictHostKeyChecking=no",
+           "-o", "ExitOnForwardFailure=yes", "-o", "ServerAliveInterval=30", "-N",
+           "-L", "%d:localhost:%d" % (LTX_TUNNEL_PORT, LTX_REMOTE_PORT), "root@" + ip]
+    _LTX["tunnel"] = subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, stdin=subprocess.DEVNULL)
+
+def ltx_comfy_ready():
+    try:
+        urllib.request.urlopen(COMFY_LTX + "/system_stats", timeout=5); return True
+    except Exception:
+        return False
