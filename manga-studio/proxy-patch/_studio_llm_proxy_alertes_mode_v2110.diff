+    # Ecrite seulement si l'app juge le lien intact (garde-fou) ; un chemin qui sort de gs/audio est ignore.
+    _par = str(origine.get("parent") or "").replace("\\", "/").strip("/")
+    if re.match(r"^gs/audio/[^/._][^/]*$", _par):
+        o["parent"] = _par[:200]
+        # v6.96 : troisieme valeur de lien — « moteur ». Le mode ⚖️ produit DEUX morceaux sur la
+        # meme demande (un par moteur) : sans valeur dediee, l'app afficherait « ↻ liée à la
+        # création », ce qui est faux — ce n'est ni une reprise de reglages ni la meme melodie,
+        # c'est la MEME demande jouee par l'autre moteur.
+        # v6.97 — QUATRE natures de lien, et elles ne se valent PAS pour la lecture « même seconde ».
+        # Ce qui compte n'est pas « quel moteur », c'est : EST-CE LE MEME DEROULE SONORE ?
+        #   • "enrichi"  : la copie amelioree d'un morceau — MEME deroule, meme duree. La meme
+        #                  seconde compare vraiment la meme mesure. C'est le seul cas EXACT.
+        #   • "moteur"   : duo ⚖️, meme demande jouee par l'autre moteur — DEUX compositions.
+        #                  A 1:12 l'un est au refrain, l'autre au pont : la meme seconde trompe.
+        #   • "melodie"  : meme partition, interpretation differente — approximatif.
+        #   • "reglages" : reglages repris — compositions differentes.
+        o["lien"] = (origine.get("lien") if origine.get("lien") in ("melodie", "moteur", "enrichi")
+                     else "reglages")
+    if origine.get("moteur") in ACE_MODES:                # v7.15 : le moteur choisi POUR CE MORCEAU (feuille)
+        o["moteur"] = origine["moteur"]
