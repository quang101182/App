+def _mp3_par_lien(vid, t0):
+    cmd = _ytdlp()
+    if not cmd:
+        return {"ok": False, "erreur": "yt-dlp introuvable sur le PC", "candidats": []}
+    r = subprocess.run(cmd + ["--no-playlist", "--skip-download", "--encoding", "utf-8", "--no-warnings", "--print",
+                              "%(id)s\t%(duration)s\t%(channel)s\t%(artist)s\t%(track)s\t%(title)s", "--",
+                              "https://www.youtube.com/watch?v=" + vid],
+                       capture_output=True, text=True, encoding="utf-8", errors="replace", timeout=90,
+                       creationflags=getattr(subprocess, "CREATE_NO_WINDOW", 0))
+    p = ((r.stdout or "").strip().splitlines() or [""])[0].split("\t")
+    if len(p) < 6 or p[0] != vid:
+        err = ((r.stderr or "") + (r.stdout or "")).strip()[-160:]
+        mp3_log("LIEN %s illisible : %s" % (vid, err))
+        return {"ok": False, "erreur": "vidéo introuvable ou privée (%s)" % (err or "aucune réponse")[:120], "candidats": []}
+    na = lambda s: "" if s in ("NA", "None") else s.strip()
+    try:
+        d = round(float(p[1]))
+    except Exception:
+        d = None
+    chaine, artiste, titre, titre_video = na(p[2]), na(p[3]), na(p[4]), "\t".join(p[5:]).strip()
+    if not titre:                                      # pas de metadonnees YouTube Music : « Artiste - Titre [Official…] »
+        propre = _mp3_titre_video_propre(titre_video)
+        jp = re.search(r"[『「【](.+?)[』」】]", propre)   # v7.51 : « Artiste『Titre』 » (DARK ARIA)
+        if jp:
+            artiste, titre = propre[:jp.start()].strip(" :/-"), jp.group(1).strip()
+        elif " - " in propre:
+            artiste, titre = [x.strip() for x in propre.split(" - ", 1)]
+        else:
+            titre = propre
+    if not artiste:
+        artiste = re.sub(r"\s*-\s*Topic$", "", chaine).strip()
+    lr = _mp3_lien_lrclib(titre_video, artiste, titre, d)
+    if lr:                                             # v7.49 : le VRAI artiste / titre, ceux ou la reprise cherchera ses paroles
+        mp3_log("LIEN %s : LRCLIB reconnait « %s - %s » (%s s) via « %s »" % (vid, lr[0], lr[1], lr[2], lr[3]))
+        artiste, titre = lr[0], lr[1]
+    c = {"id": vid, "duree": d, "chaine": chaine, "titre": titre_video, "conforme": True, "raison": "lien donné"}
+    fiche = {"artiste": artiste, "titre": titre or titre_video, "duree": d, "verifiee": bool(lr), "lien": True,
+             "paroles": bool(lr)}
+    deja = _mp3_deja(artiste, fiche["titre"])
+    mp3_log("LIEN %s « %s » %s s -> fiche « %s - %s »%s (%.1f s)" % (
+        vid, titre_video, d, artiste, fiche["titre"], (" - deja sur le PC : " + deja) if deja else "", time.time() - t0))
+    return {"ok": True, "fiche": fiche, "deja": deja, "candidats": [c], "choisi": c, "lien": True,
+            "requete": vid, "s": round(time.time() - t0, 1)}
