+                tot["total"] += u; tot["n_total"] += 1
+                if str(x.get("jour", "")).startswith(mois):
+                    tot["mois"] += u; tot["n_mois"] += 1
+                    v = x.get("vue") or "pc"
+                    par_vue[v] = par_vue.get(v, 0.0) + u
+                    fo = x.get("fournisseur") or "?"
