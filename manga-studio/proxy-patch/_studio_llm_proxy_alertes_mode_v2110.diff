+def menage_dossiers_orphelins(maintenant=None):
+    """v6.27 - les dossiers de morceau SANS AUCUN SON. `/delete` retire deja le dossier avec le
+    son (v6.03) ; ceux-la viennent de generations ECHOUEES a l'ecriture (ex. 17/09 : plan.json
+    en cp1252 sur un morceau coreen -> dossier de .tmp). Invisibles dans la Playlist, ils
+    s'accumulaient : 24 dossiers le 18/09. Garde-fous : jamais un dossier « _ », jamais un
+    dossier qui contient un son, jamais un dossier touche depuis moins de 2 h (le moteur peut
+    etre en train d'ecrire), jamais pendant une generation. Rend la liste des dossiers retires."""
+    maintenant = maintenant or time.time()
+    base = os.path.join(OUT_ROOT, "gs", "audio")
+    retires = []
+    try:
+        noms = os.listdir(base)
+    except Exception:
+        return retires
+    for nom in noms:
+        d = os.path.join(base, nom)
+        if nom.startswith("_") or not os.path.isdir(d):
+            continue
+        try:
+            fichiers = []
+            for r_, _, fs in os.walk(d):
+                fichiers += [os.path.join(r_, f) for f in fs]
+            if any(os.path.splitext(f)[1].lower() in (".flac", ".wav", ".mp3", ".ogg", ".m4a") for f in fichiers):
+                continue
+            recent = max([os.path.getmtime(f) for f in fichiers] + [os.path.getmtime(d)])
+            if maintenant - recent < MENAGE_ORPHELINS_AGE:
+                continue
+            shutil.rmtree(d)
+            retires.append(nom)
+        except Exception as ex:
+            print("[menage] %s : %s" % (nom, str(ex)[:120]), flush=True)
+    if retires:
+        try:
+            os.makedirs(os.path.dirname(MENAGE_ORPHELINS_LOG), exist_ok=True)
+            with open(MENAGE_ORPHELINS_LOG, "a", encoding="utf-8") as f:
+                f.write("%s retires (aucun son, > 2 h) : %s\n" % (time.strftime("%Y-%m-%d %H:%M:%S"), ", ".join(retires)))
+        except Exception:
+            pass
+        print("[menage] dossiers sans son retires : %s" % ", ".join(retires), flush=True)
+    return retires
+
