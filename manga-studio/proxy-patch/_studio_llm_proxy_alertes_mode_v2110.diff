+def fidelite_lot():
+    """Un morceau par passage, jamais pendant une generation (la carte graphique est au moteur)."""
+    if moteur_musique_occupe():
+        return 0
+    lot = fidelite_a_faire()[:1]
+    for dossier, son, og in lot:
+        _FIDELITE["en_cours"] = os.path.basename(dossier)
+        try:
+            fidelite_calcule(dossier, son, og)
+            _FIDELITE["erreur"] = None
+        except Exception as ex:
+            _FIDELITE["erreur"] = str(ex)[:200]
+            fidelite_log("ECHEC « %s » : %s" % (os.path.basename(dossier), str(ex)[:200]))
+            # un echec ne doit pas bloquer la file : on le marque, on retentera au redemarrage
+            try:
+                fj = os.path.join(dossier, "fidelite.json")
+                try:
+                    with io.open(fj, encoding="utf-8") as f:
+                        n_ = (json.load(f) or {}).get("tentatives", 1) + 1
+                except Exception:
+                    n_ = 1
+                with io.open(fj, "w", encoding="utf-8") as f:
+                    json.dump({"score": None, "erreur": str(ex)[:200], "tentatives": n_,
+                               "quand": time.strftime("%Y-%m-%d %H:%M:%S")}, f)
+            except Exception:
+                pass
+        finally:
+            _FIDELITE["en_cours"] = None
+            _FIDELITE["dernier"] = time.strftime("%Y-%m-%d %H:%M:%S")
+    return len(lot)
