+def mastering_annule(data):
+    """Remet le son d'AVANT le mastering et marque le morceau « annule » (jamais re-masterise)."""
+    ch = str((data or {}).get("chemin") or "").replace("\\", "/").strip("/")
+    if not re.match(r"^gs/audio/[^/._][^/]*$", ch):
+        return {"ok": False, "erreur": "chemin refuse"}
+    dossier = os.path.join(OUT_ROOT, *ch.split("/"))
+    nom = os.path.basename(dossier)
+    sauve = os.path.join(MASTER_SAUVE, nom, "audio.flac")
+    son = os.path.join(dossier, "audio.flac")
+    if not os.path.isfile(sauve) or not os.path.isfile(son):
+        return {"ok": False, "erreur": "aucune version d'avant le mastering pour ce morceau"}
+    try:
+        st = os.stat(son)
+        shutil.copy2(sauve, son + ".part")
+        os.replace(son + ".part", son)
+        os.utime(son, (st.st_atime, st.st_mtime))
+    except Exception as ex:
+        return {"ok": False, "erreur": "remplacement impossible (morceau en lecture ?) : " + str(ex)[:120]}
+    with io.open(os.path.join(dossier, "mastering.json"), "w", encoding="utf-8") as f:
+        json.dump({"action": "annule", "quand": time.strftime("%Y-%m-%d %H:%M:%S")}, f)
+    mastering_log("« %s » : ANNULE a la demande (son d'avant remis)" % nom)
+    return {"ok": True}
