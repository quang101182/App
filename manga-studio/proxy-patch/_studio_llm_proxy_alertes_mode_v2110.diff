+# ---------- Enrichissement : type (Perso/Style/Concept) + sujets, depuis les tags Civitai /models/{id} ----------
+# Valide en live sur 8 LoRA reels (21/06) : Civitai 'type'=toujours 'LORA' (inutile) -> ce sont les TAGS qui portent
+# la categorie + les sujets. Ordre de priorite Style -> Concept -> Perso -> Autre (100% correct sur l'echantillon).
+CAT_STYLE = {"style", "styles", "art style"}
+CAT_CONCEPT = {"concept", "concepts", "poses", "pose", "clothing", "clothes", "outfit", "outfits",
+               "objects", "object", "background", "backgrounds", "buildings", "building", "vehicle",
+               "vehicles", "tool", "tools", "action", "actions", "assets", "asset", "body type",
+               "weapons", "weapon", "slider", "sliders", "effect", "effects", "pose"}
+CAT_CHAR = {"character", "characters", "celebrity", "celebrities", "person", "people", "anime character"}
+
+def _classify_type(tags, name="", trigger=None):
+    tl = set((t or "").strip().lower() for t in (tags or []))
+    nm = (name or "").lower()
+    if (tl & CAT_STYLE) or "style" in nm: return "style"
+    if (tl & CAT_CONCEPT) or "slider" in nm or "concept" in nm: return "concept"
+    if tl & CAT_CHAR: return "character"
+    return "character" if (trigger or []) else "other"
+
+def _model_id_from(entry):
+    m = re.search(r"/models/(\d+)", (entry or {}).get("url") or "")
+    return m.group(1) if m else None
