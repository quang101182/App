+def _lance_detache(args, sortie):
+    """v7.28 - lance `args` HORS de l'arbre du proxy : un lanceur intermediaire le demarre (detache, nouveau groupe,
+    sortie dans un FICHIER) puis meurt. Rend le PID de la chaine."""
+    code = ("import subprocess,sys,os\n"
+            "f=open(sys.argv[1],'w',encoding='utf-8')\n"
+            # 23/09 (Quang, 2 captures) : DETACHED_PROCESS = AUCUNE console -> le python.exe du .venv (un LANCEUR) demarre le
+            # vrai interpreteur, qui en recoit une NEUVE = fenetre Windows Terminal vide devant Quang pendant toute la reprise
+            # (mesure : 4 fenetres). CREATE_NO_WINDOW = une console CACHEE, heritee par toute la chaine (mesure : 0).
+            "fl=0x08000000|0x00000200\n"                                # CREATE_NO_WINDOW | CREATE_NEW_PROCESS_GROUP
+            "env=dict(os.environ,PYTHONIOENCODING='utf-8',PYTHONUNBUFFERED='1')\n"
+            "try:\n p=subprocess.Popen(sys.argv[2:],stdout=f,stderr=subprocess.STDOUT,stdin=subprocess.DEVNULL,creationflags=fl|0x01000000,env=env)\n"
+            "except OSError:\n p=subprocess.Popen(sys.argv[2:],stdout=f,stderr=subprocess.STDOUT,stdin=subprocess.DEVNULL,creationflags=fl,env=env)\n"
+            "print(p.pid)\n")
+    r = subprocess.run([sys.executable, "-c", code, sortie] + list(args), capture_output=True, text=True, timeout=60,
+                       creationflags=getattr(subprocess, "CREATE_NO_WINDOW", 0))
+    return int((r.stdout or "").strip().splitlines()[-1])
