+def ref_choisit_titre(artiste, titre):
+    """Rend (titre | None, choix[], note). Prefere l'ORIGINAL (pas remix / live / reprise)."""
+    q = ("%s %s" % (artiste or "", titre or "")).strip()
+    res = ref_dz_titres(q)
+    if not res:
+        return None, [], "introuvable"
+
+    def bon(t):
+        if artiste and ref_proche(t["artiste"], artiste) < 0.5 and ref_norm(artiste) not in ref_norm(t["artiste"]):
+            return False
+        return True
+    res = [t for t in res if bon(t)] or ([] if artiste else res)
+    if not res:
+        return None, [], "introuvable"
+    originaux = [t for t in res if not REF_VERSIONS.search(t["titre"] or "")] or res
+    if titre:
+        originaux.sort(key=lambda t: (-round(ref_proche(re.sub(r"\(.*?\)", "", t["titre"]), titre), 1), -t["rang"]))
+    if not artiste:
+        # un titre seul : plusieurs artistes possibles -> si le plus ecoute ne domine pas, on demande
+        par_artiste = {}
+        for t in originaux:
+            if ref_proche(re.sub(r"\(.*?\)", "", t["titre"]), titre or "") >= 0.75:
+                k = ref_norm(re.split(r"\s*(?:&|,|\bfeat\.?|\bft\.?|\bx\b|\bwith\b)\s*", t["artiste"] or "", 1)[0])
+                if k not in par_artiste or t["rang"] > par_artiste[k]["rang"]:
+                    par_artiste[k] = t
+        cands = sorted(par_artiste.values(), key=lambda t: -t["rang"])
+        if len(cands) >= 2 and cands[0]["rang"] < 1.5 * cands[1]["rang"]:
+            return None, cands[:4], "plusieurs artistes"
+        if cands:
+            return cands[0], [], ""
+    return originaux[0], [], ""
