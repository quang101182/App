+            with io.open(ORIGINES_JSON, encoding="utf-8") as f:
+                _cache["d"] = json.load(f) or {}
+            _cache["mtime"] = st.st_mtime
+    except Exception:
+        return None
+    for job, o in (_cache.get("d") or {}).items():
+        if job.startswith(m.group(1)):
+            return {k: o.get(k) for k in ("type", "ref", "envie", "ref_desc", "parent", "lien", "reprise",
+                                          "moteur", "sans_voix")}   # v6.55 ; v6.57 ; v7.15 ; v7.54
+    return None
