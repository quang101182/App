+def delete_output(filename, subfolder=""):
+    # Supprime UN fichier precis sous output/. Jamais de wildcard.
+    #
+    # v5.63 : le sous-dossier peut avoir PLUSIEURS segments ("gs/video"). L'ancien garde-fou faisait
+    # os.path.basename(subfolder), ce qui rabotait "gs/video" en "video" : la suppression visait un
+    # dossier qui n'existe plus, ne trouvait rien, et renvoyait {"ok":true,"missing":true}. Le front
+    # n'y voyait aucune erreur -> l'entree quittait la galerie pendant que le fichier restait sur le
+    # disque. Un basename n'est pas un confinement ; le vrai confinement, c'est de verifier que la
+    # cible retombe SOUS output/ -- ce que fait le test ci-dessous, et qui couvre aussi les "..".
+    safe = os.path.basename(filename or "")
+    if not safe:
+        return {"error": "filename vide"}
+    sub = (subfolder or "").replace("\\", "/").strip("/")
+    root = os.path.normpath(OUT_ROOT)
+    target = os.path.normpath(os.path.join(root, sub, safe))
+    if not target.startswith(root + os.sep):
+        return {"error": "chemin hors output"}
+    if not os.path.isfile(target):
+        return {"ok": True, "missing": True}
+    try:
+        os.remove(target)
+        # v6.03 - un morceau supprime ne doit pas laisser son dossier derriere lui.
+        # UNIQUEMENT sous gs/audio/<dossier-du-morceau> : la, un dossier = un morceau, et
+        # ce qui reste (score.abc, plan.json, abc_tokens.npy) n'a plus d'objet sans l'audio.
+        # Ailleurs (images, videos) les dossiers sont PARTAGES -> on n'y touche pas.
+        vide = None
+        parts = sub.split("/")
+        if len(parts) == 3 and parts[0] == "gs" and parts[1] == "audio" and parts[2] not in ("", "_previews"):
+            dossier = os.path.dirname(target)
+            try:
+                restants = os.listdir(dossier)
+                # il ne doit plus y avoir un seul media : les artefacts du plan ne comptent pas
+                medias = [f for f in restants
+                          if os.path.splitext(f)[1].lower() in (".flac", ".wav", ".mp3", ".ogg", ".m4a")]
+                if not medias:
+                    shutil.rmtree(dossier)
+                    vide = parts[2]
+            except Exception as ex2:
+                print("[delete] dossier non nettoye (%s) : %s" % (sub, str(ex2)[:120]), flush=True)
+        r = {"ok": True, "deleted": safe}
+        if vide:
+            r["dossier_retire"] = vide
+        return r
+    except Exception as ex:
+        return {"error": str(ex)}
