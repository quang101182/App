+    except urllib.error.HTTPError as e:
+        raise RuntimeError("Gemini HTTP %s : %s" % (e.code, e.read().decode("utf-8", "replace")[:200]))
+    cout_enregistre("gemini", ESPRIT_MODELE, d.get("usageMetadata"), "ecoute morceau")   # v6.29
+    txt = "".join(p.get("text", "") for p in (d.get("candidates") or [{}])[0].get("content", {}).get("parts", []))
+    if not txt.strip():
