+def job_long_lance(nom, fn, data):
+    jid = "%s-%d-%04d" % (nom, int(time.time()), random.randint(0, 9999))
+    with _JOBS_VERROU:
+        for k in [k for k, v in _JOBS_LONGS.items() if time.time() - v["t0"] > JOB_LONG_GARDE]:
+            _JOBS_LONGS.pop(k, None)
+        _JOBS_LONGS[jid] = {"etat": "en_cours", "t0": time.time(), "nom": nom, "res": None, "erreur": None}
+
+    def fil():
+        try:
+            r = fn(data)
+            with _JOBS_VERROU:
+                _JOBS_LONGS[jid].update(etat="fini", res=r, fin=time.time())
+        except Exception as ex:
+            with _JOBS_VERROU:
+                _JOBS_LONGS[jid].update(etat="echec", erreur=str(ex)[:300], fin=time.time())
+    threading.Thread(target=fil, daemon=True).start()
+    return {"ok": True, "job_long": jid}
