+        mp3_log("SKIP %s : « %s » existe deja" % (vid, base + ".mp3"))
+        return {"ok": True, "deja": True, "nom": base + ".mp3"}
+    t0, err = time.time(), ""
+    for essai in (1, 2):                               # un 403 YouTube est TRANSITOIRE (music-dl, 18/09)
+        r = subprocess.run(cmd + ["-f", "bestaudio/best", "-x", "--audio-format", "mp3", "--audio-quality", "320K",
