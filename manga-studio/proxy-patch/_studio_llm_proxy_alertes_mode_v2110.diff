+def _mp3_titre_video_propre(t):
+    """v7.51 - le titre d'une video sans ses habillages : [Official...], « Music Video » en fin, chevrons pleine chasse."""
+    t = re.sub(_MP3_SUFFIXES, "", t or "", flags=re.I)
+    t = t.replace("\uff1c", "<").replace("\uff1e", ">")
+    t = re.sub(r"\s*\b(?:official\s+)?(?:music\s+video|lyric\s+video|mv|audio|video)\s*$", "", t, flags=re.I)
+    return t.strip()
