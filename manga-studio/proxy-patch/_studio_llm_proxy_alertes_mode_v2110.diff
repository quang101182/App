+def list_outputs():
+    # Liste les fichiers REELS sous output/ -> reconcilier la galerie (anti-fantome).
+    #
+    # ⚠️ CE QUE CETTE LISTE COMMANDE : Gallery.sync() (front) SUPPRIME de la galerie toute entree
+    # absente d'ici. Un fichier qu'on oublie de lister n'est pas "juste invisible" : il est purge,
+    # et la purge se propage a SQLite puis a l'autre appareil via ContentSync. Donc toute sortie
+    # nouvellement rangee plus profond DOIT etre couverte ici, sous peine de perte silencieuse.
+    #
+    # v5.63 : le scan descendait 1 SEUL niveau. Il voyait output/gs/x.png, mais pas
+    # output/gs/video/x.mp4 -- soit exactement l'endroit ou les videos vont desormais.
+    # ⚠️ VIDEO A REVALIDER : ce chemin video n'a pas pu etre teste (generation video a l'arret).
+    # Quand elle reprendra, verifier qu'un clip frais survit a un Sync sans disparaitre.
+    root = os.path.normpath(OUT_ROOT)
+    files = []
+    dates = {}
+    try:
+        for dirpath, dirnames, filenames in os.walk(root):
+            rel = os.path.relpath(dirpath, root)
+            depth = 0 if rel == "." else rel.count(os.sep) + 1
+            # Elaguer AVANT de descendre : plus economique, et ca evite de parcourir manga/ (des
+            # milliers de fichiers d'un autre projet, sans aucun interet pour la galerie GS).
+            dirnames[:] = ([] if depth >= OUT_SCAN_DEPTH
+                           else [d for d in dirnames if d not in OUT_SCAN_SKIP])
+            prefix = "" if rel == "." else rel.replace(os.sep, "/") + "/"
+            for f in filenames:
+                nom = prefix + f
+                files.append(nom)
+                # v5.88 : la DATE de chaque fichier. Quang, 17/09 : "dans la galerie, c'est dur
+                # de se reperer, a savoir la chronologie des musiques generees". Le client ne
+                # peut pas la deviner : un nom de dossier porte un identifiant technique, pas
+                # une heure. Le serveur, lui, la connait - et elle vaut pour TOUS les appareils,
+                # contrairement a l'historique local qui ne voit que ce qui a ete fait ici.
+                try:
+                    dates[nom] = int(os.path.getmtime(os.path.join(dirpath, f)) * 1000)
+                except Exception:
+                    pass
+    except Exception as e:
+        return {"error": str(e)}
+    # `files` garde EXACTEMENT sa forme : d'autres galeries s'en servent pour reconcilier
+    # (une entree absente d'ici est PURGEE cote client). On ajoute a cote, on ne remplace pas.
+    return {"files": files, "dates": dates}
