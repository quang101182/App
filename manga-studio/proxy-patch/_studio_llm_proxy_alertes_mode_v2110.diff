+def _comfy_torch_mo(base):
+    """Ce qu'UN ComfyUI declare consommer. Windows ne ventile pas la VRAM par
+    process (nvidia-smi rend [N/A] en WDDM) : chaque moteur doit se declarer."""
+    try:
+        with urllib.request.urlopen(base + "/system_stats", timeout=2) as r:
+            j = json.loads(r.read().decode() or "{}")
+        d = (j.get("devices") or [{}])[0]
+        tot = int(d.get("torch_vram_total", 0)); free = int(d.get("torch_vram_free", 0))
+        return max(0, tot - free) // (1024 * 1024)
+    except Exception:
+        return None
+
+
+def vram_split():
+    """Jauge ventilee : le TOTAL fait autorite (nvidia-smi), les moteurs se
+    repartissent a l'interieur, l'ecart non attribue est montre tel quel."""
+    base = vram_info()
+    eng = {}
+    v = _comfy_torch_mo(COMFY)
+    if v:
+        eng["images"] = v
+    v = _comfy_torch_mo(COMFY_LTX)
+    if v:
+        eng["video"] = v
+    y = yue2_get("/vram", timeout=2)
+    if y and y.get("torch_reserved_mo"):
+        eng["musique"] = int(y["torch_reserved_mo"])
+    used = int(base.get("used") or 0)
+    base["engines"] = eng
+    base["unattributed"] = max(0, used - sum(eng.values()))
+    base["busyBy"] = (max(eng, key=eng.get) if eng else None)
+    return base
+
