+def _ace_slug(t, n=48):
+    """Meme forme de nom que le moteur 1 (`slugify(titre)-<6 chiffres>`), et c'est OBLIGATOIRE :
+    tout le proxy retrouve un morceau par les 6 derniers chiffres de son dossier
+    (`origine_du_dossier`, `dossier_du_job`). Un nom d'une autre forme rendrait le morceau
+    orphelin de sa parente et de son score de fidelite."""
+    s = re.sub(r"[^a-z0-9]+", "-", (t or "").lower()).strip("-")[:n]
+    return (s or "creation")
+
