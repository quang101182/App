+def fidelite_stats():
+    """v6.42 - ETAPE 3 : par base (original / demande) et par profil (chante, rap, echantillons, instrumental) :
+    nombre de morceaux, score moyen, et pour CHAQUE critere le taux ok / partiel / ko. Les criteres MESURES sont
+    separes des AVIS (Gemini varie : un meme morceau a oscille de 60 a 100 % le 18/09)."""
+    base = os.path.join(OUT_ROOT, "gs", "audio")
+    groupes = {}
+    try:
+        noms = os.listdir(base)
+    except Exception:
+        noms = []
+    for n in noms:
+        f = os.path.join(base, n, "fidelite.json")
+        if n.startswith("_") or not os.path.isfile(f):
+            continue
+        try:
+            with io.open(f, encoding="utf-8") as fh:
+                r = json.load(fh) or {}
+        except Exception:
+            continue
+        if r.get("score") is None:
+            continue
+        cle = "%s|%s" % (r.get("base") or "original", r.get("profil") or "?")
+        g = groupes.setdefault(cle, {"base": r.get("base") or "original", "profil": r.get("profil"), "n": 0, "somme": 0, "criteres": {}})
+        g["n"] += 1
+        g["somme"] += r["score"]
+        for c in r.get("criteres") or []:
+            if c.get("etat") == "non_mesure":
+                continue
+            k = c.get("cle")
+            if k == "energie":
+                nat = "mesure" if "mesur" in str(c.get("detail") or "") else "avis"
+            else:
+                nat = "mesure" if k in FIDELITE_MESURES else "avis"
+            s = g["criteres"].setdefault(k, {"nom": c.get("nom"), "nature": nat, "ok": 0, "partiel": 0, "ko": 0})
+            s[c["etat"]] = s.get(c["etat"], 0) + 1
+    out = []
+    for g in groupes.values():
+        g["moyenne"] = round(g.pop("somme") / g["n"])
+        out.append(g)
+    out.sort(key=lambda g: (g["base"], -g["n"]))
+    return {"groupes": out, "total": sum(g["n"] for g in out)}
+
