+def _comfy_free(base):
+    try:
+        rq = urllib.request.Request(base + "/free", data=json.dumps({"unload_models": True, "free_memory": True}).encode(),
+                                    headers={"Content-Type": "application/json"})
+        with urllib.request.urlopen(rq, timeout=15) as r:
+            r.read()
+        return True
+    except Exception:
+        return False
