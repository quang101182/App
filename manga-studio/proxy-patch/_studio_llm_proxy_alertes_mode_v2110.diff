+# ═══ v5.64 — VERROU GPU : une seule génération à la fois sur la carte ═════════════════════
+# Décision : les DEUX moteurs restent allumés (basculer en tuant/relançant coûte +25 % sur la
+# 1re génération), mais UNE SEULE génère. Validé par un vote 3 LLM (3/3 pour cette option).
+# ⚠️ Le piège signalé par les 3 voix : ne PAS se baser sur la VRAM mesurée (elle fluctue ->
+# race condition). La source de vérité est la FILE de chaque ComfyUI, qui est un état franc.
+def comfy_busy_ltx():
+    """True si le moteur VIDÉO a quelque chose en cours ou en attente."""
+    try:
+        with urllib.request.urlopen(COMFY_LTX + "/queue", timeout=2.5) as r:
+            q = json.loads(r.read().decode("utf-8", "replace"))
+        return bool(q.get("queue_running")) or bool(q.get("queue_pending"))
+    except Exception:
+        return False   # injoignable = pas occupé (ne jamais bloquer sur une sonde muette)
