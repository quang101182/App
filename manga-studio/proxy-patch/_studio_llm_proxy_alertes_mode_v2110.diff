+def origine_heritee(dossier):
+    """v7.13 (Quang, 21/09) - « dans la playlist on a perdu une info : l'origine de la musique […] il
+    serait bien d'indiquer quelle musique ». Une copie ENRICHIE (lien `enrichi`) et le jumeau ⚖️ du
+    moteur 2 (lien `moteur`) ne sont enregistres qu'avec leur `parent`, SANS type : 36 entrees sur 113
+    le 21/09 -> case origine vide, alors que leur original affiche « Reprise · USHER — Yeah! ».
+    Ils ont par construction la MEME origine que leur parent : on la remonte (3 niveaux au plus),
+    a la lecture, sans reecrire le registre. Le `parent`/`lien` de la copie reste le sien."""
+    og = origine_du_dossier(dossier)
+    if not og or og.get("type"):
+        return og
+    cur, vus = og, set()
+    for _ in range(3):
+        par = os.path.basename(str(cur.get("parent") or ""))
+        if not par or par in vus:
+            break
+        vus.add(par)
+        cur = origine_du_dossier(par)
+        if not cur:
+            break
+        if cur.get("type"):
+            return dict(og, **{k: cur.get(k) for k in ("type", "ref", "envie", "ref_desc", "reprise")})
+    return og
