+def runpod_balance(force=False):
+    """Solde RunPod (credits restants) via GraphQL read-only. clientBalance + currentSpendPerHr.
+    Cle stockee cote serveur (.runpod_token), jamais dans le HTML. Cache 20s."""
+    token = get_runpod_token()
+    if not token:
+        return {"error": "no_token", "message": "Cle API RunPod absente (.runpod_token)."}
+    now = time.time()
+    if not force and _RP_CACHE["data"] is not None and (now - _RP_CACHE["ts"]) < 20:
+        return dict(_RP_CACHE["data"], cached=True)
+    body = json.dumps({"query": "query { myself { clientBalance currentSpendPerHr } }"}).encode()
+    # User-Agent navigateur obligatoire : api.runpod.io est derriere Cloudflare -> l'UA par defaut
+    # de urllib (Python-urllib) est bloque par le WAF (HTTP 403 "error code: 1010").
+    req = urllib.request.Request("https://api.runpod.io/graphql", data=body, method="POST",
+                                 headers={"Authorization": "Bearer " + token, "Content-Type": "application/json",
+                                          "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) generate-studio/1.0"})
+    try:
+        with urllib.request.urlopen(req, timeout=15) as r:
+            d = json.load(r)
