+def mastering_fait(dossier):
+    """Vrai si la suite (Telegram, analyse) peut passer : mastering fait / annule / abandonne, desactive, ou
+    son ecrit depuis plus de 10 min (on ne bloque jamais la chaine)."""
+    if not MASTERING_ACTIF or os.path.isfile(os.path.join(dossier, "mastering.json")):
+        return True
+    try:
+        son = os.path.join(dossier, "audio.flac")
+        return (not os.path.isfile(son)) or time.time() - os.path.getmtime(son) > MASTER_ATTENTE_MAX
