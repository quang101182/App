+def _reprise_suit(etat):
+    """Lit la sortie de la chaine depuis `etat["pos"]` jusqu'a sa fin (processus mort), met _REPRISE a jour."""
+    pid, pos, reste = etat["pid"], int(etat.get("pos") or 0), ""
+    try:
+        while True:
+            vivant = _pid_vivant(pid)                                  # AVANT la lecture : rien de perdu a la fin
+            try:
+                with io.open(etat["sortie"], "rb") as f:
+                    f.seek(pos)
+                    bloc = f.read()
+            except OSError:
+                bloc = b""
+            if bloc:
+                pos += len(bloc)
+                lignes = (reste + bloc.decode("utf-8", errors="replace")).split("\n")
+                reste = lignes.pop()
+                for l in lignes:
+                    _reprise_ligne(l)
+                _reprise_note(dict(etat, pos=pos - len(reste.encode("utf-8"))))
+            if not vivant:
+                if reste:
+                    _reprise_ligne(reste)
+                break
+            time.sleep(1)
+        if not _REPRISE.get("job") and not _REPRISE.get("erreur"):
+            _REPRISE["erreur"] = "la chaine s'est arretee sans lancer de generation"
+    except Exception as ex:
+        _REPRISE["erreur"] = str(ex)[:300]
+    _REPRISE["en_cours"] = False
+    _REPRISE["fin"] = time.strftime("%Y-%m-%d %H:%M:%S")
+    try:
+        os.remove(REPRISE_EN_COURS)
