+def moteurs_des_morceaux(_cache={"t": 0, "d": {}}):
+    """Ce qui a fait chaque morceau : "1" (moteur 1 seul) ou "1+2" (enrichi par le moteur 2).
+    Lu dans les marqueurs `enrichissement.json`. Un marqueur en ECHEC ou en REFUS ne compte PAS :
+    mieux vaut aucune pastille qu'une pastille qui ment. Cache 10 s (la playlist se rafraichit
+    a chaque fin de generation depuis la v6.86)."""
+    if time.time() - _cache["t"] < 10:
+        return _cache["d"]
+    base = os.path.join(OUT_ROOT, "gs", "audio")
+    d = {}
+    try:
+        noms = os.listdir(base)
+    except Exception:
+        noms = []
+    for n in noms:
+        if n.startswith("_"):
+            continue
+        mk = os.path.join(base, n, "enrichissement.json")
+        if not os.path.isfile(mk):
+            # v7.10 (Quang, 21/09) - « chaque musique devrait afficher le chiffre indiquant le moteur
+            # qui l'a generee ». 32 morceaux sur 46 n'avaient AUCUNE pastille : tous ceux d'avant le
+            # systeme d'etiquettes (v6.99). Or on SAIT qui les a faits : le moteur 2 laisse une
+            # signature explicite dans son `plan.json` (`"moteur": 2`, `ace_cree`) ; tout le reste a
+            # ete compose par le moteur 1 (seul moteur avant le 20/09). On le deduit donc — mais
+            # seulement pour un morceau NE (`request.json` present) : un dossier en cours de calcul
+            # ne recoit pas d'etiquette qu'il pourrait dementir.
+            dn = os.path.join(base, n)
+            if not os.path.isfile(os.path.join(dn, "request.json")):
+                continue
+            try:
+                with io.open(os.path.join(dn, "plan.json"), encoding="utf-8") as f:
+                    pl = json.load(f) or {}
+            except Exception:
+                pl = {}
+            d[n] = {"moteurs": "2" if str(pl.get("moteur")) == "2" else "1", "ou": "local",
+                    "action": "deduit", "brut": None, "contraint": False, "secondes": None}
+            continue
+        try:
+            with io.open(mk, encoding="utf-8") as f:
+                m = json.load(f) or {}
+        except Exception:
+            continue
+        # v7.01 (21/09) - ⛔ ON NE GARDAIT QUE `action == "enrichi"`, donc la playlist ne pouvait
+        # afficher QUE la pastille ①+②. Les etiquettes du moteur 1 (`source` en ✨, `compose` en ⚖️)
+        # et du moteur 2 seul (`cree`) existaient bien SUR LE DISQUE depuis la v6.99 — elles
+        # n'arrivaient simplement jamais a l'ecran. Mesure du 21/09 : 14 morceaux « 1+2 » et
+        # 32 « (aucun) », pas un seul ① sur 46. Quang : « je ne vois pas le 1 plus 2, donc je me
+        # demande quelle musique c'est ». Le banc v6.99 verifiait l'ECRITURE des marqueurs, pas ce
+        # qui arrive au destinataire — c'est toute la difference.
+        if m.get("action") == "echec" or not m.get("moteurs"):
+            continue
+        d[n] = {"moteurs": m.get("moteurs"), "ou": m.get("ou") or "local",
+                "action": m.get("action"),
+                "brut": m.get("brut"), "contraint": bool(m.get("contraint")),
+                "secondes": m.get("secondes")}
+    _cache["t"], _cache["d"] = time.time(), d
+    return d
+
