+def ref_compris(f):
+    a, t = f.get("artiste") or {}, f.get("titre") or {}
+    bits = []
+    if a.get("nom"):
+        qui = {"Person": {"male": "chanteur", "female": "chanteuse"}.get(a.get("sexe"), "artiste"),
+               "Group": "groupe"}.get(a.get("type"), "artiste")
+        bits.append("%s (%s%s)" % (a["nom"], qui, (", " + a["pays"]) if a.get("pays") else ""))
+    if t.get("titre"):
+        an = (t.get("date") or "")[:4]
+        bits.append("« %s »%s%s" % (t["titre"], (" (" + an + ")") if an else "",
+                                    " — son représentatif" if t.get("representatif") else ""))
+    return " — ".join(bits)
