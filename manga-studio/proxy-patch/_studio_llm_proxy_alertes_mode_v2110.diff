+_MB_VERROU = threading.Lock()
+REF_VERSIONS = re.compile(r"\b(remix|live|instrumental|karaoke|karaok[eé]|acoustic|acoustique|cover|reprise|"
+                          r"version|edit|sped ?up|slowed|8d|nightcore|tribute|no rap|a cappella|acapella|"
