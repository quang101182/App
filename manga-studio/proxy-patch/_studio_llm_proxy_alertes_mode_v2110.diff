+                                             "t": time.time()}
+        c["alias"][cle_alias] = {"artiste": (art or {}).get("mbid"), "titre": (titre or {}).get("id"), "t": time.time()}
+        ref_cache_ecrit(c)
+    ref_log("FICHE %s -> %s | alertes : %s" % (ref, fiche["compris"], fiche["alertes"] or "aucune"))
+    return {"etat": "sur", "fiche": fiche}
