+        if "clientBalance" not in me:
+            return {"error": "api", "message": (d.get("errors") or [{"message": "reponse inattendue"}])[0].get("message")}
+        out = {"ok": True, "balance": me.get("clientBalance"), "spendPerHr": me.get("currentSpendPerHr")}
+        _RP_CACHE["ts"] = now; _RP_CACHE["data"] = out
+        return out
+    except urllib.error.HTTPError as e:
