+def mastering_a_faire():
+    base = os.path.join(OUT_ROOT, "gs", "audio")
+    out = []
+    try:
+        noms = os.listdir(base)
+    except Exception:
+        return out
+    for n in noms:
+        d = os.path.join(base, n)
+        son, mj = os.path.join(d, "audio.flac"), os.path.join(d, "mastering.json")
+        if n.startswith("_") or not os.path.isfile(son) or not os.path.isfile(os.path.join(d, "request.json")):
+            continue                                  # request.json est ecrit APRES le son : son absent = pas fini
+        if not enrich_fait(d):
+            continue                              # v6.92 : le moteur 2 passe AVANT le mastering
+        if not sans_voix_fait(d):
+            continue                              # v7.54 : la voix est retiree AVANT le mastering (et donc avant tout le reste)
+        # v7.01 (21/09) - UNE COPIE ENRICHIE NE SE MASTERISE PAS DEUX FOIS.
+        # Le morceau du moteur 1 est deja masterise ; c'est LUI qu'on envoie au moteur 2 (comme
+        # dans l'echantillon que Quang a valide le 20/09 au matin). Repasser la copie au mastering
+        # empilait un 2e gain + EQ + limiteur sur un son deja traite : mesure sur `numb-reprise`,
+        # la part de batterie passait de -4,8 points (sortie du moteur) a -7,4 apres ce 2e passage,
+        # soit UN TIERS de l'ecart restant. Quang, 21/09 : « ce n'est pas du tout le rendu valide ».
+        # On ne masterise donc la copie que si sa SOURCE ne l'etait pas.
+        try:
+            _e = os.path.join(d, "enrichissement.json")
+            if os.path.isfile(_e):
+                with io.open(_e, encoding="utf-8") as f:
+                    _j = json.load(f) or {}
+                if _j.get("action") == "enrichi" and _j.get("source"):
+                    _src = os.path.join(OUT_ROOT, *_j["source"].split("/"))
+                    if os.path.isfile(os.path.join(_src, "mastering.json")):
+                        continue                  # la source etait masterisee : la copie l'herite
+        except Exception:
+            pass
+        try:
+            if time.time() - os.path.getmtime(os.path.join(d, "request.json")) < 5:
+                continue
+            if os.path.isfile(mj):
+                with io.open(mj, encoding="utf-8") as f:
+                    m = json.load(f) or {}
+                if m.get("action") != "echec" or m.get("tentatives", 1) >= 3 or time.time() - os.path.getmtime(mj) < 600:
+                    continue
+            out.append(d)
+        except Exception:
+            continue
+    return sorted(out, key=lambda x: -os.path.getmtime(os.path.join(x, "request.json")))   # les nouveaux d'abord
