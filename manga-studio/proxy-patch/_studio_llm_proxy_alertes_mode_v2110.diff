+def mp3_chercher(data):
+    """POST /mp3_chercher {artiste, titre, duree} (une fiche) ou {texte} (recherche libre, resolue en fiche si
+    possible) -> {fiche, deja, candidats:[{id, titre, duree, chaine, conforme, raison}], choisi}."""
+    t0 = time.time()
+    data = data or {}
+    artiste, titre, duree = str(data.get("artiste") or "").strip(), str(data.get("titre") or "").strip(), data.get("duree")
+    texte = str(data.get("texte") or "").strip()
+    vid_lien = _mp3_id_lien(texte) if not titre else None
+    if vid_lien:                                       # v7.48 : un lien YouTube colle = LA video voulue, pas de recherche
+        return _mp3_par_lien(vid_lien, t0)
+    verifiee = bool(titre and duree)
+    if not titre and texte:                            # recherche libre : la fiche verifiee (v6.32) si elle existe
+        try:
+            rr = ref_resoudre({"texte": texte})
+            for x in rr.get("resultats") or []:
+                t = ((x or {}).get("fiche") or {}).get("titre") or {}
+                if x.get("etat") == "sur" and t.get("titre") and not t.get("representatif"):
+                    artiste, titre, duree, verifiee = t.get("artiste") or "", t["titre"], t.get("duree"), True
+                    break
+        except Exception as ex:
+            mp3_log("fiche impossible pour « %s » : %s" % (texte, str(ex)[:120]))
+    fiche = {"artiste": artiste, "titre": titre, "duree": duree, "verifiee": verifiee} if titre else None
+    deja = _mp3_deja(artiste, titre) if titre else None
+    cmd = _ytdlp()
+    if not cmd:
+        return {"ok": False, "erreur": "yt-dlp introuvable sur le PC", "fiche": fiche, "deja": deja, "candidats": []}
+    q = ("%s %s" % (artiste, re.sub(r"\((?:feat|featuring|ft)\b[^)]*\)", "", titre, flags=re.I))).strip() if titre else texte
+    if not q:
+        return {"ok": False, "erreur": "rien a chercher", "candidats": []}
+    r = subprocess.run(cmd + ["--flat-playlist", "--encoding", "utf-8", "--no-warnings", "--print",
+                              "%(id)s\t%(duration)s\t%(channel)s\t%(title)s", "--", "ytsearch8:" + q],
+                       capture_output=True, text=True, encoding="utf-8", errors="replace", timeout=90,
+                       creationflags=getattr(subprocess, "CREATE_NO_WINDOW", 0))
+    cands = []
+    exclus_fiche = re.findall(_MP3_EXCLUS, titre.lower()) if titre else []
+    for ligne in (r.stdout or "").splitlines():
+        p = ligne.split("\t")
+        if len(p) < 4 or not re.fullmatch(r"[A-Za-z0-9_-]{11}", p[0]):
+            continue
+        try:
+            d = float(p[1])
+        except Exception:
+            d = None
+        c = {"id": p[0], "duree": round(d) if d else None, "chaine": p[2] if p[2] != "NA" else "", "titre": p[3]}
+        m = re.search(_MP3_EXCLUS, p[3].lower())
+        if m and m.group(0) not in exclus_fiche:
+            c["conforme"], c["raison"] = False, "version « %s »" % m.group(0).strip()
+        elif d is None:
+            c["conforme"], c["raison"] = False, "duree inconnue"
+        elif duree:
+            ecart = abs(d - float(duree))
+            c["ecart"] = round(ecart)
+            c["conforme"] = ecart <= MP3_TOL_S
+            c["raison"] = "" if c["conforme"] else "%+d s par rapport a la fiche" % round(d - float(duree))
+        else:
+            c["conforme"] = 60 <= d <= 900
+            c["raison"] = "" if c["conforme"] else "duree hors 1-15 min"
+        cands.append(c)
+    # la chaine officielle « - Topic » (audio du disque, duree exacte) d'abord, puis le plus petit ecart
+    cands.sort(key=lambda c: (not c["conforme"], not c["chaine"].endswith(" - Topic"), c.get("ecart", 0)))
+    choisi = next((c for c in cands if c["conforme"]), None)
+    mp3_log("RECHERCHE « %s »%s -> %d candidats, %d conformes, choisi %s%s (%.1f s)" % (
+        q, (" (fiche %s s)" % duree) if duree else " (sans fiche)", len(cands), sum(1 for c in cands if c["conforme"]),
+        ("%s « %s » %s s" % (choisi["id"], choisi["titre"], choisi["duree"])) if choisi else "AUCUN",
+        (" - deja sur le PC : " + deja) if deja else "", time.time() - t0))
+    return {"ok": True, "fiche": fiche, "deja": deja, "candidats": cands[:8], "choisi": choisi,
+            "requete": q, "s": round(time.time() - t0, 1)}
