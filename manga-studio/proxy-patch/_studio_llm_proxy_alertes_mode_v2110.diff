+def origine_du_dossier(dossier, _cache={}):
+    """Le dossier « titre-973804 » porte les 6 premiers chiffres de son job."""
+    m = re.search(r"-(\d{6})$", str(dossier or ""))
+    if not m:
+        return None
+    try:
+        st = os.stat(ORIGINES_JSON)
