+def audio_meta(chemins):
+    """Duree + paroles + style pour une liste de morceaux de gs/audio.
+
+    `chemins` sont ceux que /outputs_list a donnes ("gs/audio/<dossier>/audio.flac").
+    Reponse : {chemin: {dur, lyrics, style, cot, seed}}.
+    Tout est best-effort : un morceau illisible rend simplement moins d'informations,
+    jamais une erreur - la galerie doit s'afficher meme si ffprobe manque.
+    """
+    if not isinstance(chemins, list):
+        return {"error": "chemins attendus"}
+    root = os.path.normpath(OUT_ROOT)
+    with _meta_lock:
+        cache = _meta_charge()
+    out, neuf = {}, False
+    for rel in chemins[:400]:
+        rel = str(rel or "").replace("\\", "/").strip("/")
+        if not rel.lower().startswith("gs/audio/"):
+            continue
+        cible = os.path.normpath(os.path.join(root, rel))
+        if not cible.startswith(root + os.sep) or not os.path.isfile(cible):
+            continue
+        st = os.stat(cible)
+        cle = "%s|%d|%d" % (rel, st.st_size, int(st.st_mtime))
+        info = cache.get(cle)
+        if info is None:
+            info = {}
+            # 1. la duree, par ffprobe
+            try:
+                r = subprocess.run(["ffprobe", "-v", "error", "-show_entries",
+                                    "format=duration", "-of", "csv=p=0", cible],
+                                   capture_output=True, text=True, timeout=20)
+                info["dur"] = round(float((r.stdout or "0").strip() or 0), 1)
+            except Exception:
+                info["dur"] = 0
+            # 2. les paroles et le style, deja ecrits par le moteur a cote du son
+            try:
+                pj = os.path.join(os.path.dirname(cible), "plan.json")
+                if os.path.isfile(pj):
+                    with io.open(pj, encoding="utf-8") as f:
+                        req = (json.load(f) or {}).get("request") or {}
+                    info["lyrics"] = str(req.get("lyrics") or "")[:4000]
+                    info["style"] = str(req.get("style") or "")[:400]
+                    info["cot"] = req.get("cot")
+                    info["seed"] = req.get("seed")
+            except Exception:
+                pass
+            cache[cle] = info
+            neuf = True
+        # v6.25 - le verdict d'analyse, lu HORS cache : le cache est cle par la taille et la
+        # date du SON, qui ne changent pas quand l'analyse arrive (elle ne serait jamais relue).
+        info = dict(info)
+        try:
+            aj = os.path.join(os.path.dirname(cible), "analyse.json")
+            if os.path.isfile(aj):
+                with io.open(aj, encoding="utf-8") as f:
+                    a = json.load(f) or {}
+                m = a.get("mesure") or {}
+                info["analyse"] = {"ok": a.get("ok"), "problemes": a.get("problemes") or [],
+                                   "quand": a.get("quand"), "erreur": a.get("erreur"),
+                                   "voix": m.get("voix_presente"), "langue": m.get("langue"),
+                                   "paroles": m.get("paroles_retrouvees")}
+        except Exception:
+            pass
+        try:                                           # v6.36h : d'ou vient ce morceau
+            og = origine_heritee(os.path.basename(os.path.dirname(cible)))            # v7.13 : herite du parent
+            if og:
+                info["origine"] = {k: og.get(k) for k in ("type", "ref", "envie", "ref_desc")}   # v6.39 : ref_desc pour ↻
+                if og.get("reprise"):
+                    info["origine"]["reprise"] = True                                        # v6.57
+                if og.get("parent"):                                                         # v6.55 : variante de
+                    info["parent"] = {"sub": og.get("parent"), "lien": og.get("lien") or "reglages"}
+            rj_ = os.path.join(os.path.dirname(cible), "richesse.json")             # v6.60
+            if os.path.isfile(rj_):
+                with io.open(rj_, encoding="utf-8") as f:
+                    r_ = json.load(f) or {}
+                if not r_.get("erreur") and r_.get("taille") == os.path.getsize(cible):
+                    info["richesse"] = {k: r_.get(k) for k in ("equilibre", "autres_part", "largeur")}
+            mj_ = os.path.join(os.path.dirname(cible), "mastering.json")            # v6.58
+            if os.path.isfile(mj_):
+                with io.open(mj_, encoding="utf-8") as f:
+                    m_ = json.load(f) or {}
+                info["mastering"] = {k: m_.get(k) for k in ("action", "entree_lufs", "cible_lufs", "quand")}
+                info["mastering"]["revenir"] = os.path.isfile(os.path.join(MASTER_SAUVE, os.path.basename(os.path.dirname(cible)), "audio.flac"))
+            # v6.55 - les REGLAGES reellement envoyes au moteur (request.json, ecrit par lui) : la base du
+            # tableau de differences entre variantes. Lu hors cache, comme l'analyse. Jamais deduit.
+            rj = os.path.join(os.path.dirname(cible), "request.json")
+            if os.path.isfile(rj):
+                with io.open(rj, encoding="utf-8") as f:
+                    rq = json.load(f) or {}
+                _abc = str(rq.get("abc") or "")
+                info["reglages"] = {"seed": rq.get("seed"), "cfg": rq.get("cfg_scale"), "cot": rq.get("cot"),
+                                    "abc": bool(_abc.strip()),
+                                    "abc_sig": hashlib.sha256(_abc.encode("utf-8")).hexdigest()[:12] if _abc.strip() else None,
+                                    "style": str(rq.get("style") or "")[:400]}
+            fj = os.path.join(os.path.dirname(cible), "fidelite.json")   # v6.38 : son score
+            if os.path.isfile(fj):
+                with io.open(fj, encoding="utf-8") as f:
+                    fd = json.load(f) or {}
+                info["fidelite"] = {"score": fd.get("score"), "profil": fd.get("profil"), "erreur": fd.get("erreur"),
+                                    "genres": ((fd.get("obtenu") or {}).get("genres") or [])[:6],   # v6.66 : fidelite genres (filtre)
+                                    "base": fd.get("base") or "original",          # v6.42c : a l'original / a ta demande
+                                    "non_verifie": fd.get("non_verifie") or [],
+                                    "batterie": {k: (fd.get("batterie") or {}).get(k) for k in
+                                                 ("action", "gain_db", "rapport_avant", "rapport_apres")}
+                                                if (fd.get("batterie") or {}).get("action") == "remontee" else None,   # v6.46
+                                    "criteres": [{"nom": c.get("nom"), "etat": c.get("etat"), "detail": c.get("detail"),
+                                                  "hors_profil": c.get("hors_profil")} for c in (fd.get("criteres") or [])]}
+        except Exception:
+            pass
+        out[rel] = info
+    if neuf:
+        with _meta_lock:
+            # on ne garde que les entrees encore utiles : un morceau supprime ne doit pas
+            # faire grossir le cache indefiniment
+            if len(cache) > 800:
+                cache = {k: v for k, v in list(cache.items())[-600:]}
+            _meta_sauve(cache)
+    return {"ok": True, "meta": out}
