+def occupe_par_autre(pour):
+    """Le nom du moteur (autre que `pour`) qui GENERE en ce moment, sinon None."""
+    g = gpu_state()
+    for m in ("images", "video", "musique"):
+        if m != pour and g.get(m):
+            return m
+    return None
