+        try:
+            subprocess.run(["taskkill", "/F", "/T", "/PID", str(vieux)], capture_output=True,
+                           creationflags=(0x08000000 if os.name == "nt" else 0))
+            ace_log("port %d tenu par le PID %s qui ne repondait plus : tue" % (ACE_PORT, vieux))
+            time.sleep(2)
+        except Exception:
