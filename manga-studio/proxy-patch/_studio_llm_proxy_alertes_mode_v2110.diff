+                break
+            except PermissionError:
+                if _essai == 11:
+                    return {"error": "Windows garde un fichier de la série ouvert (lecture des images, antivirus) : "
+                                     "rien n'a été changé, réessaie dans quelques secondes."}
+                time.sleep(0.5)
