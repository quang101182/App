+# ---------------------------------------------------------------- v6.95 : LE RENFORT EN LIGNE
+# L'identifiant de l'endpoint serverless vit dans un fichier a cote du secret du studio, jamais dans
+# le code ni dans le HTML. Absent = pas de cloud du tout : le local reste seul, sans rien casser.
+ACE_CLOUD_ID_FILE = os.path.join(os.path.dirname(os.path.abspath(__file__)), ".acestep_endpoint")
+# 1800 s : le 20/09, 900 s ont fait abandonner un travail qui tournait encore — et l'abandon seul
+# ne l'arretait pas. Le delai est desormais large ET suivi d'une ANNULATION explicite.
+ACE_CLOUD_TIMEOUT = 1800         # s : au-dela on abandonne ET on annule cote RunPod
+ACE_CLOUD_PLAFOND_MOIS = 5.0     # $ : plafond DUR de depense mensuelle sur ce renfort
+# MESURE DU 20/09 : le serverless n'est PAS facture au tarif d'un pod a l'heure. Observe en direct
+# sur AMPERE_24 : **0,69 $/h** (0,00019 $/s), contre 0,16 $/h pour le meme GPU en pod. Mettre le
+# tarif des pods ici faisait sous-estimer le journal d'un facteur 4.
+#
+# ⛔ CORRIGE LE 20/09 AU SOIR, ET C'EST LE DEFAUT LE PLUS GRAVE TROUVE CE JOUR-LA.
+# 0,69 $/h etait le tarif d'UNE carte (AMPERE_24). Mais l'endpoint choisit librement dans ses pools,
+# et rien ne garantit qu'il prenne la moins chere : le premier enrichissement reel est parti sur une
+# carte facturee **3,49 $/h**, soit 5 fois le tarif suppose. Consequence directe : un morceau annonce
+# a 0,0711 $ au journal en a coute **0,4236 $** en vrai, et le plafond mensuel de 5 $ aurait ete
+# franchi cinq fois avant que l'app ne s'en apercoive. C'est exactement la depense silencieuse que
+# Quang a interdite deux fois.
+#
+# La regle desormais : ce tarif est un MAJORANT du pool autorise, jamais une moyenne. Les pools sont
+# restreints aux cartes 48 Go bon marche (A40 0,49 · RTX 6000 Ada 0,84 · L40 · L40S 1,09 $/h) ;
+# 1,20 laisse une marge au-dessus de la plus chere des quatre. ⚠ TOUTE ouverture des pools a une
+# carte plus chere DOIT remonter ce nombre dans le meme geste, sinon le garde-fou re-ment.
+ACE_CLOUD_TARIF_H = 1.20         # $/h — MAJORANT du pool autorise (cf. le bloc ci-dessus)
+ACE_CLOUD_DEBIT_ENVOI = "192k"   # debit de depart pour l'envoi (voir la degressivite dans enrich_cloud)
+ACE_CLOUD_ENVOI_MAX = 9_000_000  # octets de base64 : la limite RunPod est 10 Mo, on garde une marge
+
+
+def ace_cloud_id():
+    try:
+        with io.open(ACE_CLOUD_ID_FILE, encoding="utf-8") as f:
+            return f.read().strip()
+    except Exception:
+        return ""
+
+
+def ace_cloud_depense_mois():
+    """Ce que le renfort a coute depuis le 1er du mois, d'apres le journal de depense deja en place."""
+    # ⚠ Dans ce journal, `ts` est en MILLISECONDES (format pose en v5.50) : comparer a des secondes
+    # rendrait toujours « depuis le debut du mois », donc un plafond qui ne se remet jamais a zero.
+    total, debut = 0.0, time.mktime(time.strptime(time.strftime("%Y-%m-01"), "%Y-%m-%d")) * 1000
+    try:
+        with io.open(SPEND_LOG_FILE, encoding="utf-8") as f:
+            for ligne in f:
+                try:
+                    e = json.loads(ligne)
+                except Exception:
+                    continue
+                if e.get("kind") == "acestep" and (e.get("ts") or 0) >= debut:
+                    total += float(e.get("costUsd") or 0)
+    except Exception:
+        pass
+    return round(total, 4)
+
+
+def _ace_spend(cout, secondes):
+    """Une ligne dans le journal de depense EXISTANT (meme format, donc visible dans le popover 💰).
+    `_spend_log` ne convient pas ici : elle exige un identifiant de pod, et en serverless il n'y a
+    pas de pod — c'est justement ce qui garantit qu'on ne paie rien a vide."""
+    rec = {"ts": int(time.time() * 1000), "iso": time.strftime("%Y-%m-%dT%H:%M:%S"),
+           "evt": "stop", "kind": "acestep", "podId": "serverless",
+           "durationS": int(secondes or 0), "rateUsdHr": ACE_CLOUD_TARIF_H, "costUsd": cout}
+    try:
+        with io.open(SPEND_LOG_FILE, "a", encoding="utf-8") as fh:
+            fh.write(json.dumps(rec, ensure_ascii=False) + "\n")
+    except Exception as ex:
+        ace_log("journal de depense non ecrit : %s" % str(ex)[:120])
+
+
+def ace_cloud_dispo():
+    """Trois conditions, dans cet ordre : un endpoint configure, une cle RunPod, et le plafond pas atteint."""
+    if not ace_cloud_id():
+        return False, "aucun endpoint en ligne configure"
+    if not (get_runpod_write_token() or get_runpod_token()):
+        return False, "cle RunPod absente"
+    if not get_runpod_write_token():
+        return False, "seule la cle RunPod en lecture est presente (elle ne peut pas lancer de travail)"
+    d = ace_cloud_depense_mois()
+    if d >= ACE_CLOUD_PLAFOND_MOIS:
+        return False, "plafond mensuel atteint (%.2f $ sur %.2f $)" % (d, ACE_CLOUD_PLAFOND_MOIS)
+    return True, ""
+
+
+def _ace_mp3(src, debit=None):
+    """Le payload ne peut pas porter un FLAC de 40 Mo : on envoie du MP3. La source sert de canevas
+    au moteur 2, pas de master — 192 kbit/s suffit, et c'est ce qui tient dans la limite."""
+    dst = os.path.join(tempfile.gettempdir(), "gs_cloud_%d.mp3" % int(time.time()))
+    subprocess.run(["ffmpeg", "-y", "-loglevel", "error", "-i", src, "-b:a",
+                    debit or ACE_CLOUD_DEBIT_ENVOI, dst], check=True,
+                   creationflags=getattr(subprocess, "CREATE_NO_WINDOW", 0))
+    return dst
+
+
+def _ace_cloud_annule(eid, jeton, idj, pourquoi=""):
+    """⛔ LE CORRECTIF LE PLUS IMPORTANT DE LA v6.95. Abandonner cote PC n'arrete RIEN cote RunPod :
+    le 20/09, un essai abandonne au bout de 900 s a laisse un worker tourner a 0,69 $/h — la fuite
+    meme que Quang redoute. On annule donc EXPLICITEMENT, et on le journalise."""
+    if not idj:
+        return
+    try:
+        rq = urllib.request.Request("https://api.runpod.ai/v2/%s/cancel/%s" % (eid, idj),
+                                    data=b"{}", method="POST",
+                                    headers={"Authorization": "Bearer " + jeton,
+                                             "Content-Type": "application/json"})
+        with urllib.request.urlopen(rq, timeout=45) as r:
+            ace_log("travail en ligne %s ANNULE (%s) : %s" % (idj, pourquoi, (r.read() or b"")[:120].decode("utf-8", "replace")))
+    except Exception as ex:
+        ace_log("⛔ ANNULATION IMPOSSIBLE du travail %s (%s) : %s — VERIFIER LE COMPTE RUNPOD"
+                % (idj, pourquoi, str(ex)[:150]))
+
+
+def enrich_cloud(dossier, lyrics, style, duree):
+    """Enrichit EN LIGNE. Rend (chemin_du_fichier_rendu, infos) ou (None, infos) en cas d'echec.
+    Ne leve jamais : l'appelant doit pouvoir retomber sur le local."""
+    import base64
+    nom = os.path.basename(dossier)
+    # ⚠ La cle RunPod en LECTURE SEULE passe /health (200) mais refuse /run et /runsync en 403
+    # (« you do not have permission to perform this action ») : lancer un travail exige la cle
+    # d'ECRITURE. Mesure du 20/09 — les deux cles se comportent pareil sur /health, d'ou le piege.
+    eid, jeton = ace_cloud_id(), (get_runpod_write_token() or get_runpod_token())
+    t0 = time.time()
+    # MESURE DU 20/09 : le plus long morceau de la playlist (54,4 Mo en FLAC) fait deja **7,8 Mo**
+    # une fois en MP3 192k + base64, pour une limite RunPod de 10 Mo. La marge est mince : un morceau
+    # plus long casserait l'envoi. On redescend donc le debit tant que ca ne passe pas, et si meme
+    # 96 kbit/s ne suffit pas, on renonce au renfort et on fait en local. Jamais d'appel voue a echouer.
+    envoi, debit = None, None
+    for essai in (ACE_CLOUD_DEBIT_ENVOI, "128k", "96k"):
+        try:
+            mp3 = _ace_mp3(os.path.join(dossier, "audio.flac"), essai)
+            with open(mp3, "rb") as f:
+                envoi = base64.b64encode(f.read()).decode("ascii")
+            os.remove(mp3)
+        except Exception as ex:
+            return None, {"erreur": "preparation de l'envoi impossible : %s" % str(ex)[:160]}
+        debit = essai
+        if len(envoi) <= ACE_CLOUD_ENVOI_MAX:
+            break
+        ace_log("%s : %.1f Mo en %s, trop gros pour l'envoi -> on redescend le debit" % (nom, len(envoi) / 1e6, essai))
+    if not envoi or len(envoi) > ACE_CLOUD_ENVOI_MAX:
+        return None, {"erreur": "morceau trop long pour l'envoi (%.1f Mo meme en 96k)" % (len(envoi or "") / 1e6)}
+    ace_log("%s : envoi en ligne (%.1f Mo, %s)" % (nom, len(envoi) / 1e6, debit))
+    corps = json.dumps({"input": {"audio_b64": envoi, "lyrics": lyrics, "prompt": style,
+                                  "duration": duree, "timeout": ACE_CLOUD_TIMEOUT}}).encode()
+    # ⛔ ON N'UTILISE PAS `/runsync`. Paye deux fois le 20/09 : il rend un identifiant prefixe
+    # « sync-… » que RunPod refuse ensuite sur `/status/<id>` ET sur `/cancel/<id>` (404 les deux).
+    # Resultat : un travail long devenait INSUIVABLE et surtout INARRETABLE — il a fallu couper a la
+    # main par `workersMax: 0`. `/run` rend un identifiant normal, suivable et annulable ; c'est la
+    # seule forme acceptable pour un travail de plusieurs minutes.
+    rq = urllib.request.Request("https://api.runpod.ai/v2/%s/run" % eid, data=corps, method="POST",
+                                headers={"Authorization": "Bearer " + jeton,
+                                         "Content-Type": "application/json"})
+    try:
+        with urllib.request.urlopen(rq, timeout=120) as r:
+            rep = json.loads(r.read() or b"{}")
+    except Exception as ex:
+        return None, {"erreur": "le renfort en ligne n'a pas repondu : %s" % str(ex)[:160]}
+
+    idj = rep.get("id")
+    if not idj:
+        return None, {"erreur": "en ligne : aucun identifiant de travail (%s)" % str(rep)[:160]}
+    ace_log("%s : travail en ligne %s" % (nom, idj))
+    while rep.get("status") in ("IN_QUEUE", "IN_PROGRESS") and time.time() - t0 < ACE_CLOUD_TIMEOUT:
+        time.sleep(5)
+        try:
+            rq2 = urllib.request.Request("https://api.runpod.ai/v2/%s/status/%s" % (eid, idj),
+                                         headers={"Authorization": "Bearer " + jeton})
+            with urllib.request.urlopen(rq2, timeout=60) as r:
+                rep = json.loads(r.read() or b"{}")
+        except Exception as ex:
+            _ace_cloud_annule(eid, jeton, idj, "suivi impossible")
+            return None, {"erreur": "suivi impossible : %s" % str(ex)[:160]}
+
+    if rep.get("status") != "COMPLETED":
+        # Toujours en cours = on a abandonne par delai : il FAUT l'annuler, sinon il facture seul.
+        if rep.get("status") in ("IN_QUEUE", "IN_PROGRESS"):
+            _ace_cloud_annule(eid, jeton, idj, "delai de %d s depasse" % ACE_CLOUD_TIMEOUT)
+        return None, {"erreur": "en ligne : %s" % str(rep.get("status") or rep.get("error") or rep)[:200]}
+    sortie = rep.get("output") or {}
+    if not sortie.get("ok") or not sortie.get("audio_b64"):
+        _ace_cloud_annule(eid, jeton, idj, "sortie inutilisable")
+        return None, {"erreur": "en ligne : %s" % str(sortie.get("erreur") or "aucun son rendu")[:200]}
+
+    # Le cout REEL, tel que RunPod le facture : le temps d'execution du worker.
+    ms = rep.get("executionTime") or 0
+    cout = round((ms / 3_600_000.0) * ACE_CLOUD_TARIF_H, 5)
+    dest = os.path.join(tempfile.gettempdir(), "gs_cloud_out_%d.mp3" % int(time.time()))
+    try:
+        with open(dest, "wb") as f:
+            f.write(base64.b64decode(sortie["audio_b64"]))
+    except Exception as ex:
+        return None, {"erreur": "reception illisible : %s" % str(ex)[:160]}
+    _ace_spend(cout, ms / 1000.0)
+    # v7.13 (21/09) - LE MODELE QUI A REELLEMENT CALCULE, verifie a chaque morceau. Le 21/09 a 06:08,
+    # Umbrella est revenu du cloud rendu par `base` (image non reconstruite) pendant que le PC servait
+    # `turbo` : ancien son, et rien ne le signalait. Le worker annonce desormais sa configuration et
+    # ce que son serveur a charge (/v1/models) ; un son qui ne vient pas du MEME modele que le PC est
+    # REFUSE — le morceau d'origine reste intact. (Le cout, lui, est deja depense et compte ci-dessus.)
+    attendu = os.path.basename(ACE_MODELE)
+    recu = str(sortie.get("modele_config") or "")
+    ace_log("%s : modele en ligne = %s | charge = %s" % (nom, recu or "?", str(sortie.get("modeles_charges"))[:200]))
+    if os.path.basename(recu) != attendu:
+        try:
+            os.remove(dest)
+        except OSError:
+            pass
+        ace_log("%s : ALERTE son en ligne REFUSE — modele %s au lieu de %s (image a reconstruire)"
+                % (nom, recu or "non annonce", attendu))
+        return None, {"erreur": "en ligne : modele %s au lieu de %s" % (recu or "non annonce", attendu)}
+    ace_log("%s : ENRICHI EN LIGNE en %.0f s, %.4f $ (cumul du mois : %.4f $)"
+            % (nom, time.time() - t0, cout, ace_cloud_depense_mois()))
+    return dest, {"ou": "cloud", "cout_usd": cout, "ms_calcul": ms, "modele": recu}
+
+
+def _ace_marqueur(dossier):
+    return os.path.join(dossier, "enrichissement.json")
+
+
+def enrich_fait(dossier):
+    """Vrai si la suite (mastering, Telegram, analyse) peut passer : enrichi, refuse, en echec definitif,
+    ou son trop vieux. Ne bloque JAMAIS la chaine indefiniment."""
+    if os.path.isfile(_ace_marqueur(dossier)):
+        return True
+    # Symetrique de `enrich_a_faire` : hors du mode « 1+2 », aucun enrichissement automatique n'est
+    # attendu — la suite (mastering, analyse, Telegram) ne doit donc pas patienter pour rien.
+    if mode_du_dossier(dossier) != "1+2":                  # v7.15 : le choix du morceau, sinon le global
+        return True
+    try:
+        son = os.path.join(dossier, "audio.flac")
+        return (not os.path.isfile(son)) or time.time() - os.path.getmtime(son) > ACE_ENRICH_MAX
+    except Exception:
+        return True
+
+
+def enrich_a_faire():
+    """Les morceaux finis que le mode destine au moteur 2, et qui n'y sont pas encore passes.
+
+    ⛔ UN SEUL mode enrichit automatiquement : « 1+2 ». Corrige le 20/09 au soir apres lecture du
+    journal — la condition etait `== "1"`, donc TOUS les autres modes enrichissaient :
+      • en 🎨 « moteur 2 seul », les vieux morceaux du moteur 1 encore dans la fenetre des 30 min
+        se faisaient enrichir alors que Quang n'a rien demande de tel ;
+      • en ⚖️ « 1 et 2 », le morceau du moteur 1 etait enrichi EN PLACE juste apres sa naissance
+        (constate : « banc-duo-32831-993286 : ENRICHI en local »). La comparaison devenait alors
+        « moteur 1 DEJA ENRICHI contre moteur 2 » — c'est-a-dire plus du tout ce que le mode
+        promet. Le defaut etait invisible dans le code et evident dans le log.
+    """
+    base = os.path.join(OUT_ROOT, "gs", "audio")
+    out = []
+    try:
+        noms = os.listdir(base)
+    except Exception:
+        return out
+    for n in noms:
+        d = os.path.join(base, n)
+        son = os.path.join(d, "audio.flac")
+        if n.startswith("_") or not os.path.isfile(son) or not os.path.isfile(os.path.join(d, "request.json")):
+            continue                              # request.json est ecrit APRES le son : son absent = pas fini
+        if os.path.isfile(_ace_marqueur(d)):
+            continue
+        if mode_du_dossier(d) != "1+2":                    # v7.15 : le choix DU MORCEAU (feuille), sinon le global
+            continue
+        try:
+            rt = os.path.getmtime(os.path.join(d, "request.json"))
+            if time.time() - rt < 5:
+                continue                          # on laisse l'ecriture se terminer
+            if time.time() - rt > ACE_ENRICH_MAX:
+                continue                          # trop vieux : c'est un morceau d'avant le moteur 2
+            out.append(d)
+        except Exception:
+            continue
+    return sorted(out, key=lambda x: -os.path.getmtime(os.path.join(x, "request.json")))
+
+
+def _ace_texte(dossier, *noms):
+    for n in noms:
+        p = os.path.join(dossier, n)
+        try:
+            if os.path.isfile(p):
+                with io.open(p, encoding="utf-8", errors="replace") as f:
+                    t = f.read().strip()
+                if t:
+                    return t
+        except Exception:
+            continue
+    return ""
+
+
+def _ace_requete(dossier):
+    """Paroles et style du morceau, tels que le moteur 1 les a recus."""
+    ly, st, duree = "", "", 0.0
+    try:
+        with io.open(os.path.join(dossier, "request.json"), encoding="utf-8") as f:
+            r = json.load(f) or {}
+        ly = str(r.get("lyrics") or r.get("paroles") or "")
+        st = str(r.get("style") or r.get("prompt") or r.get("genre") or "")
+    except Exception:
+        pass
+    if not ly:
+        ly = _ace_texte(dossier, "lyrics.txt", "paroles.txt")
+    if not st:
+        st = _ace_texte(dossier, "style.txt", "genre.txt")
+    try:
+        duree = float(_duree_s(os.path.join(dossier, "audio.flac")) or 0)
+    except Exception:
+        duree = 0.0
+    return ly, st, duree
