+            art = cand[0] if cand else None
+        else:
+            art, choix_a, note = ref_choisit_artiste(ref["artiste"])
+            if choix_a:
+                return {"etat": "ambigu", "type": "artiste", "question": "Quel « %s » ?" % ref["artiste"],
+                        "choix": [{"mbid": x["mbid"], "nom": x["nom"], "desc": x["desc"], "pays": x["pays"],
+                                   "type": x["type"], "debut": x["debut"]} for x in choix_a]}
+            if note:
+                notes.append("artiste %s : %s" % (ref["artiste"], note))
+    # 2. le titre (cite, ou le plus ecoute de l'artiste pour « representer » son son)
+    if choix and choix.get("titre_id"):
+        d = _ref_get("https://api.deezer.com/track/%s" % int(choix["titre_id"]))
+        titre = {"id": d.get("id"), "titre": d.get("title"), "artiste": (d.get("artist") or {}).get("name"),
+                 "duree": d.get("duration"), "rang": d.get("rank"), "preview": d.get("preview")}
+        if not art and titre.get("artiste"):
+            art, _, _ = ref_choisit_artiste(titre["artiste"])
+    elif ref.get("titre"):
+        titre, choix_t, note = ref_choisit_titre(art["nom"] if art else ref.get("artiste"), ref["titre"])
+        if choix_t:
+            return {"etat": "ambigu", "type": "titre", "question": "Quel « %s » ?" % ref["titre"],
+                    "choix": [{"titre_id": x["id"], "nom": x["titre"], "artiste": x["artiste"], "album": x["album"],
+                               "image": x.get("image")} for x in choix_t]}
+        if note:
+            notes.append("titre %s : %s" % (ref["titre"], note))
+        if titre and not art and titre.get("artiste"):
+            art, _, _ = ref_choisit_artiste(titre["artiste"])
+    elif art:
+        tops = ref_dz_titres(art["nom"], 10)
+        tops = [t for t in tops if ref_norm(t["artiste"]) == ref_norm(art["nom"]) and not REF_VERSIONS.search(t["titre"] or "")]
+        titre = max(tops, key=lambda t: t["rang"]) if tops else None
+        if titre:
+            titre["representatif"] = True
+    if not art and not titre:
+        ref_log("INTROUVABLE %s — %s" % (ref, "; ".join(notes)))
+        return {"etat": "introuvable", "notes": notes}
+    # 3. details du titre + ecoute de l'extrait (une seule fois : c'est en cache ensuite)
+    ecoute, alertes = None, []
+    if titre:
+        try:
+            d = _ref_get("https://api.deezer.com/track/%s" % titre["id"])
+            titre.update(bpm=(round(float(d.get("bpm") or 0), 1) or None), date=d.get("release_date"),
+                         preview=d.get("preview") or titre.get("preview"))
+        except Exception as ex:
