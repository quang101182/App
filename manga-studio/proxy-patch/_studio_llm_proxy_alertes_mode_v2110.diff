+def liberer_autres(pour):
+    """Avant une generation `pour` : les AUTRES moteurs allumes et INACTIFS vident leur memoire graphique (sans
+    s'eteindre). Rend la liste de ce qui a ete vide (journalise dans vram_garde.log)."""
+    faits = []
+    try:
+        avant = vram_info().get("used", 0)
+    except Exception:
+        avant = 0
+    if pour != "images" and not comfy_busy() and _comfy_free(COMFY):
+        faits.append("images")
+    if pour != "video" and not comfy_busy_ltx() and _comfy_free(COMFY_LTX):
+        faits.append("video")
+    if pour != "musique":
+        p = yue2_get("/ping", timeout=2)
+        if p and not p.get("busy") and p.get("model_loaded"):
+            yue2_post("/unload", {}, timeout=20)
+            faits.append("musique")
+    # v6.92 : le moteur 2 ne sait PAS decharger (mesure du 20/09 : ACESTEP_OFFLOAD_TO_CPU
+    # laisse 4,8 Go pris). On l'eteint — c'est le seul geste qui rende la memoire.
+    # ⚠ v6.97 : la garde testait la seule etape « enrichissement ». Depuis que le moteur 2 sait
+    # aussi CREER (mode 🎨), une creation en cours se serait fait couper la memoire sous les pieds.
+    # Toute nouvelle etape du moteur 2 doit etre ajoutee ICI — ou, mieux, ne rien tuer des qu'une
+    # etape quelconque est en cours, ce que fait ce test.
+    if pour != "musique2" and ace_pid() and not _ACE.get("etape"):
+        ace_stop("place pour %s" % pour)
+        faits.append("moteur 2")
+    if faits:
+        time.sleep(1.5)                                  # ComfyUI decharge dans sa boucle : on lui laisse le temps
+        try:
+            apres = vram_info().get("used", 0)
+        except Exception:
+            apres = 0
+        garde_log("AVANT %s : memoire videe de %s (%d -> %d Mo)" % (pour, ", ".join(faits), avant, apres))
+    return faits
