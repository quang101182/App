+def rename_output(subfolder, filename, newname):
+    """Renomme UN fichier de sortie. Meme confinement que delete_output : ce qui
+    protege n'est pas un basename, c'est de verifier que la source ET la
+    destination retombent SOUS output/."""
+    safe = os.path.basename(filename or "")
+    if not safe:
+        return {"error": "filename vide"}
+    raw = os.path.basename(newname or "").strip()
+    if not raw:
+        return {"error": "nouveau nom vide"}
+    stem, ext = os.path.splitext(raw)
+    if not ext:
+        ext = os.path.splitext(safe)[1]
+    stem = re.sub(r"[^a-zA-Z0-9_.-]", "_", stem)[:80].strip("._") or "sans-nom"
+    sub = (subfolder or "").replace("\\", "/").strip("/")
+    root = os.path.normpath(OUT_ROOT)
+    src = os.path.normpath(os.path.join(root, sub, safe))
+    dst = os.path.normpath(os.path.join(root, sub, stem + ext))
+    if not src.startswith(root + os.sep) or not dst.startswith(root + os.sep):
+        return {"error": "chemin hors output"}
+    if not os.path.isfile(src):
+        return {"error": "fichier introuvable"}
+    if os.path.normcase(src) == os.path.normcase(dst):
+        return {"ok": True, "unchanged": True, "filename": os.path.basename(dst)}
+    if os.path.exists(dst):
+        stem = stem + "-" + time.strftime("%H%M%S")
+        dst = os.path.normpath(os.path.join(root, sub, stem + ext))
+    try:
+        os.rename(src, dst)
+        return {"ok": True, "filename": os.path.basename(dst), "subfolder": sub}
+    except Exception as ex:
+        return {"error": str(ex)}
