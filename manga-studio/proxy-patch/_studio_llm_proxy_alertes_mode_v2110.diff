+# ---------------------------------------------------------------- v6.53 MÊME MÉLODIE, AUTRE STYLE (mode A du point 19)
+# La partition d'un morceau (score.abc, ecrite par le moteur) SANS ses accords : le moteur, en cot="melody", garde alors
+# la melodie (voix + instrument lead, durees, mesures, TEMPO) et invente un accompagnement neuf dans le style demande.
+# Outil OFFICIEL des auteurs : YuE/skills/yue2-music/scripts/abc_tools.py (stdlib pure), importe tel quel ; sa
+# comparaison sert de preuve que la melodie n'a pas bouge. Doc (docs/editing.md) : meme partition != meme chant ni
+# meme timbre -- c'est la melodie qui est gardee, pas la voix.
+ABC_TOOLS_DIR = os.path.join(os.path.expanduser("~"), "Documents", "YuE2", "YuE", "skills", "yue2-music", "scripts")
+
+
+def _abc_tools():
+    if ABC_TOOLS_DIR not in sys.path:
+        sys.path.insert(0, ABC_TOOLS_DIR)
+    import abc_tools                                   # noqa: E402 (outil officiel, stdlib)
+    return abc_tools
