+def manga_ingest(b64, filename, slug, translate=False, conf=0.25, clean=False):
+    """Ingere une page existante : detection des cases et des bulles, decoupe,
+    et traduction optionnelle. Delegue au script du projet — le proxy ne fait que
+    l'appeler, il ne reimplemente rien.
+
+    Le sous-processus tourne dans le venv kohya (ultralytics + torch cu128).
+    """
+    if not os.path.isfile(MANGA_PY):
+        return {"error": "venv kohya introuvable: %s" % MANGA_PY}
+    if not os.path.isfile(MANGA_INGEST):
+        return {"error": "script d'ingestion introuvable: %s" % MANGA_INGEST}
+    slug = re.sub(r"[^a-zA-Z0-9_-]", "", slug or "divers") or "divers"
+    ext = os.path.splitext(filename or "")[1].lower()
+    if ext not in (".png", ".jpg", ".jpeg", ".webp", ".pdf"):
+        ext = ".png"
+    tmpdir = os.path.join(MANGA_OUT, "_tmp")
+    os.makedirs(tmpdir, exist_ok=True)
+    src = os.path.join(tmpdir, "ingest_%d%s" % (int(time.time() * 1000), ext))
+    try:
+        if "," in b64[:200]:              # dataURL -> on ne garde que la charge utile
+            b64 = b64.split(",", 1)[1]
+        with open(src, "wb") as f:
+            f.write(base64.b64decode(b64))
+    except Exception as ex:
+        return {"error": "image illisible: %s" % ex}
+
+    cmd = [MANGA_PY, MANGA_INGEST, src, "--out", os.path.join(MANGA_OUT, slug),
+           "--conf", str(conf)]
+    if translate:
+        cmd.append("--translate")
+    if clean:
+        cmd.append("--clean")
+    try:
+        p = subprocess.run(cmd, capture_output=True, timeout=600,
+                           cwd=os.path.dirname(MANGA_INGEST))
+    except subprocess.TimeoutExpired:
+        return {"error": "ingestion : delai depasse (600 s)"}
+    finally:
+        try: os.remove(src)
+        except Exception: pass
+    out = (p.stdout or b"").decode("utf-8", "replace").strip()
+    err = (p.stderr or b"").decode("utf-8", "replace").strip()
+    if p.returncode != 0 or not out:
+        return {"error": "ingestion echouee (code %s)" % p.returncode,
+                "detail": err[-800:] or out[-800:]}
+    try:
+        data = json.loads(out)
+    except Exception:
+        # Le script ecrit ses logs sur stderr precisement pour que ca n'arrive pas.
+        return {"error": "sortie d'ingestion illisible", "detail": out[:800]}
+    data["log"] = err[-2000:]
+    return data
+
+
+def manga_crop_ref(filename):
+    """Recadre une image de reference sur le VISAGE, dans ComfyUI/input.
+
+    Mesure du 28/07 : IPAdapter transfere la COMPOSITION de la reference autant
+    que l'identite. Une reference qui est une planche de personnage (plusieurs
+    vues, fond vide) fait donc heriter la case de sa mise en page. Le recadrage
+    sur le visage supprime la cause -- un portrait serre n'a pas de mise en page
+    a transmettre.
+
+    Delegue a `scripts/crop_ref.py` (venv kohya : ultralytics + YOLO face) ; le
+    proxy appelle, il ne reimplemente rien. Aucun visage trouve => on le DIT et
+    l'appelant garde l'image entiere : recadrer au hasard couperait le sujet.
+    """
+    if not os.path.isfile(MANGA_PY):
+        return {"error": "venv kohya introuvable: %s" % MANGA_PY}
+    if not os.path.isfile(MANGA_CROP):
+        return {"error": "script de recadrage introuvable: %s" % MANGA_CROP}
+    nom = os.path.basename(filename or "")
+    src = os.path.join(COMFY_INPUT_DIR, nom)
+    if not nom or not os.path.isfile(src):
+        return {"error": "image introuvable dans input: %s" % nom}
+    base, ext = os.path.splitext(nom)
+    dest_nom = base + "_crop.png"
+    dest = os.path.join(COMFY_INPUT_DIR, dest_nom)
+    cmd = [MANGA_PY, MANGA_CROP, src, "--out", dest, "--json"]
+    try:
+        p = subprocess.run(cmd, capture_output=True, timeout=180,
+                           cwd=os.path.dirname(MANGA_CROP))
+    except subprocess.TimeoutExpired:
+        return {"error": "recadrage : delai depasse (180 s)"}
+    out = (p.stdout or b"").decode("utf-8", "replace").strip()
+    err = (p.stderr or b"").decode("utf-8", "replace").strip()
+    try:
+        data = json.loads(out.splitlines()[-1]) if out else {}
+    except Exception:
+        return {"error": "sortie de recadrage illisible", "detail": (out or err)[:600]}
+    if not data.get("ok"):
+        return {"ok": False, "raison": data.get("raison") or err[-300:] or "echec"}
+    data["name"] = dest_nom
+    return data
+
+
+def manga_dataset(slug, trigger, items):
+    """Ecrit un dataset d'entrainement a partir des cases VALIDEES.
+
+    C'est le point ou la boucle de validation paie : a ~30 cases jugees bonnes
+    d'un meme style, on tient de quoi entrainer le LoRA suivant. L'app PROPOSE
+    ce dataset — elle ne lance rien, et n'entraine rien toute seule
+    (decision Generate Studio du 29/06 : l'apprentissage automatique sur signal
+    faible avait ete juge non fiable et retrograde en suggestions a valider).
+    """
+    slug = re.sub(r"[^a-zA-Z0-9_-]", "", slug or "divers") or "divers"
+    trigger = re.sub(r"[^a-zA-Z0-9_]", "", trigger or "") or "perso"
+    dest = os.path.join(MANGA_ROOT, "dataset_%s" % slug)
+    if os.path.isdir(dest):
+        shutil.rmtree(dest)           # un dataset se REGENERE, il ne s'empile pas
+    os.makedirs(dest, exist_ok=True)
+    n, absents = 0, []
+    for it in (items or []):
+        src = _manga_safe(it.get("file") or "")
+        if not src or not os.path.isfile(src):
+            absents.append(it.get("file")); continue
+        ext = os.path.splitext(src)[1] or ".png"
+        base = "ds_%02d" % n
+        shutil.copy2(src, os.path.join(dest, base + ext))
+        with open(os.path.join(dest, base + ".txt"), "w", encoding="utf-8") as f:
+            f.write((it.get("caption") or trigger).strip())
+        n += 1
+    return {"ok": True, "path": dest, "images": n, "trigger": trigger,
+            "absents": absents,
+            "commande": "python scripts/prep_train.py --src %s --trigger %s" % (dest, trigger)}
+
+
+def manga_files(slug=""):
+    """Galerie PROPRE au projet : ne liste que output/<slug>/, jamais le dossier de GS."""
+    base = _manga_safe(slug) if slug else os.path.normpath(MANGA_OUT)
+    if not base or not os.path.isdir(base):
+        return {"files": []}
+    out = []
+    for f in sorted(os.listdir(base)):
+        p = os.path.join(base, f)
+        if os.path.isfile(p) and f.lower().endswith((".png", ".jpg", ".jpeg", ".webp")):
+            out.append({"name": f, "path": ("%s/%s" % (slug, f)) if slug else f,
+                        "bytes": os.path.getsize(p), "mtime": int(os.path.getmtime(p) * 1000)})
+    out.sort(key=lambda x: x["mtime"], reverse=True)
+    return {"files": out}
