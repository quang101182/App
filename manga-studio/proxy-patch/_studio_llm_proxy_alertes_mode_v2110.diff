+# ============ v6.43 - GARDE MEMOIRE GRAPHIQUE (incident du 18/09 : le PC de Quang a plante) ============
+# Carte de 16 Go. Le moteur musique culmine a ~13,2 Go (150 s de musique, offload_ar) et monte avec la longueur.
+# Le 18/09, Netflix + Jarvis + le moteur = 15,4-15,6 Go : synthese 5x plus lente, puis reset du pilote (nvlddmkm 153)
+# a l'arret force du moteur, puis gel. Deux protections :
+#  (1) AU DEPART : si les AUTRES applications prennent deja trop de memoire, on ne lance pas (on le dit) ;
+#  (2) PENDANT : si la carte frole la saturation, on ANNULE PROPREMENT le morceau (/cancel du moteur, qui s'arrete
+#      entre deux jetons) - on perd un morceau, pas le PC. On ne TUE jamais le moteur en plein calcul.
+VRAM_EXTERNE_MAX_MO = int(os.environ.get("GS_VRAM_EXTERNE_MAX", "4500"))   # repos mesure le 18/09 : ~2,9 Go
+VRAM_ALERTE_MO = int(os.environ.get("GS_VRAM_ALERTE", "15600"))           # 15,6 Go : le cas qui a gele
+VRAM_ALERTE_DUREE_S = 15
+GARDE_LOG = os.path.join(os.path.dirname(os.path.abspath(__file__)), "logs", "vram_garde.log")
+_GARDE = {"au_dessus_depuis": None, "annule_job": None, "derniere_attente": 0, "sig": None, "sig_depuis": None,
+          "alerte_job": None}
+# v6.49 - PREVENIR, PAS BLOQUER (decision de Quang, 18/09 ~21h30 : « n'est-on pas trop restrictifs ? »). Relecture
+# des journaux du 18/09 : le reset du pilote est tombe A LA MILLISECONDE de l'arret FORCE du moteur (mon geste), pas
+# pendant la saturation ; saturee, la carte deborde en memoire partagee -> LENT (678 s au lieu de ~210), pas un crash.
+# L'arret force n'existe plus (annulation propre, v6.43). Donc : on LANCE toujours, on DIT qui charge la carte, et on
+# n'annule (proprement) que si le morceau n'AVANCE PLUS du tout pendant GS_BLOCAGE_MIN minutes. Le pire decodage lent
+# mesure a fini en 8 min ; le morceau reellement bloque du 18/09 depassait 22 min -> 20 min par defaut.
+BLOCAGE_S = int(os.environ.get("GS_BLOCAGE_MIN", "20")) * 60
+_COUPABLES = {"t": 0, "liste": []}
+_PS_COUPABLES = r"""
+$c = Get-Counter '\GPU Process Memory(*)\Dedicated Usage' -ErrorAction SilentlyContinue
+$ad = Get-Counter '\GPU Adapter Memory(*)\Dedicated Usage' -ErrorAction SilentlyContinue
+$luid = ($ad.CounterSamples | Sort-Object CookedValue -Descending | Select-Object -First 1).InstanceName
+if($luid -match '(luid_0x[0-9a-f]+_0x[0-9a-f]+)'){ $luid = $matches[1] }
+$agg = @{}
+foreach($x in $c.CounterSamples){ if($x.InstanceName -match ('pid_(\d+)_' + $luid)){ $p=[int]$matches[1]; $agg[$p] = $agg[$p] + $x.CookedValue } }
+$out = @()
+foreach($k in $agg.Keys){ if($agg[$k] -lt 80MB){ continue }
+  $pr = Get-CimInstance Win32_Process -Filter "ProcessId=$k" -ErrorAction SilentlyContinue
+  $out += [pscustomobject]@{pid=$k; mo=[int]($agg[$k]/1MB); nom=$pr.Name; cmd=[string]$pr.CommandLine} }
+$out | ConvertTo-Json -Compress
+"""
+
+
+def _libelle_process(nom, cmd):
+    """Un nom que Quang reconnait. None = a ne pas lister (Windows lui-meme, le moteur musique, ce proxy)."""
+    n, c = (nom or "").lower(), (cmd or "").lower()
+    if n in ("dwm.exe", "csrss.exe", "explorer.exe", "system", "") or "yue2_server" in c or "_studio_llm_proxy" in c:
+        return None                                   # dwm gonfle ses chiffres (surfaces partagees) : Windows, pas un coupable
+    if "webview_netflix_profile" in c:
+        return "la fen\u00eatre Netflix de Jarvis"
+    if "\\jarvis\\" in c or "/jarvis/" in c:
+        return "Friday (Jarvis)" if n == "msedge.exe" else "les fen\u00eatres de Jarvis"
+    return {"comet.exe": "Comet", "chrome.exe": "Chrome", "msedge.exe": "Edge", "firefox.exe": "Firefox",
+            "steamwebhelper.exe": "Steam", "eadesktop.exe": "EA Desktop", "eacefsubprocess.exe": "EA Desktop",
+            "msedgewebview2.exe": "une appli (fen\u00eatre web)"}.get(n, n[:-4] if n.endswith(".exe") else n)
+
+
+def vram_coupables(frais=False):
+    """Qui prend la carte graphique, par NOM, du plus gros au plus petit (>= 150 Mo). Cache 30 s. [] si illisible."""
+    if not frais and time.time() - _COUPABLES["t"] < 30:
+        return _COUPABLES["liste"]
+    liste = []
+    try:
+        r = subprocess.run(["powershell", "-NoProfile", "-NonInteractive", "-Command", _PS_COUPABLES], capture_output=True,
+                           text=True, encoding="utf-8", errors="replace", timeout=25,
+                           creationflags=getattr(subprocess, "CREATE_NO_WINDOW", 0))
+        brut = json.loads((r.stdout or "").strip() or "[]")
+        brut = brut if isinstance(brut, list) else [brut]
+        agg = {}
+        for x in brut:
+            lib = _libelle_process(x.get("nom"), x.get("cmd"))
+            if lib:
+                agg[lib] = agg.get(lib, 0) + int(x.get("mo") or 0)
+        liste = [{"nom": k, "mo": v} for k, v in sorted(agg.items(), key=lambda kv: -kv[1]) if v >= 150]
+    except Exception as ex:
+        garde_log("coupables illisibles : %s" % str(ex)[:120])
+    _COUPABLES.update(t=time.time(), liste=liste)
+    return liste
+
+
+def phrase_coupables(liste, n=3):
+    return ", ".join("%s %.1f Go" % (x["nom"], x["mo"] / 1024.0) for x in liste[:n]).replace(".", ",")
+
+
+def garde_log(msg):
+    try:
+        with io.open(GARDE_LOG, "a", encoding="utf-8") as f:
+            f.write("%s %s\n" % (time.strftime("%Y-%m-%d %H:%M:%S"), msg))
+    except Exception:
+        pass
+
+
+def vram_externe():
+    """(externe_mo, total_mo, used_mo) : ce que prennent les AUTRES que le moteur musique."""
+    v = vram_info()
+    moteur = 0
+    try:
+        m = yue2_get("/vram", timeout=2)
+        if m:
+            moteur = int(m.get("torch_reserved_mo") or 0) + (400 if m.get("torch_reserved_mo") else 0)  # + contexte CUDA
+    except Exception:
+        pass
+    return max(0, v.get("used", 0) - moteur), v.get("total", 0), v.get("used", 0)
+
