+
+def garde_vram_passe():
+    """Appele toutes les 5 s. v6.49 : la saturation n'annule PLUS rien (elle rend lent, ne fait pas planter : cf plus
+    haut) ; elle est JOURNALISEE une fois par morceau, avec les coupables. On annule PROPREMENT seulement un morceau
+    qui n'AVANCE PLUS (phase et compteurs figes) depuis BLOCAGE_S."""
+    p = yue2_get("/ping", timeout=2)
+    if not p or not p.get("busy"):
+        _GARDE["au_dessus_depuis"] = None; _GARDE["sig"] = None; _GARDE["sig_depuis"] = None
+        return
+    st = yue2_get("/status", timeout=3) or {}
+    job = st.get("id")
+    v = vram_info()
+    if v.get("used", 0) >= VRAM_ALERTE_MO and job and _GARDE["alerte_job"] != job:
+        _GARDE["alerte_job"] = job
+        garde_log("carte SATUREE pendant le job %s : %d / %d Mo (le calcul continue, plus lent) - %s"
+                  % (job, v["used"], v["total"], phrase_coupables(vram_coupables(frais=True)) or "coupables inconnus"))
+    # v7.52 : + `pas`, le battement de coeur de la synthese acoustique (sans lui, une synthese lente = « bloque »)
+    sig = (job, st.get("phase"), st.get("abc_tokens"), st.get("sem_tokens"), st.get("pas"))
+    if sig != _GARDE["sig"]:
+        _GARDE["sig"], _GARDE["sig_depuis"] = sig, time.time()
+        return
+    fige = time.time() - (_GARDE["sig_depuis"] or time.time())
+    if fige < BLOCAGE_S or not job or job == _GARDE["annule_job"]:
+        return
+    qui = phrase_coupables(vram_coupables(frais=True))
+    raison = ("Arr\u00eat\u00e9 : le morceau n'avan\u00e7ait plus depuis %d min (carte graphique %.1f Go sur %.1f%s)"
+              % (fige // 60, v.get("used", 0) / 1024.0, v.get("total", 0) / 1024.0,
+                 (" \u2014 " + qui) if qui else "")).replace(".", ",")
+    r = yue2_post("/cancel", {"raison": raison}, timeout=10) or {}
+    _GARDE["annule_job"] = job
+    garde_log("ANNULATION PROPRE du job %s : BLOQUE depuis %d s en phase %s (carte %d Mo) - %s (reponse %s)"
+              % (job, fige, st.get("phase"), v.get("used", 0), qui or "coupables inconnus", r.get("job")))
+    notif_log("garde : job %s annule, bloque depuis %d min" % (job, fige // 60))
+
+
+# ============ v6.75 (point 54) - UN SEUL MOTEUR SUR LA CARTE ============
+# Quang, 19/09 : « les trois moteurs ne doivent pas se chevaucher [...] c'est toujours un seul a la fois ». MESURE
+# (mesure_vram_moteurs.json) : apres une image, ComfyUI garde 6,9 Go ; un morceau lance par-dessus passait (avis
+# seulement), pic 14,8 / 16,3 Go, 29 s au lieu de 17 s. Un « /free » rend la memoire sans eteindre le moteur.
+MSG_OCCUPE = {"images": "\U0001F5BC\uFE0F Le moteur Images g\u00e9n\u00e8re d\u00e9j\u00e0 : attends la fin du rendu.",
+              "video": "\U0001F3AC Un rendu vid\u00e9o occupe la carte graphique : attends qu'il se termine.",
+              "musique": "\U0001F3B5 Une g\u00e9n\u00e9ration musicale occupe la carte graphique : attends qu'elle se termine."}
