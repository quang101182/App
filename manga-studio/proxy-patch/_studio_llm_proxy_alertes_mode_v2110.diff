+def ref_choisit_artiste(nom):
+    """Rend (fiche_artiste | None, choix[], note). Deezer corrige l'orthographe, MusicBrainz donne les faits."""
+    dz = ref_dz_artistes(nom)
+    # la correction d'orthographe = le PLUS ECOUTE des noms proches de ce qui a ete tape. Le 1er renvoye
+    # par Deezer peut etre un inconnu (« Rosal-IA », 54 fans, devant ROSALIA : vu au banc).
+    # v6.32d - un nom IDENTIQUE a ce qui a ete tape passe avant : « Prince » donnait « Prince Royce »
+    # (2,6 M de fans, contient « prince ») au lieu de Prince (1,4 M). Le plus ecoute des noms proches
+    # ne sert qu'a defaut, pour les fautes de frappe (« stromea », « beyonse »).
+    exacts = [a for a in dz if ref_norm(a["nom"]) == ref_norm(nom)]
+    proches = exacts or [a for a in dz if ref_proche(nom, a["nom"]) >= 0.75 or ref_norm(nom) in ref_norm(a["nom"])]
+    nom_corrige = max(proches, key=lambda a: a["fans"])["nom"] if proches else nom
+    mb = [a for a in ref_mb_artistes(nom_corrige) if a["score"] >= 80]
+    if not mb and ref_norm(nom_corrige) != ref_norm(nom):
+        mb = [a for a in ref_mb_artistes(nom) if a["score"] >= 80]
+    if not mb:
+        return None, [], "introuvable"
+    # homonymes au meme nom : MusicBrainz classe deja par pertinence ; on tranche avec l'ecart de score
+    memes = [a for a in mb if ref_norm(a["nom"]) == ref_norm(mb[0]["nom"])]
+    fans = {ref_norm(a["nom"]): a["fans"] for a in dz}
+    for a in mb:
+        a["fans"] = fans.get(ref_norm(a["nom"]), 0) if a is mb[0] else 0
+    if len(memes) >= 2 and memes[0]["score"] - memes[1]["score"] < 10:
+        return None, memes[:4], "homonymes"
+    a = dict(mb[0])
+    a["corrige"] = ref_norm(a["nom"]) != ref_norm(nom)
+    return a, [], ""
+
