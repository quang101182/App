+# ═══ v5.64 — CONSTRUCTEUR DE WORKFLOW LTX 2.5 ════════════════════════════════════════════
+# Les builders JS existants (wanT2VLTX/wanI2VLTX) visent LTX-2.3 : ils ne marchent PAS sur la
+# 2.5 (duration head, VAE audio séparé, chaîne à 2 passes). Plutôt que de reconstruire 44/50
+# nœuds à la main, on part des TEMPLATES OFFICIELS Comfy-Org convertis en format API — ceux-là
+# mêmes qui ont produit les 16 vidéos du banc du 12/08 — et on ne patche que les entrées utiles.
+LTX25_T2V_FILE = os.path.join(os.path.dirname(os.path.abspath(__file__)), "_ltx25_workflow.json")
+LTX25_I2V_FILE = os.path.join(os.path.dirname(os.path.abspath(__file__)), "_ltx25_workflow_i2v.json")
+# FLF2V = image de DÉBUT + image de FIN (mode Récit : keyframes par plan). Le chemin 2.3
+# (LTX_FLF2V_AV_TPL côté HTML) chargeait `ltx-2.3-22b-dev.safetensors`, ABSENT de l'install 2.5
+# -> ce mode était cassé. Template officiel `video_ltx2_5_flf2v` converti en API.
+# Rôles vérifiés dans le graphe : LoadImage 31 -> LTXVAddGuide frame_idx=0 (DÉBUT)
+#                                LoadImage 39 -> LTXVAddGuide frame_idx=-1 (FIN)
+LTX25_FLF2V_FILE = os.path.join(os.path.dirname(os.path.abspath(__file__)), "_ltx25_workflow_flf2v.json")
+LTX25_FLF2V_START, LTX25_FLF2V_END = "31", "39"
+LTX25_FLF2V_W, LTX25_FLF2V_H = "251:215", "251:216"
+# Mesuré le 12/08 sur RTX 5070 Ti 16 Go : 0.9 MP = 195-241 s · 2.1 MP = 466 s · 3.7 MP = >35 min
+# (VRAM saturée, non linéaire) -> le 1440p n'est PAS proposé, c'est un piège à utilisateur.
+LTX25_MP = {"720p": 0.9, "1080p": 2.1}
+LTX25_RATIO = {"9:16": "9:16 (Portrait Widescreen)", "16:9": "16:9 (Widescreen)", "1:1": "1:1 (Square)"}
+
+def _ltx25_rand_seed():
+    """Seed aléatoire (les 2 RandomNoise du graphe en reçoivent un différent, comme ComfyUI le fait)."""
+    return int.from_bytes(os.urandom(6), "big")
+
+def ltx25_build(p):
+    """Construit un workflow API LTX 2.5 prêt à poster sur /prompt.
+    p = {mode, prompt, seconds, ratio, quality, audio, enhance, seed, image}"""
+    mode = (p.get("mode") or "t2v").lower()
+    src = (LTX25_FLF2V_FILE if mode == "flf2v" else
+           LTX25_I2V_FILE if mode == "i2v" else LTX25_T2V_FILE)
+    if not os.path.isfile(src):
+        raise RuntimeError("template LTX 2.5 manquant: " + src)
+    with open(src, "r", encoding="utf-8") as f:
+        wf = json.load(f)
+
+    prompt = (p.get("prompt") or "").strip()
+    seconds = int(p.get("seconds") or 6)
+    ratio = LTX25_RATIO.get(p.get("ratio") or "9:16", LTX25_RATIO["9:16"])
+    mp = LTX25_MP.get(p.get("quality") or "720p", 0.9)
+    want_audio = bool(p.get("audio", True))
+    enhance = bool(p.get("enhance", False))
+    seed = p.get("seed")
+    image = p.get("image")
+
+    # FLF2V : pas de ResolutionSelector — la taille passe par 2 PrimitiveInt, et les 2 images
+    # sont posées par leur id (début=frame 0, fin=frame -1). On règle ça AVANT la boucle
+    # générique, sinon le patch "PrimitiveInt == 5" toucherait aussi la largeur/hauteur.
+    if mode == "flf2v":
+        dims = {"720p": (704, 1280), "1080p": (1088, 1984)}[p.get("quality") or "720p"]
+        w, h = dims
+        if (p.get("ratio") or "9:16") == "16:9":
+            w, h = h, w
+        elif (p.get("ratio") or "9:16") == "1:1":
+            w = h = 960 if mp == 0.9 else 1440
+        if LTX25_FLF2V_W in wf: wf[LTX25_FLF2V_W].setdefault("inputs", {})["value"] = w
+        if LTX25_FLF2V_H in wf: wf[LTX25_FLF2V_H].setdefault("inputs", {})["value"] = h
+        if image and LTX25_FLF2V_START in wf:
+            wf[LTX25_FLF2V_START].setdefault("inputs", {})["image"] = image
+        end_img = p.get("endImage")
+        if end_img and LTX25_FLF2V_END in wf:
+            wf[LTX25_FLF2V_END].setdefault("inputs", {})["image"] = end_img
+
+    for nid, node in wf.items():
+        ct = node.get("class_type", "")
+        ins = node.setdefault("inputs", {})
+        if mode == "flf2v" and ct == "LoadImage":
+            continue          # déjà posées ci-dessus, par rôle (début / fin)
+        if mode == "flf2v" and ct == "PrimitiveInt" and ins.get("value") in (704, 1280, 1088, 1984, 960, 1440):
+            continue          # ne pas confondre largeur/hauteur avec la durée
+        if ct == "ResolutionSelector":
+            ins["aspect_ratio"] = ratio; ins["megapixels"] = mp
+        elif ct == "PrimitiveInt" and ins.get("value") == 5:
+            ins["value"] = seconds          # durée EN SECONDES (la 2.5 ne raisonne plus en frames)
+        elif ct == "CLIPTextEncode" and isinstance(ins.get("text"), str) and ins["text"].strip():
+            if prompt: ins["text"] = prompt   # le 1er CLIPTextEncode non vide = le positif
+        elif ct == "PrimitiveStringMultiline" and prompt:
+            ins["value"] = prompt             # branche "enhancer OFF" du switch
+        elif ct == "PrimitiveBoolean" and ins.get("value") is True:
+            ins["value"] = enhance            # switch du prompt enhancer
+        elif ct == "RandomNoise":
+            # ⚠️ SANS ça, les seeds restent ceux du TEMPLATE (42 / 5588115…) : deux générations du
+            # même prompt rendent la MÊME vidéo, et ComfyUI sert même son cache (17 s au lieu de
+            # 3 min — c'est ce qui a trahi le défaut). L'utilisateur qui relance veut une variante,
+            # pas une copie. Un seed explicite reste respecté (reproductibilité voulue).
+            try:
+                ins["noise_seed"] = int(seed) if seed is not None else _ltx25_rand_seed()
+            except Exception:
+                ins["noise_seed"] = _ltx25_rand_seed()
+        elif ct == "LoadImage" and image:
+            ins["image"] = image              # i2v : fichier déjà uploadé via /upload/image
+        elif ct == "SaveVideo":
+            # DOIT écrire sous gs/video : c'est là que la galerie GS regarde (/outputs_list).
+            ins["filename_prefix"] = "gs/video/ltx25_" + mode
+        elif ct == "CreateVideo" and not want_audio:
+            # 🔇 SANS SON, nativement : `audio` est une entrée OPTIONNELLE de CreateVideo
+            # (required = [images, fps]). On la retire = vidéo muette, sans ffmpeg -an.
+            # ⚠️ Vaut pour LTX 2.5 seulement ; sur 2.3 l'audio n'était pas détachable.
+            ins.pop("audio", None)
+    return wf
+
