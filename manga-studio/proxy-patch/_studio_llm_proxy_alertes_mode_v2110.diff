+        ch = re.sub(r"\s*-\s*Topic$", "", str(data.get("chaine") or "")).strip()
+        if " - " not in titre and ch:
+            artiste = ch
+    base = _mp3_nom_propre(("%s - %s" % (artiste, titre)) if artiste and " - " not in titre else titre)
+    cible = os.path.join(MUSIQUE_REFS, base + ".mp3")
