+def append_client_log(events, meta=None):
+    """v5.87 - JOURNAL CONTINU du client, ecrit au fil de l'eau.
+
+    Pourquoi cette route existe, alors que /savelog existait deja : /savelog exige que
+    Quang OUVRE le journal et clique "envoyer au PC". Quand il signale un probleme
+    depuis son telephone, il faut donc qu'il fasse une manipulation avant que je puisse
+    regarder - et, pire, `Logger.startSession()` VIDE le journal a chaque ouverture de
+    l'app : un simple rafraichissement apres l'incident effacait la preuve.
+
+    Ici, chaque evenement arrive tout seul et s'ajoute a un JSONL que je lis directement.
+    Best-effort de bout en bout : si le disque refuse, le client ne doit rien voir.
+    """
+    try:
+        os.makedirs(LOGS_DIR, exist_ok=True)
+        path = os.path.join(LOGS_DIR, "client.jsonl")
+        # rotation simple : au-dela de 5 Mo on repart, en gardant la precedente
+        try:
+            if os.path.isfile(path) and os.path.getsize(path) > 5 * 1024 * 1024:
+                vieux = os.path.join(LOGS_DIR, "client.jsonl.1")
+                if os.path.isfile(vieux):
+                    os.remove(vieux)
+                os.rename(path, vieux)
+        except Exception:
+            pass
+        m = meta if isinstance(meta, dict) else {}
+        recu = time.strftime("%Y-%m-%d %H:%M:%S")
+        n = 0
+        with open(path, "a", encoding="utf-8") as f:
+            for e in (events if isinstance(events, list) else []):
+                if not isinstance(e, dict):
+                    continue
+                e = dict(e)
+                e["_recu"] = recu
+                for k in ("ua", "url", "vue", "ecran"):
+                    if m.get(k):
+                        e.setdefault(k, m[k])
+                f.write(json.dumps(e, ensure_ascii=False) + chr(10))
+                n += 1
+        return {"ok": True, "ecrits": n}
+    except Exception as ex:
+        return {"error": str(ex)[:200]}
