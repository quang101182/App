+def _ace_installe(dossier, fichier, duree, t0, libre, infos=None):
+    """Pose le son enrichi a la place du morceau, en gardant l'original. Commun au local et au
+    renfort en ligne — un seul endroit qui ecrit, donc un seul comportement a verifier.
+
+    ⚠ Le son d'origine NE DOIT PAS s'appeler « *.flac » A COTE du morceau : cinq endroits du serveur
+    prennent « le premier .flac du dossier » (Telegram, analyse, fidelite, mp3...) et la playlist du
+    navigateur liste TOUT .flac sous gs/audio/ — il apparaitrait comme un morceau EN DOUBLE. D'ou
+    `gs/audio/_bruts/`, un dossier « _… » que tout le monde ignore deja."""
+    nom = os.path.basename(dossier)
+    son = os.path.join(dossier, "audio.flac")
+    infos = dict(infos or {})
+    secondes = time.time() - t0
