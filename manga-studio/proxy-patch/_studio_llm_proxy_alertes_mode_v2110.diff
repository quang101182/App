+def manga_alertes_traiter(data):
+    """Traite les alertes cochees. action : ignorer | gemini | kimi | local | voisines (narration) ; gemini | kimi (traduction).
+    Rien d'automatique : c'est Quang qui clique. Le LOCAL ne part que sur ce clic (carte graphique)."""
+    m = _mod_mod()
+    ids, action = [str(x) for x in (data.get("ids") or [])], data.get("action") or ""
+    par_id = {a["id"]: a for a in m.alertes("ouverte")}
+    lances, erreurs = [], []
+    for i in ids:
+        a = par_id.get(i)
+        if not a:
+            erreurs.append(i + " : alerte introuvable ou deja traitee"); continue
+        if action == "ignorer":
+            m.changer_etat([i], "ignoree", "ignoree par Quang"); m.liberer_videos(a["d"]); lances.append(i); continue
+        cd = _manga_src_safe(a["d"])
+        if not cd:
+            erreurs.append(a["d"] + " : chapitre introuvable"); continue
+        if a["etape"] == "narration" and action in ("gemini", "kimi", "local", "voisines"):
+            tag = a.get("tag") or ""
+            morceaux = tag.split("-")
+            if len(morceaux) < 2 or morceaux[0] not in ("gemini", "kimi", "pixtral", "local"):
+                erreurs.append(a["d"] + " : narration inconnue (%s)" % tag); continue
+            cmd = [MANGA_PY, MANGA_NARRATE, a["d"], "--engine", morceaux[0], "--voice", morceaux[1].capitalize(),
+                   "--tag", tag, "--reuse-vision", tag, "--reprendre-moderation", action]
+            if "-en" in tag: cmd += ["--langue", "en"]
+            if tag.endswith("-local"): cmd += ["--tts", "local"]
+            td = _narr_dir(a["d"], tag)
+            lg = open(os.path.join(td, "run.log"), "w", encoding="utf-8")
+            _NARR_JOBS[(a["d"], tag)] = subprocess.Popen(cmd, stdout=lg, stderr=lg, cwd=os.path.dirname(MANGA_NARRATE),
+                                                         creationflags=getattr(subprocess, "CREATE_NO_WINDOW", 0))
+        elif a["etape"] == "traduction" and action in ("gemini", "kimi"):
+            lg_ = (a.get("detail") or "langue fr").split()[-1]
+            cmd = [MANGA_PY, MANGA_TRADUIRE_PY, a["d"], "--langue", lg_, "--engine", action]
+            subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, cwd=os.path.dirname(MANGA_TRADUIRE_PY),
+                             creationflags=getattr(subprocess, "CREATE_NO_WINDOW", 0))
+        else:
+            erreurs.append("%s : action « %s » impossible pour l'etape %s" % (a["d"], action, a["etape"])); continue
+        m.changer_etat([i], "ouverte", "en cours : " + action)
+        lances.append(i)
+    return {"ok": True, "lances": lances, "erreurs": erreurs}
