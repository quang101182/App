+    # v6.30 : Gemini 3.1 Pro rend parfois l'objet DANS une liste ([{...}]) -> « dictionary update
+    # sequence element #0 has length 9 » (vu le 18/09 sur Souffle long). On prend le 1er objet.
+    if isinstance(d, list):
+        d = next((x for x in d if isinstance(x, dict)), {})
+    d = dict(d or {})
+    ligne = str(d.get("style_line") or "")
+    ligne = re.sub(r"(?:\b(?:at|around|about|of)\s+)?(?:\ban?\s+)?(?:(?:fast|slow|brisk|driving|steady|moderate|"
+                   r"fast-paced|up-?tempo|mid[- ]?tempo)\s+)?(?:~\s*)?\d{2,3}(?:\s*-\s*\d{2,3})?\s*-?\s*BPM\b",
+                   "", ligne, flags=re.I)
+    ligne = re.sub(r"\s+,", ",", re.sub(r"\s{2,}", " ", ligne))
+    ligne = re.sub(r"(,\s*){2,}", ", ", ligne).strip(" ,.;")          # « lofi,, piano » -> « lofi, piano »
+    d["style_line"] = ligne
