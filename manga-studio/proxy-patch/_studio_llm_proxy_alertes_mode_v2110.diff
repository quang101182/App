+# ═══ v5.64 — moteur vidéo LOCAL (LTX 2.5 sur ce PC, port 8288) ═══════════════════════════
+def ltx_local_pid():
+    """PID du ComfyUI vidéo local, ou None. Source de vérité = le PORT (comme /shutdown)."""
+    try:
+        return pid_on_port(LTX_LOCAL_PORT)
+    except Exception:
+        return None
+
+_LTX_START_LOCK = threading.Lock()
+
+def ltx_local_start():
+    """Démarre le ComfyUI vidéo local. Idempotent. Pas de pod, pas de tunnel, pas de facture.
+    ⚠️ Le verrou est INDISPENSABLE : les sondes (port, WMI) mettent ~1 s à voir un process qui
+    vient de naître. Sans lui, 2 clics rapprochés lancent 2 instances — mesuré le 12/08 :
+    4 demandes -> 2 instances, dont une orpheline qui retient la VRAM et bloque tout.
+    C'est exactement le piège de race condition signalé par les 3 voix du vote."""
+    with _LTX_START_LOCK:
+        return _ltx_local_start_locked()
+
+def _ltx_local_start_locked():
+    if ltx_comfy_ready():
+        return {"phase": "ready", "msg": "Moteur vidéo prêt", "ready": True, "already": True}
+    # Un lancement récent est encore en cours de matérialisation -> ne pas en créer un 2e.
+    ts = _LTX.get("local_start_ts")
+    if ts and (time.time() - ts) < 45:
+        return {"phase": "booting", "msg": "Moteur vidéo en cours de démarrage…", "ready": False}
+    pid = ltx_local_pid()
+    if pid:   # process vivant mais HTTP pas encore up -> il finit de booter
+        return {"phase": "booting", "msg": "Moteur vidéo en cours de démarrage…", "ready": False}
+    # AUTO-RÉPARATION. Ici : le HTTP ne répond pas ET personne ne tient le port. Toute instance
+    # encore vivante est donc soit en train de naître (couverte par le verrou + local_start_ts
+    # ci-dessus), soit ORPHELINE — et une orpheline garde le modèle en VRAM (jusqu'à 15,7 Go sur
+    # 16,3), ce qui empêche la suivante de démarrer. On la supprime AVANT de lancer, plutôt que
+    # de refuser de démarrer : l'utilisateur veut un moteur qui marche, pas un diagnostic.
+    orph = ltx_local_orphans()
+    if orph:
+        for pid in orph:
+            try: subprocess.run(["taskkill", "/F", "/T", "/PID", str(pid)], capture_output=True, timeout=20)
+            except Exception: pass
+        time.sleep(1.5)
+    core = os.path.join(LTX_LOCAL_DIR, "main.py")
+    if not os.path.isfile(core):
+        return {"phase": "error", "msg": "ComfyUI vidéo introuvable: " + core, "ready": False}
+    py = LTX_LOCAL_PY if os.path.isfile(LTX_LOCAL_PY) else sys.executable
+    args = [py, core, "--listen", "127.0.0.1", "--port", str(LTX_LOCAL_PORT),
+            "--output-directory", LTX_LOCAL_OUT, "--enable-cors-header", "*"]
+    flags = getattr(subprocess, "CREATE_NO_WINDOW", 0)
+    # v5.67 — LE MOTEUR VIDÉO N'AVAIT AUCUN LOG. Lancé en CREATE_NO_WINDOW sans redirection, son
+    # stdout/stderr partait au néant : ni fenêtre, ni fichier. Constaté le 13/08 en diagnostiquant
+    # un « Temps dépassé » — il a fallu reconstituer le rendu via l'API /history, et si le job
+    # avait réellement planté (OOM VRAM, nœud manquant) il n'en serait resté AUCUNE trace.
+    # Le proxy, lui, écrit déjà _agent_proxy.log ; le moteur qui fait le vrai travail, non.
+    # Append (pas 'w') : une relance ne doit pas effacer la trace du crash qui l'a motivée.
+    try:
+        _lf = open(LTX_LOCAL_LOG, "ab", buffering=0)
+        _lf.write(("\n===== demarrage moteur video %s =====\n"
+                   % time.strftime("%Y-%m-%d %H:%M:%S")).encode("utf-8", "replace"))
+    except Exception:
+        _lf = None
+    try:
+        subprocess.Popen(args, cwd=LTX_LOCAL_DIR, creationflags=flags,
+                         stdout=(_lf or subprocess.DEVNULL), stderr=subprocess.STDOUT)
+    except Exception as e:
+        return {"phase": "error", "msg": "lancement moteur vidéo KO: " + str(e)[:120], "ready": False}
+    # Horodate le lancement : le port n'est pas ouvert avant ~10 s, et sans cette trace le statut
+    # répondrait "coupé" entre-temps -> l'UI clignoterait "moteur coupé" en plein démarrage,
+    # ce qui se lit comme un échec (constaté en live le 12/08 : "stopped" à 6 s, "ready" à 12 s).
+    _LTX.update(phase="booting", msg="Démarrage du moteur vidéo…", local_start_ts=time.time())
+    return {"phase": "booting", "msg": "Démarrage du moteur vidéo…", "ready": False}
+
+def ltx_local_orphans():
+    """PIDs de TOUTES les instances du ComfyUI vidéo, port ou pas.
+    ⚠️ Ancré sur le chemin 'ComfyUI-AudioLab' : ne matche JAMAIS le ComfyUI des images
+    (%LOCALAPPDATA%\\Programs\\ComfyUI\\resources) ni Muse. Sans cet ancrage, on couperait
+    l'outil de travail de Quang en croyant nettoyer le nôtre."""
+    pids = []
+    try:
+        ps = ("Get-CimInstance Win32_Process -Filter \"Name like '%python%'\" | "
+              "Where-Object { $_.CommandLine -like '*ComfyUI-AudioLab*' -and $_.CommandLine -like '*main.py*' } | "
+              "ForEach-Object { $_.ProcessId }")
+        r = subprocess.run(["powershell", "-NoProfile", "-Command", ps],
+                           capture_output=True, text=True, timeout=25)
+        for line in (r.stdout or "").split():
+            if line.strip().isdigit():
+                pids.append(int(line.strip()))
+    except Exception:
+        pass
+    return pids
+
+def ltx_local_stop():
+    """Coupe le moteur vidéo local et TOUTES ses instances orphelines (libère la VRAM).
+    Ne touche jamais au 8188 (images) ni à Muse.
+    ⚠️ Tuer seulement le PID du PORT ne suffit pas : une instance qui a perdu le port survit,
+    garde le modèle en VRAM (mesuré : 15,7 Go sur 16,3) et empêche la suivante de démarrer.
+    Incident réel du 12/08 : l'app de Quang n'arrivait plus à lancer son moteur à cause d'une
+    instance de test orpheline. C'est le même piège que les satellites Jarvis."""
+    pids = set(ltx_local_orphans())
+    p = ltx_local_pid()
+    if p: pids.add(p)
+    if not pids:
+        _LTX.update(phase="stopped", msg="Moteur vidéo coupé", local_start_ts=None)
+        return {"phase": "stopped", "msg": "Moteur vidéo déjà coupé", "ready": False, "killed": []}
+    killed = []
+    for pid in pids:
+        try:
+            subprocess.run(["taskkill", "/F", "/T", "/PID", str(pid)], capture_output=True, timeout=25)
+            killed.append(pid)
+        except Exception:
+            pass
+    _LTX.update(phase="stopped", msg="Moteur vidéo coupé", ip=None, port=None, local_start_ts=None)
+    return {"phase": "stopped", "msg": "Moteur vidéo coupé (%d instance(s))" % len(killed),
+            "ready": False, "killed": killed}
+
+def ltx_local_status():
+    """Statut du moteur vidéo local. 3 états utiles à l'UI : stopped / booting / ready."""
+    if ltx_comfy_ready():
+        _LTX.update(phase="ready", msg="Moteur vidéo prêt")
+        return {"phase": "ready", "msg": "Moteur vidéo prêt", "ready": True, "local": True}
+    if ltx_local_pid():
+        return {"phase": "booting", "msg": "Démarrage du moteur vidéo…", "ready": False, "local": True}
+    # Fenêtre de grâce : entre le lancement et l'ouverture du port (~10 s), ni HTTP ni PID ne
+    # répondent. Sans elle, on annoncerait "coupé" pendant le démarrage — l'utilisateur croit
+    # que ça a raté et relance, ce qui empile les instances (incident réel du 12/08).
+    ts = _LTX.get("local_start_ts")
+    if ts and (time.time() - ts) < 60:
+        return {"phase": "booting", "msg": "Démarrage du moteur vidéo…", "ready": False, "local": True}
+    return {"phase": "stopped", "msg": "Moteur vidéo coupé", "ready": False, "local": True}
