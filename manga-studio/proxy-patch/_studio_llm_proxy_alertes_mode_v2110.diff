+def gpu_state():
+    """Qui occupe la carte, maintenant. Consommé par l'UI (avertissement) ET par le garde serveur."""
+    img = comfy_busy()          # 8188 — images
+    vid = comfy_busy_ltx()      # 8288 — vidéo
+    # v5.76 : la MUSIQUE manquait ici. Consequence mesuree le 17/09 : lancer une image
+    # pendant qu'un morceau se genere n'etait bloque par rien -> les deux modeles se
+    # chargent (10 Go + 8 Go sur une carte de 16) -> echec memoire. Le garde doit
+    # connaitre TOUS les moteurs, pas seulement ceux de ComfyUI.
+    mus = False
+    try:
+        _p = yue2_get("/ping", timeout=2)
+        mus = bool(_p and _p.get("busy"))
+    except Exception:
+        pass
+    who = "images" if img else ("video" if vid else ("musique" if mus else None))
+    st = {"busy": bool(img or vid or mus), "busyBy": who, "images": img, "video": vid, "musique": mus}
+    try:
+        st["vram"] = vram_info()
+    except Exception:
+        pass
+    return st
