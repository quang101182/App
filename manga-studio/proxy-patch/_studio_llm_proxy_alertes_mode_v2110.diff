+# --- Suivi des COUTS (v1.72.0), comme StoryVoice : pastille en haut + detail au clic --------------
+# Source = les stats de chaque narration.json (couts MESURES par narrate_chapter.py, pas estimes).
+# Pas de double compte : un run --reuse-vision ne paie que recit + voix (sa lecture est recopiee de son
+# run source) ; un consensus ne paie que sa fusion (ses lectures sont celles de 2 autres runs).
+def manga_costs():
+    racine = os.path.normpath(MANGA_SOURCES)
+    runs = []
+    if os.path.isdir(racine):
+        for slug in os.listdir(racine):
+            sd = os.path.join(racine, slug)
+            if not os.path.isdir(sd):
+                continue
+            for ch in os.listdir(sd):
+                nd = os.path.join(sd, ch, "narration")
+                for mode in ("ouverture", "rattrapage") if ch.startswith("ch_") else ():   # v1.94.0
+                    pj = os.path.join(sd, ch, "precedemment", mode + ".json")
+                    try:
+                        if os.path.isfile(pj):
+                            with open(pj, encoding="utf-8") as f: pq = json.load(f)
+                            runs.append({"chap": slug + "/" + ch, "tag": mode, "engine": "deepseek",
+                                         "date": (pq.get("created_at") or "")[:19], "prompt": "precedemment", "reuse": None,
+                                         "st": {"cout_precedemment": (pq.get("stats") or {}).get("cout_total", 0)}})
+                    except Exception:
+                        pass
+                # v1.91.0 : les TRADUCTIONS sont des depenses aussi (finies ET en cours)
+                trd = os.path.join(sd, ch, "traduction")
+                for lg in (os.listdir(trd) if ch.startswith("ch_") and os.path.isdir(trd) else []):
+                    tj, tp = os.path.join(trd, lg, "traduction.json"), os.path.join(trd, lg, "progress.json")
+                    try:
+                        if os.path.isfile(tj):
+                            with open(tj, encoding="utf-8") as f: t = json.load(f)
+                            runs.append({"chap": slug + "/" + ch, "tag": "traduction " + lg, "engine": t.get("engine") or "?",
+                                         "date": (t.get("created_at") or "")[:19], "prompt": "traduction", "reuse": None,
+                                         "st": {"cout_traduction": (t.get("stats") or {}).get("cout", 0)}})
+                        if os.path.isfile(tp):
+                            with open(tp, encoding="utf-8") as f: pr = json.load(f)
+                            if not pr.get("fini") and pr.get("cout"):
+                                runs.append({"chap": slug + "/" + ch, "tag": "traduction " + lg + " (en cours)", "engine": "gemini",
+                                             "date": time.strftime("%Y-%m-%dT%H:%M:%S", time.localtime(float(pr.get("t") or 0))),
+                                             "prompt": "traduction", "reuse": None, "st": {"cout_traduction": pr["cout"]}})
+                    except Exception:
+                        pass
+                if not ch.startswith("ch_") or not os.path.isdir(nd):
+                    continue
+                for tag in os.listdir(nd):
+                    td = os.path.join(nd, tag)
+                    np_ = os.path.join(td, "narration.json")
+                    pp_ = os.path.join(td, "progress.json")
+                    if not os.path.isfile(np_) and os.path.isfile(pp_):     # v1.91.0 : narration EN COURS
+                        try:
+                            with open(pp_, encoding="utf-8") as f: pr = json.load(f)
+                            if pr.get("etape") != "fini" and pr.get("couts"):
+                                runs.append({"chap": slug + "/" + ch, "tag": tag + " (en cours)", "engine": tag.split("-")[0],
+                                             "date": time.strftime("%Y-%m-%dT%H:%M:%S", time.localtime(float(pr.get("t") or 0))),
+                                             "prompt": None, "reuse": None, "st": dict(pr["couts"])})
+                        except Exception:
+                            pass
+                    if os.path.isfile(np_):
+                        try:
+                            with open(np_, encoding="utf-8") as f: n = json.load(f)
+                        except Exception:
+                            continue
+                        st = n.get("stats") or {}
+                        runs.append({"chap": slug + "/" + ch, "tag": tag, "engine": n.get("engine") or "?",
+                                     "date": (n.get("created_at") or time.strftime("%Y-%m-%dT%H:%M:%S",
+                                     time.localtime(os.path.getmtime(np_))))[:19], "prompt": n.get("prompt"),
+                                     "reuse": n.get("reuse_vision"), "st": st})
+                        ka = st.get("karaoke") or {}                          # v1.91.0 : le karaoke, a sa date
+                        if ka.get("cout"):
+                            runs.append({"chap": slug + "/" + ch, "tag": tag + " (karaoke)", "engine": "whisper",
+                                         "date": (ka.get("quand") or time.strftime("%Y-%m-%dT%H:%M:%S",
+                                                  time.localtime(os.path.getmtime(np_))))[:19],
+                                         "prompt": "karaoke", "reuse": None, "st": {"cout_karaoke": ka["cout"]}})
+                    fp = os.path.join(td, "fidelite.json")
+                    if os.path.isfile(fp):
+                        try:
+                            with open(fp, encoding="utf-8") as f: fj = json.load(f)
+                            runs.append({"chap": slug + "/" + ch, "tag": tag + " (banc)", "engine": "juge",
+                                         "date": (fj.get("date") or "")[:19], "prompt": "juge", "reuse": None,
+                                         "st": {"cout_juge": (fj.get("bilan") or {}).get("cout", 0)}})
+                        except Exception:
+                            pass
+    # v1.79.0 : les narrations mises a la CORBEILLE restent des depenses (l'argent est parti)
+    corb = os.path.join(racine, "_corbeille")
+    for dp, _dirs, fichiers in (os.walk(corb) if os.path.isdir(corb) else []):
+        rel = os.path.relpath(dp, corb).replace("\\", "/")
+        tag = os.path.basename(dp).split("__")[-1] + " (supprimee)"
+        if "narration.json" in fichiers:
+            try:
+                with open(os.path.join(dp, "narration.json"), encoding="utf-8") as f: n = json.load(f)
+                runs.append({"chap": n.get("chapitre") or ("corbeille/" + rel), "tag": tag, "engine": n.get("engine") or "?",
+                             "date": (n.get("created_at") or time.strftime("%Y-%m-%dT%H:%M:%S",
+                             time.localtime(os.path.getmtime(os.path.join(dp, "narration.json")))))[:19],
+                             "prompt": n.get("prompt"), "reuse": n.get("reuse_vision"), "st": n.get("stats") or {}})
+            except Exception:
+                pass
+        for mode in ("ouverture", "rattrapage") if os.path.basename(dp) == "precedemment" else ():   # v1.94.0
+            if mode + ".json" in fichiers:
+                try:
+                    with open(os.path.join(dp, mode + ".json"), encoding="utf-8") as f: pq = json.load(f)
+                    runs.append({"chap": "corbeille/" + rel, "tag": mode + " (supprime)", "engine": "deepseek",
+                                 "date": (pq.get("created_at") or "")[:19], "prompt": "precedemment", "reuse": None,
+                                 "st": {"cout_precedemment": (pq.get("stats") or {}).get("cout_total", 0)}})
+                except Exception:
+                    pass
+        if "fidelite.json" in fichiers:
+            try:
+                with open(os.path.join(dp, "fidelite.json"), encoding="utf-8") as f: fj = json.load(f)
+                runs.append({"chap": "corbeille/" + rel, "tag": tag + " (banc)", "engine": "juge",
+                             "date": (fj.get("date") or "")[:19], "prompt": "juge", "reuse": None,
+                             "st": {"cout_juge": (fj.get("bilan") or {}).get("cout", 0)}})
+            except Exception:
+                pass
+    # Manga Studio v2.11.0 (24/09, Quang : « ce matin j'etais a plus de 30 $, ca a saute a 18,71 $ ») : additionner les
+    # fichiers PRESENTS perdait toute depense dont le fichier avait ete ecrase (traduction refaite) ou supprime (corbeille
+    # videe). Le registre en AJOUT SEUL (sources/_depenses.jsonl) fait foi ; on ne garde du parcours que ce qu'il ne
+    # couvre pas (bancs de fidelite, fusions, traductions EN COURS).
+    reg = os.path.join(racine, "_depenses.jsonl")
+    if os.path.isfile(reg):
+        cles = {"narration": None, "traduction": "cout_traduction", "karaoke": "cout_karaoke", "precedemment": "cout_precedemment"}
+        runs = [r for r in runs if r["prompt"] in ("juge", "consensus") or "(en cours)" in r["tag"]]
+        with open(reg, encoding="utf-8") as f:
+            for l in f:
+                try:
+                    e = json.loads(l)
+                except ValueError:
+                    continue
+                ty = e.get("type")
+                if ty not in cles:
+                    continue
+                if ty == "narration":
+                    st = {k: v for k, v in (e.get("detail") or {}).items() if k.startswith("cout_")} or {"cout_narration": e.get("paye", 0)}
+                else:
+                    st = {cles[ty]: e.get("paye", 0)}
+                mot = e.get("moteur") or "?"
+                if mot == "?":
+                    t_ = e.get("tag") or ""
+                    mot = next((m for m, cle in (("gemini", "gemini"), ("kimi", "kimi"), ("kimi", "k3"), ("local", "local"),
+                                                 ("pixtral", "pixtral")) if cle in t_), "gemini" if ty == "traduction" else "?")
+                runs.append({"chap": e.get("d") or "?", "tag": (e.get("tag") or "") + (" (supprimé)" if e.get("source") == "journal" else "")
+                             + (" (estimé)" if e.get("estime") else ""), "engine": mot, "date": (e.get("t") or "")[:19],
+                             "prompt": "registre", "reuse": None, "st": st})
+    # anciens runs --reuse-vision (avant le marqueur v1.72) : meme lecture qu'un run PLUS ANCIEN du chapitre
+    vus = {}
+    for r in sorted(runs, key=lambda x: x["date"]):
+        cle = (r["chap"], r["st"].get("vision_tokens_in"), r["st"].get("cout_vision"))
+        if r["prompt"] not in ("juge", "consensus") and r["st"].get("cout_vision"):
+            if cle in vus and not r["reuse"]:
+                r["reuse"] = vus[cle]
+            vus.setdefault(cle, r["tag"])
+    etapes = {"noms": "cout_noms", "lecture": "cout_vision", "verification": "cout_verif", "recit": "cout_recit",
+              "voix": "cout_tts", "fusion": "cout_fusion", "juge": "cout_juge",
+              "traduction": "cout_traduction", "karaoke": "cout_karaoke",                  # v1.91.0
+              "precedemment": "cout_precedemment",                                         # v1.94.0
+              "narration (détail perdu)": "cout_narration"}                                # v2.11.0 : registre
+    par_etape, par_moteur, lignes = {}, {}, []
+    auj, mois = time.strftime("%Y-%m-%d"), time.strftime("%Y-%m")
+    t_auj = t_mois = t_tot = 0.0
+    for r in runs:
+        st = r["st"]
+        if r["prompt"] == "consensus":
+            garde = ("fusion",)
+        elif r["reuse"]:
+            garde = ("verification", "recit", "voix")   # tout SAUF noms + lecture, recopies du run source
+        else:
+            garde = tuple(etapes)
+        detail = {e: float(st.get(k) or 0) for e, k in etapes.items() if e in garde and st.get(k)}
+        c = round(sum(detail.values()), 4)
+        if c <= 0:
+            continue
+        for e, v in detail.items():
+            par_etape[e] = par_etape.get(e, 0.0) + v
+        par_moteur[r["engine"]] = par_moteur.get(r["engine"], 0.0) + c
+        t_tot += c
+        if r["date"].startswith(mois): t_mois += c
+        if r["date"].startswith(auj): t_auj += c
+        lignes.append({"chap": r["chap"], "tag": r["tag"], "engine": r["engine"], "date": r["date"], "cout": c,
+                       "reuse": r["reuse"], "detail": {k: round(v, 4) for k, v in detail.items()}})
