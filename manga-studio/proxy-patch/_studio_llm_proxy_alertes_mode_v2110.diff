+                                  "https://www.youtube.com/watch?v=" + vid],
+                           capture_output=True, text=True, encoding="utf-8", errors="replace", timeout=600,
+                           creationflags=getattr(subprocess, "CREATE_NO_WINDOW", 0))
+        if r.returncode == 0 and os.path.isfile(cible):
+            break
+        err = ((r.stderr or "") + (r.stdout or "")).strip()[-200:]
+        mp3_log("essai %d %s : code %s %s" % (essai, vid, r.returncode, err))
+        time.sleep(5)
+    if not os.path.isfile(cible):
+        mp3_log("ECHEC %s « %s » : %s" % (vid, base, err))
+        return {"ok": False, "erreur": "telechargement impossible : " + (err or "raison inconnue")[:160]}
+    with _MP3_VERROU:
+        cache = _mp3_cache()
+        cache[vid] = base + ".mp3"
+        with io.open(MP3_TELECHARGES, "w", encoding="utf-8") as f:
+            json.dump(cache, f, ensure_ascii=False, indent=1)
+    dur = round(_duree_s(cible) or 0, 1)
+    mp3_log("OK %s -> « %s » (%.0f s, %.1f Mo, %.1f s)" % (vid, base + ".mp3", dur, os.path.getsize(cible) / 1e6, time.time() - t0))
+    return {"ok": True, "nom": base + ".mp3", "dur": dur, "s": round(time.time() - t0, 1)}
