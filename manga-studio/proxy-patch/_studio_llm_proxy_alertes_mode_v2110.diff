+def mastering_calcule(dossier):
+    nom = os.path.basename(dossier)
+    son = os.path.join(dossier, "audio.flac")
+    mj = os.path.join(dossier, "mastering.json")
+    avant = {}
+    try:
+        with io.open(mj, encoding="utf-8") as f:
+            avant = json.load(f) or {}
+    except Exception:
+        pass
+    os.makedirs(os.path.join(MASTER_SAUVE, nom), exist_ok=True)
+    tmp = os.path.join(MASTER_SAUVE, nom, "master.part.flac")       # meme disque que output/ : os.replace
+    t0 = time.time()
+    try:
+        r = subprocess.run([sys.executable, MASTER_SCRIPT, son, tmp], capture_output=True, text=True, timeout=600,
+                           creationflags=getattr(subprocess, "CREATE_NO_WINDOW", 0) | getattr(subprocess, "BELOW_NORMAL_PRIORITY_CLASS", 0))
+        res = json.loads((r.stdout or "").strip().splitlines()[-1])
+        st = os.stat(son)
+        sauve = os.path.join(MASTER_SAUVE, nom, "audio.flac")
+        if not os.path.isfile(sauve):                                 # la 1re version reste celle d'avant
+            shutil.copy2(son, sauve)
+        os.replace(tmp, son)
+        os.utime(son, (st.st_atime, st.st_mtime))                     # la playlist trie par date de fichier
+        res["sauvegarde"] = sauve
+    except Exception as ex:
+        res = {"action": "echec", "raison": str(ex)[:200], "tentatives": (avant.get("tentatives") or 0) + 1}
+    try:
+        os.remove(tmp)
+    except Exception:
+        pass
+    res["secondes"] = round(time.time() - t0, 1)
+    res["quand"] = time.strftime("%Y-%m-%d %H:%M:%S")
+    with io.open(mj, "w", encoding="utf-8") as f:
+        json.dump(res, f, ensure_ascii=False, indent=1)
+    if res.get("action") == "masterise":
+        mastering_log("« %s » : masterise %s LUFS -> %s LUFS en %s s" % (nom, res.get("entree_lufs"), res.get("cible_lufs"), res["secondes"]))
+    else:
+        mastering_log("« %s » : ECHEC (essai %s/3) %s" % (nom, res.get("tentatives"), res.get("raison")))
