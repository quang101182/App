+    fiche = {"artiste": art, "titre": titre, "ecoute": ecoute}
+    fiche["alertes"] = alertes + ref_verifie(fiche) + notes
+    fiche["compris"] = ref_compris(fiche)
+    with _REF_VERROU:
+        c = ref_cache_lit()
+        if art and art.get("mbid"):
