+def _reprise_ligne(ligne, journal=True):
+    ligne = ligne.rstrip()
+    if not ligne:
+        return
+    if journal:
+        reprise_log("  " + ligne[:300])
+    m = re.match(r"^== ([^:]+?)(?: :|$)", ligne)
+    if m and m.group(1).strip() in REPRISE_ETAPES:
+        _REPRISE["etape"] = REPRISE_ETAPES[m.group(1).strip()]
+    # v7.50 : ANCRE sur la reponse du moteur 1 ({'job': ...} en tete). Une reponse de la FILE recopie sa liste de
+    # morceaux termines, pleine de vieux 'job' : les lire faisait adopter par l'app un morceau d'un autre jour.
+    j = re.match(r"^== generation : \{'job': '([0-9a-f]+)'", ligne)
+    if j:
+        _REPRISE["job"] = j.group(1)
+    if ligne.startswith("ARRET"):
