+def manga_delete(paths):
+    """Supprime des images de la galerie manga. Rien d'autre, nulle part ailleurs.
+
+    Trois verrous, parce qu'une route qui efface merite mieux qu'un seul :
+      1. _manga_safe -> le chemin doit retomber SOUS manga-studio/output ;
+      2. l'extension doit etre une image (jamais un .db, un .json, un script) ;
+      3. ce doit etre un fichier, jamais un dossier -- pas de suppression en masse.
+    Elle rend le compte exact de ce qui a ete supprime : une suppression qui
+    "reussit" sans rien effacer est un mensonge silencieux.
+    """
+    if isinstance(paths, str):
+        paths = [paths]
+    faits, refuses = [], []
+    for rel in (paths or []):
+        full = _manga_safe(rel)
+        if (not full or not os.path.isfile(full)
+                or not full.lower().endswith((".png", ".jpg", ".jpeg", ".webp"))):
+            refuses.append(rel)
+            continue
+        try:
+            os.remove(full)
+            faits.append(rel)
+        except Exception:
+            refuses.append(rel)
+    return {"ok": True, "supprimes": len(faits), "refuses": refuses, "faits": faits}
+
