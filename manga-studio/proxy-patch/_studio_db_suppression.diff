+# Les deux dossiers ou vivent les images d un projet manga. Le premier est celui
+# que l app montre ; le second est l atelier de ComfyUI, invisible depuis l app
+# et jamais nettoye -- 702 Mo au 28/07, dont une bonne part de bancs.
+_MANGA_OUT_APP = r"D:\Download\02-Apps-Web\Repo-github\App\manga-studio\output"
+_MANGA_OUT_COMFY = os.path.join(os.path.dirname(os.path.abspath(__file__)), "output", "manga")
+
+
+def _effacer_images_du_projet(slug):
+    """Efface les images d un slug dans les DEUX dossiers. Rend le compte.
+
+    WARN Un slug vide ou suspect n efface RIEN : sans cette garde, un projet sans
+    slug viserait la RACINE des sorties. Une suppression qui deborde de son
+    perimetre est le seul defaut qu on ne peut pas rattraper.
+    """
+    import shutil
+    slug = (slug or "").strip().strip("/\\")
+    if not slug or slug in (".", "..") or "/" in slug or "\\" in slug:
+        return 0
+    n = 0
+    for base in (_MANGA_OUT_APP, _MANGA_OUT_COMFY):
+        cible = os.path.normpath(os.path.join(base, slug))
+        if not cible.startswith(os.path.normpath(base) + os.sep):
+            continue                      # anti-traversee, meme improbable
+        if not os.path.isdir(cible):
+            continue
+        for _, _, fichiers in os.walk(cible):
+            n += len(fichiers)
+        shutil.rmtree(cible, ignore_errors=True)
+    return n
+
