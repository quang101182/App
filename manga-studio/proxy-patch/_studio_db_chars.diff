+def _row_char(r):
+    return {"id": r["id"], "ts": r["ts"], "name": r["name"], "role": r["role"],
+            "tags": r["tags"], "refs": _jload(r["refs"], []), "lora": r["lora"],
+            "trigger": r["trigger"], "valide": bool(r["valide"]), "notes": r["notes"]}
+
+
+def list_manga_chars():
+    with _lock:
+        c = _connect()
+        return [_row_char(r) for r in
+                c.execute("SELECT * FROM manga_chars ORDER BY ts DESC").fetchall()]
+
+
+def upsert_manga_char(p):
+    cid = p.get("id") or _uid("mh")
+    with _lock:
+        c = _connect()
+        c.execute(
+            "INSERT INTO manga_chars(id,ts,name,role,tags,refs,lora,trigger,valide,notes) "
+            "VALUES(?,?,?,?,?,?,?,?,?,?) "
+            "ON CONFLICT(id) DO UPDATE SET ts=excluded.ts,name=excluded.name,"
+            "role=excluded.role,tags=excluded.tags,refs=excluded.refs,lora=excluded.lora,"
+            "trigger=excluded.trigger,valide=excluded.valide,notes=excluded.notes",
+            (cid, int(p.get("ts") or _now_ms()), p.get("name") or "",
+             p.get("role") or "secondaire", p.get("tags") or "",
+             json.dumps(p.get("refs") or []), p.get("lora") or "",
+             p.get("trigger") or "", 1 if p.get("valide") else 0, p.get("notes") or ""),
+        )
+        c.commit()
+    return {"ok": True, "id": cid}
+
+
+def delete_manga_char(cid):
+    with _lock:
+        c = _connect()
+        c.execute("DELETE FROM manga_chars WHERE id=?", (cid,))
+        c.commit()
+    return {"ok": True, "deleted": cid}
+
